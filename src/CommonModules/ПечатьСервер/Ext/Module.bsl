// Печатные формы. Табличный документ строится кодом, без макетов:
// так форму проще поддерживать в Git и проверять автотестами.

#Область ПрограммныйИнтерфейс

// Кассовый чек продажи.
//
// Параметры:
//  Продажа - ДокументСсылка.ПродажаТовара
//
// Возвращаемое значение:
//  ТабличныйДокумент
//
Функция ЧекПродажи(Продажа) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Продажа);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПродажаТовара.Номер КАК Номер,
	|	ПродажаТовара.Дата КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(ПродажаТовара.Склад) КАК Склад,
	|	ПродажаТовара.Склад.Адрес КАК Адрес,
	|	ПРЕДСТАВЛЕНИЕ(ПродажаТовара.Клиент) КАК Клиент,
	|	ПРЕДСТАВЛЕНИЕ(ПродажаТовара.СпособОплаты) КАК СпособОплаты,
	|	ПродажаТовара.ПроцентСкидки КАК ПроцентСкидки,
	|	ПродажаТовара.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ПродажаТовара КАК ПродажаТовара
	|ГДЕ
	|	ПродажаТовара.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПродажаТовараТовары.НомерСтроки КАК НомерСтроки,
	|	ПРЕДСТАВЛЕНИЕ(ПродажаТовараТовары.Товар) КАК Товар,
	|	ПродажаТовараТовары.Количество КАК Количество,
	|	ПродажаТовараТовары.Цена КАК Цена,
	|	ПродажаТовараТовары.Сумма КАК Сумма
	|ИЗ
	|	Документ.ПродажаТовара.Товары КАК ПродажаТовараТовары
	|ГДЕ
	|	ПродажаТовараТовары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";

	Результаты = Запрос.ВыполнитьПакет();
	Шапка = Результаты[0].Выбрать();
	Если Не Шапка.Следующий() Тогда
		ВызватьИсключение "Документ продажи не найден";
	КонецЕсли;
	Строки = Результаты[1].Выгрузить();

	ТабДок = НовыйТабличныйДокумент("ЧекПродажи", СтрШаблон("Чек № %1", СокрЛП(Шапка.Номер)));
	ШириныКолонок(ТабДок, 4, 36, 8, 12, 14);

	НомерСтроки = 1;
	Название = Константы.НазваниеМагазина.Получить();
	Вывести(ТабДок, НомерСтроки, 1, ?(ЗначениеЗаполнено(Название), Название, "Магазин"), Истина, ГоризонтальноеПоложение.Центр, 5, 12);
	НомерСтроки = НомерСтроки + 1;
	Вывести(ТабДок, НомерСтроки, 1, СокрЛП(Шапка.Склад + " " + Шапка.Адрес), , ГоризонтальноеПоложение.Центр, 5);
	НомерСтроки = НомерСтроки + 2;
	Вывести(ТабДок, НомерСтроки, 1, СтрШаблон("КАССОВЫЙ ЧЕК № %1 от %2", СокрЛП(Шапка.Номер), Формат(Шапка.Дата, "ДЛФ=DT")),
		Истина, ГоризонтальноеПоложение.Центр, 5);
	НомерСтроки = НомерСтроки + 2;

	ШапкаТаблицы = НомерСтроки;
	Вывести(ТабДок, НомерСтроки, 1, "№", Истина);
	Вывести(ТабДок, НомерСтроки, 2, "Товар", Истина);
	Вывести(ТабДок, НомерСтроки, 3, "Кол-во", Истина, ГоризонтальноеПоложение.Право);
	Вывести(ТабДок, НомерСтроки, 4, "Цена", Истина, ГоризонтальноеПоложение.Право);
	Вывести(ТабДок, НомерСтроки, 5, "Сумма", Истина, ГоризонтальноеПоложение.Право);

	Для Каждого СтрокаЧека Из Строки Цикл
		НомерСтроки = НомерСтроки + 1;
		Вывести(ТабДок, НомерСтроки, 1, Формат(СтрокаЧека.НомерСтроки, "ЧГ=0"));
		Вывести(ТабДок, НомерСтроки, 2, СтрокаЧека.Товар);
		Вывести(ТабДок, НомерСтроки, 3, ОбщегоНазначенияСервер.ФорматКоличества(СтрокаЧека.Количество), , ГоризонтальноеПоложение.Право);
		Вывести(ТабДок, НомерСтроки, 4, ОбщегоНазначенияСервер.ФорматСуммы(СтрокаЧека.Цена), , ГоризонтальноеПоложение.Право);
		Вывести(ТабДок, НомерСтроки, 5, ОбщегоНазначенияСервер.ФорматСуммы(СтрокаЧека.Сумма), , ГоризонтальноеПоложение.Право);
	КонецЦикла;
	Обвести(ТабДок, ШапкаТаблицы, 1, НомерСтроки, 5);

	НомерСтроки = НомерСтроки + 1;
	Если Шапка.ПроцентСкидки > 0 Тогда
		Вывести(ТабДок, НомерСтроки, 2, СтрШаблон("Скидка клиента: %1%%", Шапка.ПроцентСкидки), , , 4);
		НомерСтроки = НомерСтроки + 1;
	КонецЕсли;
	Вывести(ТабДок, НомерСтроки, 2, "ИТОГО", Истина, , 4, 12);
	Вывести(ТабДок, НомерСтроки, 5, ОбщегоНазначенияСервер.ФорматСуммы(Шапка.СуммаДокумента), Истина, ГоризонтальноеПоложение.Право, , 12);
	НомерСтроки = НомерСтроки + 1;
	Вывести(ТабДок, НомерСтроки, 2, "Оплата: " + Шапка.СпособОплаты, , , 5);
	Если ЗначениеЗаполнено(Шапка.Клиент) Тогда
		НомерСтроки = НомерСтроки + 1;
		Вывести(ТабДок, НомерСтроки, 2, "Покупатель: " + Шапка.Клиент, , , 5);
	КонецЕсли;
	НомерСтроки = НомерСтроки + 2;
	Вывести(ТабДок, НомерСтроки, 1, "Спасибо за покупку!", , ГоризонтальноеПоложение.Центр, 5);

	Возврат ТабДок;

КонецФункции

// Приходная накладная по документу поступления.
Функция НакладнаяПоступления(Поступление) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Поступление);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеТовара.Номер КАК Номер,
	|	ПоступлениеТовара.Дата КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(ПоступлениеТовара.Склад) КАК Склад,
	|	ПРЕДСТАВЛЕНИЕ(ПоступлениеТовара.Поставщик) КАК Поставщик,
	|	ПоступлениеТовара.Поставщик.ИНН КАК ИНН,
	|	ПоступлениеТовара.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	|	ПоступлениеТовара.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ПоступлениеТовара КАК ПоступлениеТовара
	|ГДЕ
	|	ПоступлениеТовара.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	ПРЕДСТАВЛЕНИЕ(Товары.Товар) КАК Товар,
	|	Товары.Товар.Артикул КАК Артикул,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма
	|ИЗ
	|	Документ.ПоступлениеТовара.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";

	Результаты = Запрос.ВыполнитьПакет();
	Шапка = Результаты[0].Выбрать();
	Если Не Шапка.Следующий() Тогда
		ВызватьИсключение "Документ поступления не найден";
	КонецЕсли;

	ТабДок = НовыйТабличныйДокумент("НакладнаяПоступления", СтрШаблон("Приходная накладная № %1", СокрЛП(Шапка.Номер)));
	ШириныКолонок(ТабДок, 4, 14, 40, 10, 14, 16);

	НомерСтроки = 1;
	Вывести(ТабДок, НомерСтроки, 1, СтрШаблон("ПРИХОДНАЯ НАКЛАДНАЯ № %1 от %2", СокрЛП(Шапка.Номер), Формат(Шапка.Дата, "ДЛФ=D")), Истина, , 6, 12);
	НомерСтроки = НомерСтроки + 2;
	Вывести(ТабДок, НомерСтроки, 1, "Поставщик: " + Шапка.Поставщик + ?(ЗначениеЗаполнено(Шапка.ИНН), ", ИНН " + Шапка.ИНН, ""), , , 6);
	НомерСтроки = НомерСтроки + 1;
	Вывести(ТабДок, НомерСтроки, 1, "Склад: " + Шапка.Склад, , , 6);
	Если ЗначениеЗаполнено(Шапка.НомерВходящегоДокумента) Тогда
		НомерСтроки = НомерСтроки + 1;
		Вывести(ТабДок, НомерСтроки, 1, "Документ поставщика: " + Шапка.НомерВходящегоДокумента, , , 6);
	КонецЕсли;
	НомерСтроки = НомерСтроки + 2;

	ШапкаТаблицы = НомерСтроки;
	Колонки = СтрРазделить("№,Артикул,Товар,Кол-во,Цена,Сумма", ",");
	Для Индекс = 0 По Колонки.ВГраница() Цикл
		Вывести(ТабДок, НомерСтроки, Индекс + 1, Колонки[Индекс], Истина);
	КонецЦикла;
	Для Каждого СтрокаНакладной Из Результаты[1].Выгрузить() Цикл
		НомерСтроки = НомерСтроки + 1;
		Вывести(ТабДок, НомерСтроки, 1, Формат(СтрокаНакладной.НомерСтроки, "ЧГ=0"));
		Вывести(ТабДок, НомерСтроки, 2, СтрокаНакладной.Артикул);
		Вывести(ТабДок, НомерСтроки, 3, СтрокаНакладной.Товар);
		Вывести(ТабДок, НомерСтроки, 4, ОбщегоНазначенияСервер.ФорматКоличества(СтрокаНакладной.Количество), , ГоризонтальноеПоложение.Право);
		Вывести(ТабДок, НомерСтроки, 5, ОбщегоНазначенияСервер.ФорматСуммы(СтрокаНакладной.Цена), , ГоризонтальноеПоложение.Право);
		Вывести(ТабДок, НомерСтроки, 6, ОбщегоНазначенияСервер.ФорматСуммы(СтрокаНакладной.Сумма), , ГоризонтальноеПоложение.Право);
	КонецЦикла;
	Обвести(ТабДок, ШапкаТаблицы, 1, НомерСтроки, 6);

	НомерСтроки = НомерСтроки + 1;
	Вывести(ТабДок, НомерСтроки, 3, "ИТОГО", Истина, , 5);
	Вывести(ТабДок, НомерСтроки, 6, ОбщегоНазначенияСервер.ФорматСуммы(Шапка.СуммаДокумента), Истина, ГоризонтальноеПоложение.Право);
	НомерСтроки = НомерСтроки + 3;
	Вывести(ТабДок, НомерСтроки, 1, "Сдал ____________________", , , 3);
	Вывести(ТабДок, НомерСтроки, 4, "Принял ____________________", , , 6);

	Возврат ТабДок;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйТабличныйДокумент(КлючПечати, Заголовок)
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.КлючПараметровПечати = "ПараметрыПечати_" + КлючПечати;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	Возврат ТабДок;
КонецФункции

Процедура ШириныКолонок(ТабДок, Ширина1, Ширина2 = 0, Ширина3 = 0, Ширина4 = 0, Ширина5 = 0, Ширина6 = 0)
	Ширины = Новый Массив;
	Ширины.Добавить(Ширина1);
	Ширины.Добавить(Ширина2);
	Ширины.Добавить(Ширина3);
	Ширины.Добавить(Ширина4);
	Ширины.Добавить(Ширина5);
	Ширины.Добавить(Ширина6);
	Для Индекс = 0 По Ширины.ВГраница() Цикл
		Если Ширины[Индекс] > 0 Тогда
			ТабДок.Область("C" + Формат(Индекс + 1, "ЧГ=0")).ШиринаКолонки = Ширины[Индекс];
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Выводит текст в ячейку (или объединённый диапазон до колонки ДоКолонки).
Процедура Вывести(ТабДок, НомерСтроки, Колонка, Текст, Жирный = Ложь, Положение = Неопределено, ДоКолонки = 0, Размер = 0)

	Если ДоКолонки > Колонка Тогда
		Область = ТабДок.Область(НомерСтроки, Колонка, НомерСтроки, ДоКолонки);
		Область.Объединить();
	Иначе
		Область = ТабДок.Область(НомерСтроки, Колонка);
	КонецЕсли;
	Область.Текст = Текст;
	Если Жирный Или Размер > 0 Тогда
		Область.Шрифт = Новый Шрифт(, ?(Размер > 0, Размер, 10), Жирный);
	КонецЕсли;
	Если Положение <> Неопределено Тогда
		Область.ГоризонтальноеПоложение = Положение;
	КонецЕсли;

КонецПроцедуры

Процедура Обвести(ТабДок, Верх, Лево, Низ, Право)
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	ТабДок.Область(Верх, Лево, Низ, Право).Обвести(Линия, Линия, Линия, Линия);
	Для НомерСтроки = Верх По Низ Цикл
		Для Колонка = Лево По Право Цикл
			ТабДок.Область(НомерСтроки, Колонка).Обвести(Линия, Линия, Линия, Линия);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
