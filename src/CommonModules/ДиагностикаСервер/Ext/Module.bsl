// Самодиагностика учёта и контроль подозрительных продаж.
//
// Проверки целостности:
//   • количество в регистре ОстаткиТоваров совпадает с количеством партий в ПартииТоваров;
//   • нет отрицательных остатков;
//   • у партий с нулевым количеством не осталось «висящей» стоимости;
//   • очередь уведомлений не застряла (сообщения, которые не уходят после нескольких попыток).
// Два регистра остатков ведутся параллельно, и любая ошибка в проведении сначала проявится
// как расхождение между ними. Проверку можно запускать командой бота /health и через REST API.
//
// Контроль продаж: продажа ниже себестоимости или с большой скидкой ставит тревогу в очередь Telegram.

#Область ПрограммныйИнтерфейс

// Проверяет целостность учёта.
//
// Параметры:
//  Товары - Массив, Неопределено - ограничить проверку товарами.
//
// Возвращаемое значение:
//  Структура:
//   * Ошибки         - Массив из Строка - нарушения целостности.
//   * Предупреждения - Массив из Строка - то, что требует внимания, но учёт не портит.
//   * Исправно       - Булево - ошибок нет.
//
Функция ПроверитьУчет(Товары = Неопределено) Экспорт

	Результат = Новый Структура("Ошибки, Предупреждения, Исправно", Новый Массив, Новый Массив, Истина);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("ПорогПопыток", 3);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Данные.Склад КАК Склад,
	|	Данные.Товар КАК Товар,
	|	СУММА(Данные.ПоОстаткам) КАК ПоОстаткам,
	|	СУММА(Данные.ПоПартиям) КАК ПоПартиям,
	|	СУММА(Данные.СтоимостьПартий) КАК СтоимостьПартий
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.Склад КАК Склад,
	|		Остатки.Товар КАК Товар,
	|		Остатки.КоличествоОстаток КАК ПоОстаткам,
	|		0 КАК ПоПартиям,
	|		0 КАК СтоимостьПартий
	|	ИЗ
	|		РегистрНакопления.ОстаткиТоваров.Остатки(, &УсловиеТоваров) КАК Остатки
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Партии.Склад,
	|		Партии.Товар,
	|		0,
	|		Партии.КоличествоОстаток,
	|		Партии.СтоимостьОстаток
	|	ИЗ
	|		РегистрНакопления.ПартииТоваров.Остатки(, &УсловиеТоваров) КАК Партии) КАК Данные
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Склад,
	|	Данные.Товар
	|
	|ИМЕЮЩИЕ
	|	(СУММА(Данные.ПоОстаткам) <> СУММА(Данные.ПоПартиям)
	|		ИЛИ СУММА(Данные.ПоОстаткам) < 0
	|		ИЛИ СУММА(Данные.ПоПартиям) = 0
	|			И СУММА(Данные.СтоимостьПартий) <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Застряло
	|ИЗ
	|	РегистрСведений.ОчередьУведомлений КАК Очередь
	|ГДЕ
	|	Очередь.КоличествоПопыток >= &ПорогПопыток";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеТоваров", ?(Товары = Неопределено, "", "Товар В (&Товары)"));

	Пакет = Запрос.ВыполнитьПакет();

	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Место = СтрШаблон("""%1"" на складе ""%2""", Выборка.Товар, Выборка.Склад);
		Если Выборка.ПоОстаткам <> Выборка.ПоПартиям Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Остатки и партии расходятся: %1 — остаток %2, в партиях %3",
				Место, Выборка.ПоОстаткам, Выборка.ПоПартиям));
		КонецЕсли;
		Если Выборка.ПоОстаткам < 0 Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Отрицательный остаток: %1 — %2", Место, Выборка.ПоОстаткам));
		КонецЕсли;
		Если Выборка.ПоПартиям = 0 И Выборка.СтоимостьПартий <> 0 Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Стоимость без количества: %1 — %2 ₽",
				Место, ОбщегоНазначенияСервер.ФорматСуммы(Выборка.СтоимостьПартий)));
		КонецЕсли;
	КонецЦикла;

	Выборка = Пакет[1].Выбрать();
	Выборка.Следующий();
	Если Выборка.Застряло > 0 Тогда
		Результат.Предупреждения.Добавить(СтрШаблон("В очереди Telegram %1 сообщ. не уходят после нескольких попыток", Выборка.Застряло));
	КонецЕсли;

	Результат.Исправно = Результат.Ошибки.Количество() = 0;
	Возврат Результат;

КонецФункции

// Текст результата проверки для Telegram.
Функция ТекстПроверки() Экспорт

	Проверка = ПроверитьУчет();
	Строки = Новый Массив;
	Строки.Добавить(?(Проверка.Исправно, "🩺 <b>Учёт в порядке</b> ✅", "🩺 <b>Найдены ошибки учёта</b> ❌"));
	Для Каждого Текст Из Проверка.Ошибки Цикл
		Строки.Добавить("• " + ТелеграмСервер.ЭкранироватьHTML(Текст));
	КонецЦикла;
	Для Каждого Текст Из Проверка.Предупреждения Цикл
		Строки.Добавить("⚠️ " + ТелеграмСервер.ЭкранироватьHTML(Текст));
	КонецЦикла;
	Строки.Добавить("Остатки сходятся с партиями, отрицательных остатков нет: " + ?(Проверка.Исправно, "да", "нет"));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Текст тревоги по продаже: продажа ниже себестоимости или со слишком большой скидкой.
//
// Параметры:
//  Продажа           - ДокументОбъект.ПродажаТовара
//  СебестоимостьСтрок - Соответствие - номер строки → себестоимость (из СписатьПартииFIFO).
//
// Возвращаемое значение:
//  Строка - пустая, если всё в порядке.
//
Функция ТекстТревогиПоПродаже(Продажа, СебестоимостьСтрок) Экспорт

	Причины = Новый Массив;
	Если Продажа.ПроцентСкидки > ПорогСкидки() Тогда
		Причины.Добавить(СтрШаблон("скидка %1%% (больше %2%%)", Продажа.ПроцентСкидки, ПорогСкидки()));
	КонецЕсли;

	Для Каждого СтрокаТовары Из Продажа.Товары Цикл
		Себестоимость = СебестоимостьСтрок[СтрокаТовары.НомерСтроки];
		Если Себестоимость <> Неопределено И СтрокаТовары.Сумма < Себестоимость Тогда
			Причины.Добавить(СтрШаблон("%1 продан ниже себестоимости: %2 ₽ при себестоимости %3 ₽",
				ТелеграмСервер.ЭкранироватьHTML(Строка(СтрокаТовары.Товар)),
				ОбщегоНазначенияСервер.ФорматСуммы(СтрокаТовары.Сумма), ОбщегоНазначенияСервер.ФорматСуммы(Себестоимость)));
		КонецЕсли;
	КонецЦикла;

	Если Причины.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("🚨 <b>Проверьте продажу №%1</b> (%2)", СокрЛП(Продажа.Номер),
		ТелеграмСервер.ЭкранироватьHTML(Строка(Продажа.Склад))));
	Для Каждого Причина Из Причины Цикл
		Строки.Добавить("• " + Причина);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Скидка больше этого процента считается подозрительной.
Функция ПорогСкидки() Экспорт
	Возврат 20;
КонецФункции

#КонецОбласти
