// REST API магазина для сайта, маркетплейсов и внешних сервисов. Ответы в JSON.
//
//   GET /api/v1/health                  — самодиагностика учёта (без ключа)
//   GET /api/v1/stock?sku=..&q=..       — остатки по складам (по артикулу или части названия)
//   GET /api/v1/prices?sku=..           — розничные цены на сегодня
//   GET /api/v1/forecast                — что пора заказать: прогноз дефицита
//
// Доступ по ключу в заголовке X-API-Key (константа ВебAPIКлюч). Пока ключ не задан, закрытые
// методы отвечают 503: API нельзя случайно открыть всему интернету без ключа.
//
// Логика вынесена из модуля HTTP-сервиса сюда: функции принимают обычные соответствия
// параметров и заголовков, поэтому покрыты автотестами без веб-сервера.

#Область ПрограммныйИнтерфейс

// Обрабатывает запрос к API.
//
// Параметры:
//  Метод      - Строка - "health", "stock", "prices", "forecast".
//  Параметры  - Соответствие, ФиксированноеСоответствие - параметры строки запроса.
//  Заголовки  - Соответствие, ФиксированноеСоответствие - заголовки HTTP.
//
// Возвращаемое значение:
//  Структура - КодСостояния (Число), Тело (Строка JSON).
//
Функция Обработать(Метод, Параметры, Заголовки) Экспорт

	Если Метод <> "health" Тогда
		Ключ = Константы.ВебAPIКлюч.Получить();
		Если Не ЗначениеЗаполнено(Ключ) Тогда
			Возврат Ошибка(503, "API не настроен: задайте ключ в константе ВебAPIКлюч");
		КонецЕсли;
		Если ЗначениеЗаголовка(Заголовки, "X-API-Key") <> Ключ Тогда
			Возврат Ошибка(401, "Неверный или отсутствующий заголовок X-API-Key");
		КонецЕсли;
	КонецЕсли;

	Попытка
		Если Метод = "health" Тогда
			Данные = Здоровье();
		ИначеЕсли Метод = "stock" Тогда
			Данные = Остатки(Параметр(Параметры, "sku"), Параметр(Параметры, "q"));
		ИначеЕсли Метод = "prices" Тогда
			Данные = Цены(Параметр(Параметры, "sku"));
		ИначеЕсли Метод = "forecast" Тогда
			Данные = Прогноз();
		Иначе
			Возврат Ошибка(404, "Неизвестный метод: " + Метод);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ВебAPI." + Метод, УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ошибка(500, "Внутренняя ошибка, подробности в журнале регистрации");
	КонецПопытки;

	Возврат Ответ(200, Данные);

КонецФункции

// Ответ HTTP-сервиса из результата Обработать().
Функция HTTPОтвет(Результат) Экспорт
	Ответ = Новый HTTPСервисОтвет(Результат.КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Результат.Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

// Сериализует значение в JSON (структуры, массивы, строки, числа, булево).
Функция ВJSON(Значение) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

#КонецОбласти

#Область Методы

Функция Здоровье()
	Проверка = ДиагностикаСервер.ПроверитьУчет();
	Данные = Новый Структура;
	Данные.Вставить("status", ?(Проверка.Исправно, "ok", "problems"));
	Данные.Вставить("errors", Проверка.Ошибки);
	Данные.Вставить("warnings", Проверка.Предупреждения);
	Данные.Вставить("time", XMLСтрока(ТекущаяДатаСеанса()));
	Возврат Данные;
КонецФункции

Функция Остатки(Артикул, ЧастьНазвания)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Артикул", Артикул);
	Запрос.УстановитьПараметр("Название", "%" + ЭкранироватьПодобие(ЧастьНазвания) + "%");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Товар.Артикул КАК Артикул,
	|	Остатки.Товар.Наименование КАК Наименование,
	|	Остатки.Склад.Наименование КАК Склад,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|	И &ОтборАртикула
	|	И &ОтборНазвания
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование,
	|	Склад";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборАртикула",
		?(ЗначениеЗаполнено(Артикул), "Остатки.Товар.Артикул = &Артикул", "ИСТИНА"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборНазвания",
		?(ЗначениеЗаполнено(ЧастьНазвания), "Остатки.Товар.Наименование ПОДОБНО &Название СПЕЦСИМВОЛ ""~""", "ИСТИНА"));

	Элементы = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("sku", СокрЛП(Выборка.Артикул));
		Элемент.Вставить("name", Выборка.Наименование);
		Элемент.Вставить("warehouse", Выборка.Склад);
		Элемент.Вставить("qty", Выборка.Количество);
		Элементы.Добавить(Элемент);
	КонецЦикла;
	Возврат Новый Структура("items", Элементы);

КонецФункции

Функция Цены(Артикул)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Артикул", Артикул);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Артикул КАК Артикул,
	|	Товары.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Товары КАК Товары
	|ГДЕ
	|	НЕ Товары.ЭтоГруппа
	|	И НЕ Товары.ПометкаУдаления
	|	И &ОтборАртикула
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборАртикула",
		?(ЗначениеЗаполнено(Артикул), "Товары.Артикул = &Артикул", "ИСТИНА"));

	Товары = Запрос.Выполнить().Выгрузить();
	Цены = ЦенообразованиеСервер.ЦеныТоваров(Товары.ВыгрузитьКолонку("Ссылка"), ТекущаяДатаСеанса());

	Элементы = Новый Массив;
	Для Каждого Товар Из Товары Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("sku", СокрЛП(Товар.Артикул));
		Элемент.Вставить("name", Товар.Наименование);
		Элемент.Вставить("price", Цены[Товар.Ссылка]);
		Элементы.Добавить(Элемент);
	КонецЦикла;
	Возврат Новый Структура("items, currency", Элементы, "RUB");

КонецФункции

Функция Прогноз()

	Элементы = Новый Массив;
	Для Каждого СтрокаПрогноза Из ПрогнозЗапасовСервер.Прогноз(ТекущаяДатаСеанса()) Цикл
		Если СтрокаПрогноза.Заказать <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("sku", СокрЛП(ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(СтрокаПрогноза.Товар, "Артикул")));
		Элемент.Вставить("name", Строка(СтрокаПрогноза.Товар));
		Элемент.Вставить("warehouse", Строка(СтрокаПрогноза.Склад));
		Элемент.Вставить("qty", СтрокаПрогноза.Остаток);
		Элемент.Вставить("dailyDemand", СтрокаПрогноза.СпросВДень);
		Элемент.Вставить("daysLeft", СтрокаПрогноза.ДнейХватит);
		Элемент.Вставить("orderQty", СтрокаПрогноза.Заказать);
		Элементы.Добавить(Элемент);
	КонецЦикла;
	Возврат Новый Структура("items", Элементы);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ответ(КодСостояния, Данные)
	Возврат Новый Структура("КодСостояния, Тело", КодСостояния, ВJSON(Данные));
КонецФункции

Функция Ошибка(КодСостояния, Текст)
	Возврат Ответ(КодСостояния, Новый Структура("error", Текст));
КонецФункции

Функция Параметр(Параметры, Имя)
	Если Параметры = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = Параметры.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", СокрЛП(Значение));
КонецФункции

// Заголовки HTTP регистронезависимы: X-API-Key, x-api-key и X-Api-Key — один заголовок.
Функция ЗначениеЗаголовка(Заголовки, Имя)
	Если Заголовки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого КлючИЗначение Из Заголовки Цикл
		Если НРег(КлючИЗначение.Ключ) = НРег(Имя) Тогда
			Возврат КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ЭкранироватьПодобие(Текст)
	Результат = Текст;
	Для Каждого Символ Из СтрРазделить("~,%,_,[,],^", ",") Цикл
		Результат = СтрЗаменить(Результат, Символ, "~" + Символ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
