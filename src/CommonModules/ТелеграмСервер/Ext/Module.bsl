// Отправка уведомлений в Telegram через Bot API.
// Токен бота и ID чата хранятся в константах ТелеграмТокенБота и ТелеграмЧатИД,
// в исходниках их нет.

// Отправляет текст в чат. Возвращает Истина, если Telegram принял сообщение.
Функция ОтправитьСообщение(Текст) Экспорт

	Токен = Константы.ТелеграмТокенБота.Получить();
	ЧатИД = Константы.ТелеграмЧатИД.Получить();
	Если Не ЗначениеЗаполнено(Токен) Или Не ЗначениеЗаполнено(ЧатИД) Тогда
		Возврат Ложь;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("chat_id", ЧатИД);
	Данные.Вставить("text", Текст);
	Данные.Вставить("parse_mode", "HTML");

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);

	Запрос = Новый HTTPЗапрос("/bot" + Токен + "/sendMessage");
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		Соединение = Новый HTTPСоединение("api.telegram.org", 443, , , , 15, Новый ЗащищенноеСоединениеOpenSSL);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		ЗаписьЖурналаРегистрации("Telegram", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Если Ответ.КодСостояния <> 200 Тогда
		ЗаписьЖурналаРегистрации("Telegram", УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон("Код ответа %1: %2", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку()));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Собирает текст уведомления о проведённой продаже и отправляет его.
Функция УведомитьОПродаже(ДокументСсылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПродажаТовара.Номер КАК Номер,
	|	ПРЕДСТАВЛЕНИЕ(ПродажаТовара.Клиент) КАК Клиент,
	|	ПродажаТовара.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ПродажаТовара КАК ПродажаТовара
	|ГДЕ
	|	ПродажаТовара.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(ПродажаТовараТовары.Товар) КАК Товар,
	|	ПродажаТовараТовары.Количество КАК Количество,
	|	ПродажаТовараТовары.Сумма КАК Сумма
	|ИЗ
	|	Документ.ПродажаТовара.Товары КАК ПродажаТовараТовары
	|ГДЕ
	|	ПродажаТовараТовары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПродажаТовараТовары.НомерСтроки";

	Результаты = Запрос.ВыполнитьПакет();
	Шапка = Результаты[0].Выбрать();
	Если Не Шапка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("🛒 <b>Продажа №%1</b> на <b>%2 ₽</b>",
		СокрЛП(Шапка.Номер), ФорматСуммы(Шапка.СуммаДокумента)));
	Если ЗначениеЗаполнено(Шапка.Клиент) Тогда
		Строки.Добавить("Клиент: " + ЭкранироватьHTML(Шапка.Клиент));
	КонецЕсли;
	Строки.Добавить("");

	Товары = Результаты[1].Выбрать();
	Пока Товары.Следующий() Цикл
		Строки.Добавить(СтрШаблон("• %1 × %2 = %3 ₽",
			ЭкранироватьHTML(Товары.Товар), Товары.Количество, ФорматСуммы(Товары.Сумма)));
	КонецЦикла;

	Возврат ОтправитьСообщение(СтрСоединить(Строки, Символы.ПС));

КонецФункции

Функция ФорматСуммы(Сумма)
	Возврат Формат(Сумма, "ЧДЦ=0; ЧН=0; ЧГ=3,0");
КонецФункции

Функция ЭкранироватьHTML(Текст)
	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Возврат СтрЗаменить(Результат, ">", "&gt;");
КонецФункции
