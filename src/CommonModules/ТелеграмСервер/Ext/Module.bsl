// Работа с Telegram Bot API и очередь исходящих уведомлений.
//
// Уведомления не отправляются прямо из проведения: документ кладёт сообщение в регистр
// ОчередьУведомлений в своей транзакции (transactional outbox). Отправка идёт отдельно,
// после фиксации: сразу из формы и регламентным заданием как страховка.
// Так сообщение не уйдёт об откатившейся продаже, а медленный Telegram не держит блокировки остатков.
//
// Токен бота и ID чата хранятся в константах ТелеграмТокенБота и ТелеграмЧатИД, в исходниках их нет.

#Область ПрограммныйИнтерфейс

// Признак, что интеграция с Telegram настроена.
Функция Настроен() Экспорт
	Возврат ЗначениеЗаполнено(Константы.ТелеграмТокенБота.Получить())
		И ЗначениеЗаполнено(Константы.ТелеграмЧатИД.Получить());
КонецФункции

// Отправляет текст в чат.
//
// Параметры:
//  Текст        - Строка - текст в разметке HTML Telegram.
//  ЧатИД        - Строка - если не указан, берётся из настроек.
//  ТекстОшибки  - Строка - выходной параметр с описанием ошибки.
//
// Возвращаемое значение:
//  Булево - Истина, если Telegram принял сообщение.
//
Функция ОтправитьСообщение(Текст, ЧатИД = Неопределено, ТекстОшибки = "") Экспорт

	Данные = Новый Структура;
	Данные.Вставить("chat_id", ?(ЗначениеЗаполнено(ЧатИД), ЧатИД, Константы.ТелеграмЧатИД.Получить()));
	Данные.Вставить("text", Текст);
	Данные.Вставить("parse_mode", "HTML");
	Данные.Вставить("disable_web_page_preview", Истина);

	Ответ = ВызватьМетодAPI("sendMessage", Данные, , ТекстОшибки);
	Возврат Ответ <> Неопределено;

КонецФункции

// Вызывает метод Bot API.
//
// Параметры:
//  Метод        - Строка - имя метода, например "sendMessage".
//  Данные       - Структура - параметры метода, передаются JSON.
//  Таймаут      - Число - таймаут HTTP в секундах.
//  ТекстОшибки  - Строка - выходной параметр.
//
// Возвращаемое значение:
//  Соответствие, Массив, Неопределено - поле result ответа или Неопределено при ошибке.
//
Функция ВызватьМетодAPI(Метод, Данные = Неопределено, Таймаут = 15, ТекстОшибки = "") Экспорт

	Токен = Константы.ТелеграмТокенБота.Получить();
	Если Не ЗначениеЗаполнено(Токен) Тогда
		ТекстОшибки = "Не задан токен бота";
		Возврат Неопределено;
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ?(Данные = Неопределено, Новый Структура, Данные));

	Запрос = Новый HTTPЗапрос("/bot" + Токен + "/" + Метод);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		Соединение = Новый HTTPСоединение("api.telegram.org", 443, , , , Таймаут, Новый ЗащищенноеСоединениеOpenSSL);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьОшибку(Метод, ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;

	Если Ответ.КодСостояния <> 200 Тогда
		ТекстОшибки = СтрШаблон("HTTP %1: %2", Ответ.КодСостояния, Лев(ТелоОтвета, 500));
		ЗаписатьОшибку(Метод, ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Возврат Результат["result"];

КонецФункции

// Кладёт сообщение в очередь. Вызывается внутри транзакции записи документа.
//
// Параметры:
//  Текст    - Строка - текст сообщения.
//  Источник - Строка - откуда сообщение (для журнала и отладки).
//
Процедура ПоставитьВОчередь(Текст, Источник = "") Экспорт

	Запись = РегистрыСведений.ОчередьУведомлений.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Строка(Новый УникальныйИдентификатор);
	Запись.Текст = Текст;
	Запись.Источник = Лев(Источник, 150);
	Запись.ДатаСоздания = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

// Ставит в очередь уведомление о проведённой продаже. Данные берутся из объекта,
// поэтому процедуру можно вызывать прямо из ОбработкаПроведения.
Процедура ПоставитьВОчередьУведомлениеОПродаже(Продажа) Экспорт

	Если Не Настроен() Тогда
		Возврат;
	КонецЕсли;
	ПоставитьВОчередь(ТекстУведомленияОПродаже(Продажа), "Продажа " + СокрЛП(Продажа.Номер));

КонецПроцедуры

// Текст уведомления о продаже.
//
// Параметры:
//  Продажа - ДокументОбъект.ПродажаТовара, ДокументСсылка.ПродажаТовара
//
Функция ТекстУведомленияОПродаже(Продажа) Экспорт

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("🛒 <b>Продажа №%1</b> на <b>%2 ₽</b>",
		СокрЛП(Продажа.Номер), ОбщегоНазначенияСервер.ФорматСуммы(Продажа.СуммаДокумента)));
	Строки.Добавить(СтрШаблон("%1 · %2", ЭкранироватьHTML(Строка(Продажа.Склад)), ЭкранироватьHTML(Строка(Продажа.СпособОплаты))));
	Если ЗначениеЗаполнено(Продажа.Клиент) Тогда
		Скидка = ?(Продажа.ПроцентСкидки > 0, СтрШаблон(" (скидка %1%%)", Продажа.ПроцентСкидки), "");
		Строки.Добавить("Клиент: " + ЭкранироватьHTML(Строка(Продажа.Клиент)) + Скидка);
	КонецЕсли;
	Строки.Добавить("");
	Для Каждого СтрокаТовары Из Продажа.Товары Цикл
		Строки.Добавить(СтрШаблон("• %1 × %2 = %3 ₽",
			ЭкранироватьHTML(Строка(СтрокаТовары.Товар)),
			ОбщегоНазначенияСервер.ФорматКоличества(СтрокаТовары.Количество),
			ОбщегоНазначенияСервер.ФорматСуммы(СтрокаТовары.Сумма)));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Отправляет накопившиеся сообщения из очереди.
// Каждое сообщение обрабатывается в своей транзакции под исключительной блокировкой,
// поэтому форма и регламентное задание не отправят одно сообщение дважды.
//
// Параметры:
//  Максимум - Число - сколько сообщений обработать за один вызов.
//
// Возвращаемое значение:
//  Число - сколько сообщений отправлено.
//
Функция ОтправитьОчередьУведомлений(Максимум = 50) Экспорт

	Если Не Настроен() Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МаксимумПопыток", МаксимумПопыток());
	Запрос.Текст = СтрЗаменить(
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	Очередь.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ОчередьУведомлений КАК Очередь
	|ГДЕ
	|	Очередь.КоличествоПопыток < &МаксимумПопыток
	|
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ДатаСоздания", "ПЕРВЫЕ 50", "ПЕРВЫЕ " + Формат(Максимум, "ЧГ=0"));

	Отправлено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ОтправитьИзОчереди(Выборка.Идентификатор) Тогда
			Отправлено = Отправлено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Отправлено;

КонецФункции

// Количество сообщений, ожидающих отправки.
Функция РазмерОчереди() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.ОчередьУведомлений КАК Очередь";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

// Экранирует спецсимволы для разметки HTML Telegram.
Функция ЭкранироватьHTML(Текст) Экспорт
	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Возврат СтрЗаменить(Результат, ">", "&gt;");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтправитьИзОчереди(Идентификатор)

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ОчередьУведомлений");
		Элемент.УстановитьЗначение("Идентификатор", Идентификатор);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		Запись = РегистрыСведений.ОчередьУведомлений.СоздатьМенеджерЗаписи();
		Запись.Идентификатор = Идентификатор;
		Запись.Прочитать();
		Если Не Запись.Выбран() Тогда
			// Сообщение уже отправил другой сеанс.
			ЗафиксироватьТранзакцию();
			Возврат Ложь;
		КонецЕсли;

		ТекстОшибки = "";
		Если ОтправитьСообщение(Запись.Текст, , ТекстОшибки) Тогда
			Запись.Удалить();
			Отправлено = Истина;
		Иначе
			Запись.КоличествоПопыток = Запись.КоличествоПопыток + 1;
			Запись.ПоследняяОшибка = ТекстОшибки;
			Запись.Записать();
			Отправлено = Ложь;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписатьОшибку("Очередь", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Отправлено = Ложь;
	КонецПопытки;

	Возврат Отправлено;

КонецФункции

Функция МаксимумПопыток()
	Возврат 10;
КонецФункции

Процедура ЗаписатьОшибку(Метод, ТекстОшибки)
	ЗаписьЖурналаРегистрации("Telegram." + Метод, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
КонецПроцедуры

#КонецОбласти
