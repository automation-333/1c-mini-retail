// Тесты интеграций: загрузка из CSV, очередь уведомлений, ответы Telegram-бота.
// Реальная отправка в Telegram проверяется, только если при запуске переданы токен и чат.

#Область СписокТестов

Функция СписокТестов() Экспорт
	Тесты = Новый Массив;
	Тесты.Добавить("РазборCSVПоддерживаетКавычкиИРазделители");
	Тесты.Добавить("ЗагрузкаCSVСоздаетИОбновляетТоварыИЦены");
	Тесты.Добавить("ЗагрузкаCSVПропускаетОшибочныеСтроки");
	Тесты.Добавить("ПроведениеПродажиСтавитУведомлениеВОчередь");
	Тесты.Добавить("ТекстУведомленияСодержитТоварыИСумму");
	Тесты.Добавить("КомандаОстаткиНаходитТоварПоНазванию");
	Тесты.Добавить("КомандаПродажиСчитаетВыручкуЗаДень");
	Тесты.Добавить("НеизвестнаяКомандаВозвращаетСправку");
	Тесты.Добавить("ОтправкаСообщенияВTelegram");
	Возврат Тесты;
КонецФункции

#КонецОбласти

#Область Тесты

Процедура РазборCSVПоддерживаетКавычкиИРазделители() Экспорт

	Текст = "Артикул;Наименование;Цена" + Символы.ПС
		+ "A-1;""Кофе """"Арабика""""; 1 кг"";1 250,50" + Символы.ПС
		+ Символы.ПС
		+ "A-2;Чай;300";
	Строки = ЗагрузкаДанныхСервер.РазобратьCSV(Текст);

	Самопроверка.ОжидатьРавенство(Строки.Количество(), 3, "Пустые строки пропускаются");
	Самопроверка.ОжидатьРавенство(Строки[1][1], "Кофе ""Арабика""; 1 кг", "Кавычки и разделитель внутри поля");
	Самопроверка.ОжидатьРавенство(Строки[1][2], "1 250,50", "Число с пробелом и запятой");
	Самопроверка.ОжидатьРавенство(Строки[2][0], "A-2", "Вторая строка данных");

КонецПроцедуры

Процедура ЗагрузкаCSVСоздаетИОбновляетТоварыИЦены() Экспорт

	Префикс = Лев(Строка(Новый УникальныйИдентификатор), 6);
	Группа = "Группа " + Префикс;
	Текст = "Артикул;Наименование;Группа;Штрихкод;ЕдиницаИзмерения;Цена" + Символы.ПС
		+ Префикс + "-1;Кофе " + Префикс + ";" + Группа + ";4600000000011;шт;450" + Символы.ПС
		+ Префикс + "-2;Чай " + Префикс + ";" + Группа + ";;шт;300" + Символы.ПС
		+ Префикс + "-3;Джезва " + Префикс + ";;;шт;";

	Итог = ЗагрузкаДанныхСервер.ЗагрузитьТоварыИзCSV(Текст, Самопроверка.ДатаТеста(500));
	Самопроверка.ОжидатьРавенство(Итог.Ошибки.Количество(), 0, "Без ошибок");
	Самопроверка.ОжидатьРавенство(Итог.Создано, 3, "Создано товаров");
	Самопроверка.ОжидатьРавенство(Итог.ЦенУстановлено, 2, "Установлено цен (у третьего товара цены нет)");

	Кофе = Справочники.Товары.НайтиПоРеквизиту("Артикул", Префикс + "-1");
	Самопроверка.Ожидать(ЗначениеЗаполнено(Кофе), "товар найден по артикулу");
	Самопроверка.ОжидатьРавенство(Строка(Кофе.Родитель), Группа, "Создана группа");
	Самопроверка.ОжидатьРавенство(ЦенообразованиеСервер.ЦенаТовара(Кофе, Самопроверка.ДатаТеста(500)), 450, "Цена установлена");

	// Повторная загрузка с новой ценой обновляет, а не дублирует товары.
	Текст = СтрЗаменить(Текст, ";450", ";490");
	Итог = ЗагрузкаДанныхСервер.ЗагрузитьТоварыИзCSV(Текст, Самопроверка.ДатаТеста(510));
	Самопроверка.ОжидатьРавенство(Итог.Создано, 0, "Повторно ничего не создано");
	Самопроверка.ОжидатьРавенство(Итог.Обновлено, 3, "Все товары обновлены");
	Самопроверка.ОжидатьРавенство(ЦенообразованиеСервер.ЦенаТовара(Кофе, Самопроверка.ДатаТеста(510)), 490, "Новая цена с даты загрузки");
	Самопроверка.ОжидатьРавенство(ЦенообразованиеСервер.ЦенаТовара(Кофе, Самопроверка.ДатаТеста(505)), 450, "Старая цена до даты загрузки");

КонецПроцедуры

Процедура ЗагрузкаCSVПропускаетОшибочныеСтроки() Экспорт

	Префикс = Лев(Строка(Новый УникальныйИдентификатор), 6);
	Текст = "Артикул,Наименование,Цена" + Символы.ПС
		+ Префикс + "-1,Нормальный товар,100" + Символы.ПС
		+ ",Без артикула,100" + Символы.ПС
		+ Префикс + "-3,Плохая цена,сто рублей";

	Итог = ЗагрузкаДанныхСервер.ЗагрузитьТоварыИзCSV(Текст, Самопроверка.ДатаТеста(520));

	Самопроверка.ОжидатьРавенство(Итог.Создано, 1, "Загружена только корректная строка");
	Самопроверка.ОжидатьРавенство(Итог.Ошибки.Количество(), 2, "Две ошибки строк");
	Самопроверка.ОжидатьВхождение(Итог.Ошибки[1], "некорректная цена", "Текст ошибки цены");

КонецПроцедуры

Процедура ПроведениеПродажиСтавитУведомлениеВОчередь() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Мокко");
	Самопроверка.Поступление(Склад, Товар, 5, 50, Самопроверка.ДатаТеста(600));

	ПрежнийТокен = Константы.ТелеграмТокенБота.Получить();
	ПрежнийЧат = Константы.ТелеграмЧатИД.Получить();
	Если Не ТелеграмСервер.Настроен() Тогда
		Константы.ТелеграмТокенБота.Установить("TEST-TOKEN");
		Константы.ТелеграмЧатИД.Установить("1");
	КонецЕсли;

	Попытка
		До = ТелеграмСервер.РазмерОчереди();
		Продажа = Самопроверка.Продажа(Склад, Товар, 1, 100, Самопроверка.ДатаТеста(601), , Истина);
		Самопроверка.ОжидатьРавенство(ТелеграмСервер.РазмерОчереди(), До + 1, "В очереди появилось уведомление");

		// Перепроведение не должно слать уведомление повторно.
		Объект = Продажа.ПолучитьОбъект();
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		Самопроверка.ОжидатьРавенство(ТелеграмСервер.РазмерОчереди(), До + 1, "Перепроведение не дублирует уведомление");

		УдалитьИзОчереди("Продажа " + СокрЛП(Продажа.Номер));
	Исключение
		ВосстановитьНастройки(ПрежнийТокен, ПрежнийЧат);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьНастройки(ПрежнийТокен, ПрежнийЧат);

КонецПроцедуры

Процедура ТекстУведомленияСодержитТоварыИСумму() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Глясе <акция>");
	Клиент = Самопроверка.НовыйКлиент(5);
	Самопроверка.Поступление(Склад, Товар, 5, 50, Самопроверка.ДатаТеста(610));
	Продажа = Самопроверка.Продажа(Склад, Товар, 3, 1000, Самопроверка.ДатаТеста(611), Клиент);

	Текст = ТелеграмСервер.ТекстУведомленияОПродаже(Продажа);

	Самопроверка.ОжидатьВхождение(Текст, "2 850,00", "Сумма со скидкой 5%");
	Самопроверка.ОжидатьВхождение(Текст, "&lt;акция&gt;", "Спецсимволы HTML экранированы");
	Самопроверка.ОжидатьВхождение(Текст, "скидка 5%", "Указана скидка");

КонецПроцедуры

Процедура КомандаОстаткиНаходитТоварПоНазванию() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Бот-товар");
	Самопроверка.Поступление(Склад, Товар, 7, 10, Самопроверка.ДатаТеста(700));

	Ответ = ТелеграмБот.ОтветНаКоманду("/ostatki " + Строка(Товар));

	Самопроверка.ОжидатьВхождение(Ответ, Строка(Товар), "Товар в ответе");
	Самопроверка.ОжидатьВхождение(Ответ, "7 шт.", "Количество в ответе");

КонецПроцедуры

Процедура КомандаПродажиСчитаетВыручкуЗаДень() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Сводка");
	День = Самопроверка.УникальнаяДатаТеста();
	Самопроверка.Поступление(Склад, Товар, 5, 100, День);
	Самопроверка.Продажа(Склад, Товар, 2, 350, День + 3600);

	Текст = ТелеграмБот.ТекстСводкиПродаж(День);

	Самопроверка.ОжидатьВхождение(Текст, "Выручка: <b>700,00 ₽</b>", "Выручка за день");
	Самопроверка.ОжидатьВхождение(Текст, "Валовая прибыль: <b>500,00 ₽</b>", "Прибыль за день");
	Самопроверка.ОжидатьВхождение(Текст, "Чеков: 1", "Число чеков");

КонецПроцедуры

Процедура НеизвестнаяКомандаВозвращаетСправку() Экспорт

	Ответ = ТелеграмБот.ОтветНаКоманду("привет");
	Самопроверка.ОжидатьВхождение(Ответ, "/ostatki", "Справка со списком команд");

КонецПроцедуры

Процедура ОтправкаСообщенияВTelegram() Экспорт

	Токен = Константы.ТелеграмТокенБота.Получить();
	Если Не ТелеграмСервер.Настроен() Или Токен = "TEST-TOKEN" Тогда
		Самопроверка.Пропустить("Telegram не настроен: передайте token и chat при запуске автотестов");
	КонецЕсли;

	ТекстОшибки = "";
	Отправлено = ТелеграмСервер.ОтправитьСообщение("✅ Автотесты мини-розницы: связь с Telegram работает", , ТекстОшибки);
	Самопроверка.Ожидать(Отправлено, "Telegram принял сообщение. " + ТекстОшибки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УдалитьИзОчереди(Источник)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ОчередьУведомлений КАК Очередь
	|ГДЕ
	|	Очередь.Источник = &Источник";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.ОчередьУведомлений.СоздатьМенеджерЗаписи();
		Запись.Идентификатор = Выборка.Идентификатор;
		Запись.Удалить();
	КонецЦикла;
КонецПроцедуры

Процедура ВосстановитьНастройки(Токен, Чат)
	Константы.ТелеграмТокенБота.Установить(Токен);
	Константы.ТелеграмЧатИД.Установить(Чат);
КонецПроцедуры

#КонецОбласти
