// Telegram-бот магазина: отвечает на команды данными из базы.
//
//   /ostatki [текст]  — остатки по складам (с фильтром по названию товара)
//   /malo             — товары, которые заканчиваются
//   /prodazhi         — продажи за сегодня: выручка, себестоимость, прибыль
//   /top              — топ-5 товаров по выручке за 7 дней
//   /prognoz          — прогноз дефицита: что заказать
//   /zakaz            — создать черновики поступлений по прогнозу
//   /health           — самодиагностика учёта
//   /ask вопрос       — вопрос ИИ-ассистенту (Claude); вопрос со знаком «?» на конце — тоже
//   /help             — список команд
//
// Бот отвечает только в чат из константы ТелеграмЧатИД: данные магазина не уходят посторонним.
// Команды забираются методом getUpdates (long polling), номер последнего обработанного
// обновления хранится в константе ТелеграмПоследнийUpdateID.

#Область ПрограммныйИнтерфейс

// Забирает новые сообщения бота и отвечает на команды.
//
// Параметры:
//  ОжиданиеСекунд - Число - сколько Telegram ждёт новых сообщений (long polling); 0 — без ожидания.
//
// Возвращаемое значение:
//  Число - сколько команд обработано.
//
Функция ОбработатьВходящиеКоманды(ОжиданиеСекунд = 0) Экспорт

	Если Не ТелеграмСервер.Настроен() Тогда
		Возврат 0;
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("offset", Константы.ТелеграмПоследнийUpdateID.Получить() + 1);
	Параметры.Вставить("timeout", ОжиданиеСекунд);
	Параметры.Вставить("allowed_updates", СтрРазделить("message", ","));

	Обновления = ТелеграмСервер.ВызватьМетодAPI("getUpdates", Параметры, ОжиданиеСекунд + 15);
	Если ТипЗнч(Обновления) <> Тип("Массив") Тогда
		Возврат 0;
	КонецЕсли;

	РазрешенныйЧат = СокрЛП(Константы.ТелеграмЧатИД.Получить());
	Обработано = 0;

	Для Каждого Обновление Из Обновления Цикл

		Константы.ТелеграмПоследнийUpdateID.Установить(Обновление["update_id"]);

		Сообщение = Обновление["message"];
		Если ТипЗнч(Сообщение) <> Тип("Соответствие") Или Сообщение["text"] = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЧатИД = Формат(Сообщение["chat"]["id"], "ЧГ=0");
		Если ЧатИД <> РазрешенныйЧат Тогда
			ТелеграмСервер.ОтправитьСообщение("Это закрытый бот магазина.", ЧатИД);
			Продолжить;
		КонецЕсли;

		ТелеграмСервер.ОтправитьСообщение(ОтветНаКоманду(Сообщение["text"]), ЧатИД);
		Обработано = Обработано + 1;

	КонецЦикла;

	Возврат Обработано;

КонецФункции

// Работает как бот заданное время: принимает команды и отправляет очередь уведомлений.
// Для файловой базы без регламентных заданий: /C "bot;seconds=3600".
Процедура ЗапуститьЦиклБота(Секунд) Экспорт

	Окончание = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Окончание Цикл
		ТелеграмСервер.ОтправитьОчередьУведомлений();
		ОбработатьВходящиеКоманды(20);
	КонецЦикла;

КонецПроцедуры

// Ответ на текст команды. Не обращается к Telegram, поэтому покрыт автотестами.
//
// Параметры:
//  ТекстКоманды - Строка - текст сообщения пользователя.
//
// Возвращаемое значение:
//  Строка - ответ в разметке HTML Telegram.
//
Функция ОтветНаКоманду(ТекстКоманды) Экспорт

	Текст = СокрЛП(ТекстКоманды);
	Пробел = СтрНайти(Текст, " ");
	Команда = НРег(?(Пробел = 0, Текст, Лев(Текст, Пробел - 1)));
	Аргумент = ?(Пробел = 0, "", СокрЛП(Сред(Текст, Пробел + 1)));

	// Команда может прийти как /ostatki@имя_бота.
	Собака = СтрНайти(Команда, "@");
	Если Собака > 0 Тогда
		Команда = Лев(Команда, Собака - 1);
	КонецЕсли;

	Если Команда = "/ostatki" Или Команда = "остатки" Тогда
		Возврат ОтветОстатки(Аргумент);
	ИначеЕсли Команда = "/malo" Или Команда = "мало" Тогда
		Возврат ОтветЗаканчиваются();
	ИначеЕсли Команда = "/prodazhi" Или Команда = "продажи" Тогда
		Возврат ТекстСводкиПродаж(ТекущаяДатаСеанса());
	ИначеЕсли Команда = "/top" Или Команда = "топ" Тогда
		Возврат ОтветТопТоваров();
	ИначеЕсли Команда = "/prognoz" Или Команда = "прогноз" Тогда
		Возврат ПрогнозЗапасовСервер.ТекстПрогноза(ТекущаяДатаСеанса());
	ИначеЕсли Команда = "/zakaz" Или Команда = "заказ" Тогда
		Возврат ОтветЧерновикиЗаказов();
	ИначеЕсли Команда = "/health" Или Команда = "проверка" Тогда
		Возврат ДиагностикаСервер.ТекстПроверки();
	ИначеЕсли Команда = "/ask" Или Команда = "/ai" Тогда
		Возврат ?(ПустаяСтрока(Аргумент), "Напишите вопрос после команды: /ask сколько заработали за неделю?", ИИАссистентСервер.ОтветитьНаВопрос(Аргумент));
	ИначеЕсли Не СтрНачинаетсяС(Текст, "/") И СтрЗаканчиваетсяНа(Текст, "?") Тогда
		// Вопрос обычными словами — ИИ-ассистенту.
		Возврат ИИАссистентСервер.ОтветитьНаВопрос(Текст);
	КонецЕсли;

	Возврат ТекстСправки();

КонецФункции

// Сводка продаж за день: выручка, себестоимость, прибыль, число чеков, разбивка по оплате.
Функция ТекстСводкиПродаж(Дата) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(Дата));
	Запрос.УстановитьПараметр("Конец", КонецДня(Дата));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПродажиОбороты.СпособОплаты КАК СпособОплаты,
	|	ПродажиОбороты.ВыручкаОборот КАК Выручка,
	|	ПродажиОбороты.СебестоимостьОборот КАК Себестоимость
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&Начало, &Конец, , ) КАК ПродажиОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ПродажаТовара.Ссылка) КАК Чеков
	|ИЗ
	|	Документ.ПродажаТовара КАК ПродажаТовара
	|ГДЕ
	|	ПродажаТовара.Проведен
	|	И ПродажаТовара.Дата МЕЖДУ &Начало И &Конец";

	Результаты = Запрос.ВыполнитьПакет();
	ПоОплате = Результаты[0].Выгрузить();
	Чеки = Результаты[1].Выбрать();
	Чеки.Следующий();

	Выручка = ПоОплате.Итог("Выручка");
	Себестоимость = ПоОплате.Итог("Себестоимость");

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("📊 <b>Продажи за %1</b>", Формат(Дата, "ДФ=dd.MM.yyyy")));
	Строки.Добавить(СтрШаблон("Чеков: %1", Чеки.Чеков));
	Строки.Добавить(СтрШаблон("Выручка: <b>%1 ₽</b>", ОбщегоНазначенияСервер.ФорматСуммы(Выручка)));
	Строки.Добавить(СтрШаблон("Себестоимость: %1 ₽", ОбщегоНазначенияСервер.ФорматСуммы(Себестоимость)));
	Строки.Добавить(СтрШаблон("Валовая прибыль: <b>%1 ₽</b>", ОбщегоНазначенияСервер.ФорматСуммы(Выручка - Себестоимость)));
	Если Чеки.Чеков > 0 Тогда
		Строки.Добавить(СтрШаблон("Средний чек: %1 ₽", ОбщегоНазначенияСервер.ФорматСуммы(Выручка / Чеки.Чеков)));
	КонецЕсли;

	ПоОплате.Свернуть("СпособОплаты", "Выручка");
	Для Каждого СтрокаОплаты Из ПоОплате Цикл
		Если СтрокаОплаты.Выручка <> 0 Тогда
			Строки.Добавить(СтрШаблон("  • %1: %2 ₽", СтрокаОплаты.СпособОплаты, ОбщегоНазначенияСервер.ФорматСуммы(СтрокаОплаты.Выручка)));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Ежедневный отчёт: сводка продаж и товары, которые заканчиваются.
Функция ТекстЕжедневногоОтчета(Дата) Экспорт
	Возврат ТекстСводкиПродаж(Дата) + Символы.ПС + Символы.ПС + ОтветЗаканчиваются();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтветОстатки(Фильтр)

	Остатки = УчетТоваровСервер.ТекущиеОстатки();
	Строки = Новый Массив;
	Строки.Добавить(?(ПустаяСтрока(Фильтр), "📦 <b>Остатки товаров</b>", "📦 <b>Остатки: " + ТелеграмСервер.ЭкранироватьHTML(Фильтр) + "</b>"));

	ТекущийСклад = Неопределено;
	Выведено = 0;
	Для Каждого Остаток Из Остатки Цикл
		Если Остаток.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(Фильтр) И СтрНайти(НРег(Строка(Остаток.Товар)), НРег(Фильтр)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Выведено >= 30 Тогда
			Строки.Добавить("…и другие, уточните запрос: /ostatki кофе");
			Прервать;
		КонецЕсли;
		Если Остаток.Склад <> ТекущийСклад Тогда
			Строки.Добавить("");
			Строки.Добавить("<b>" + ТелеграмСервер.ЭкранироватьHTML(Строка(Остаток.Склад)) + "</b>");
			ТекущийСклад = Остаток.Склад;
		КонецЕсли;
		Строки.Добавить(СтрШаблон("• %1: %2 шт.", ТелеграмСервер.ЭкранироватьHTML(Строка(Остаток.Товар)),
			ОбщегоНазначенияСервер.ФорматКоличества(Остаток.Количество)));
		Выведено = Выведено + 1;
	КонецЦикла;

	Если Выведено = 0 Тогда
		Строки.Добавить("Ничего не найдено");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ОтветЗаканчиваются()

	Порог = 3;
	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("⚠️ <b>Заканчиваются (осталось %1 шт. и меньше)</b>", Порог));

	Для Каждого Остаток Из УчетТоваровСервер.ТекущиеОстатки() Цикл
		Если Остаток.Количество > 0 И Остаток.Количество <= Порог Тогда
			Строки.Добавить(СтрШаблон("• %1 — %2 шт. (%3)", ТелеграмСервер.ЭкранироватьHTML(Строка(Остаток.Товар)),
				ОбщегоНазначенияСервер.ФорматКоличества(Остаток.Количество), ТелеграмСервер.ЭкранироватьHTML(Строка(Остаток.Склад))));
		КонецЕсли;
	КонецЦикла;

	Если Строки.Количество() = 1 Тогда
		Строки.Добавить("Всё в наличии ✅");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ОтветТопТоваров()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(ТекущаяДатаСеанса()) - 6 * 86400);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 5
	|	ПродажиОбороты.Товар КАК Товар,
	|	ПродажиОбороты.КоличествоОборот КАК Количество,
	|	ПродажиОбороты.ВыручкаОборот КАК Выручка
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&Начало, , , ) КАК ПродажиОбороты
	|ГДЕ
	|	ПродажиОбороты.ВыручкаОборот > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Выручка УБЫВ";

	Строки = Новый Массив;
	Строки.Добавить("🏆 <b>Топ-5 товаров за 7 дней</b>");
	Место = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Место = Место + 1;
		Строки.Добавить(СтрШаблон("%1. %2 — %3 шт., %4 ₽", Место, ТелеграмСервер.ЭкранироватьHTML(Строка(Выборка.Товар)),
			ОбщегоНазначенияСервер.ФорматКоличества(Выборка.Количество), ОбщегоНазначенияСервер.ФорматСуммы(Выборка.Выручка)));
	КонецЦикла;
	Если Место = 0 Тогда
		Строки.Добавить("Продаж пока нет");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ОтветЧерновикиЗаказов()

	Черновики = ПрогнозЗапасовСервер.СоздатьЧерновикиЗаказов(ТекущаяДатаСеанса());
	Если Черновики.Количество() = 0 Тогда
		Возврат "📝 Заказывать пока нечего: запасов хватит минимум на " + ПрогнозЗапасовСервер.ДнейДоЗаказа() + " дн. ✅";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("📝 <b>Созданы черновики поступлений</b> (не проведены, проверьте в 1С):");
	Для Каждого Черновик Из Черновики Цикл
		Реквизиты = ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта(Черновик, "Номер, Склад, Поставщик, СуммаДокумента");
		Строки.Добавить(СтрШаблон("• №%1, %2, %3: %4 ₽", СокрЛП(Реквизиты.Номер), ТелеграмСервер.ЭкранироватьHTML(Строка(Реквизиты.Склад)),
			?(ЗначениеЗаполнено(Реквизиты.Поставщик), ТелеграмСервер.ЭкранироватьHTML(Строка(Реквизиты.Поставщик)), "поставщик не указан"),
			ОбщегоНазначенияСервер.ФорматСуммы(Реквизиты.СуммаДокумента)));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция ТекстСправки()

	Название = Константы.НазваниеМагазина.Получить();
	Строки = Новый Массив;
	Строки.Добавить("🤖 <b>" + ?(ЗначениеЗаполнено(Название), ТелеграмСервер.ЭкранироватьHTML(Название), "Бот магазина") + "</b>");
	Строки.Добавить("");
	Строки.Добавить("/ostatki — остатки по складам");
	Строки.Добавить("/ostatki кофе — остатки по названию");
	Строки.Добавить("/malo — что заканчивается");
	Строки.Добавить("/prodazhi — продажи за сегодня");
	Строки.Добавить("/top — топ-5 товаров за неделю");
	Строки.Добавить("/prognoz — что скоро закончится и сколько заказать");
	Строки.Добавить("/zakaz — черновики поступлений по прогнозу");
	Строки.Добавить("/health — проверка учёта");
	Строки.Добавить("");
	Строки.Добавить("🤖 Или спросите обычными словами, со знаком вопроса:");
	Строки.Добавить("<i>сколько заработали за неделю и что пора заказать?</i>");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти
