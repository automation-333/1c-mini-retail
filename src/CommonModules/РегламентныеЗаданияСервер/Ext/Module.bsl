// Обработчики регламентных заданий и их настройка.

#Область ОбработчикиРегламентныхЗаданий

// Каждую минуту: отправка очереди уведомлений (страховка, если форма не успела отправить сразу).
Процедура ОтправкаУведомленийTelegram() Экспорт
	ТелеграмСервер.ОтправитьОчередьУведомлений();
КонецПроцедуры

// Каждые 30 секунд: ответы бота на команды.
Процедура ОбработкаКомандTelegramБота() Экспорт
	ТелеграмБот.ОбработатьВходящиеКоманды(0);
КонецПроцедуры

// Каждый день в 21:00: сводка продаж и товары, которые заканчиваются.
Процедура ЕжедневныйОтчетTelegram() Экспорт
	Если ТелеграмСервер.Настроен() Тогда
		ТелеграмСервер.ОтправитьСообщение(ТелеграмБот.ТекстЕжедневногоОтчета(ТекущаяДатаСеанса()));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает расписания и включает или выключает задания интеграции с Telegram.
Процедура НастроитьЗаданияTelegram(Включить) Экспорт

	КаждуюМинуту = Новый РасписаниеРегламентногоЗадания;
	КаждуюМинуту.ПериодПовтораДней = 1;
	КаждуюМинуту.ПериодПовтораВТечениеДня = 60;
	УстановитьРасписание(Метаданные.РегламентныеЗадания.ОтправкаУведомленийTelegram, КаждуюМинуту, Включить);

	Каждые30Секунд = Новый РасписаниеРегламентногоЗадания;
	Каждые30Секунд.ПериодПовтораДней = 1;
	Каждые30Секунд.ПериодПовтораВТечениеДня = 30;
	УстановитьРасписание(Метаданные.РегламентныеЗадания.ОбработкаКомандTelegramБота, Каждые30Секунд, Включить);

	Ежедневно = Новый РасписаниеРегламентногоЗадания;
	Ежедневно.ПериодПовтораДней = 1;
	Ежедневно.ВремяНачала = Дата(1, 1, 1, 21, 0, 0);
	УстановитьРасписание(Метаданные.РегламентныеЗадания.ЕжедневныйОтчетTelegram, Ежедневно, Включить);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьРасписание(МетаданныеЗадания, Расписание, Использование)
	Задание = РегламентныеЗадания.НайтиПредопределенное(МетаданныеЗадания);
	Задание.Расписание = Расписание;
	Задание.Использование = Использование;
	Задание.Записать();
КонецПроцедуры

#КонецОбласти
