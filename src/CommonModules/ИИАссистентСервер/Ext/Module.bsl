// ИИ-ассистент владельца магазина на Claude API (Anthropic Messages API) с вызовом инструментов.
//
// Владелец пишет боту вопрос обычными словами: «сколько заработали на этой неделе и что пора заказать?».
// Модель не видит базу целиком. Она получает список инструментов (функций 1С) с описанием параметров
// и сама решает, какие вызвать. 1С выполняет вызовы своими запросами и возвращает результат в JSON,
// модель читает его и либо вызывает следующий инструмент, либо пишет ответ. Это цикл агента:
//
//   вопрос → Claude: stop_reason = tool_use → 1С выполняет инструмент → tool_result → Claude → … → ответ
//
// Цифры в ответе берутся только из инструментов: модель не может «придумать» выручку,
// а данные покидают базу только в объёме, который нужен для ответа.
//
// Ключ API хранится в константе ClaudeКлючAPI, модель — в ClaudeМодель (по умолчанию claude-opus-5-5).
// Для автотестов вместо HTTP можно передать заготовленные ответы API: цикл агента проверяется без сети.

#Область ПрограммныйИнтерфейс

// Признак, что ассистент настроен.
Функция Настроен() Экспорт
	Возврат ЗначениеЗаполнено(Константы.ClaudeКлючAPI.Получить());
КонецФункции

// Ответ ассистента на вопрос владельца.
//
// Параметры:
//  Вопрос - Строка - вопрос обычными словами.
//
// Возвращаемое значение:
//  Строка - ответ в разметке HTML Telegram.
//
Функция ОтветитьНаВопрос(Вопрос) Экспорт

	Если Не Настроен() Тогда
		Возврат "🤖 ИИ-ассистент не настроен: задайте ключ Claude API в константе «Claude: ключ API» "
			+ "или запуском /C ""settings;claude=<ключ>"".";
	КонецЕсли;

	Диалог = ВыполнитьДиалог(Вопрос);
	Возврат "🤖 " + ТелеграмСервер.ЭкранироватьHTML(Диалог.Текст);

КонецФункции

// Цикл агента: запросы к Claude и выполнение инструментов, пока модель не напишет ответ.
//
// Параметры:
//  Вопрос     - Строка
//  Заготовки  - Массив из Соответствие - ответы API по порядку вместо HTTP (для автотестов).
//
// Возвращаемое значение:
//  Структура:
//   * Текст       - Строка - итоговый ответ или описание ошибки.
//   * Успешно     - Булево
//   * Сообщения   - Массив - вся переписка с API (для отладки и тестов).
//   * Инструменты - Массив из Строка - какие инструменты вызывала модель.
//
Функция ВыполнитьДиалог(Вопрос, Заготовки = Неопределено) Экспорт

	Результат = Новый Структура("Текст, Успешно, Сообщения, Инструменты", "", Ложь, Новый Массив, Новый Массив);
	Результат.Сообщения.Добавить(Сообщение("user", Вопрос));

	Для Шаг = 1 По МаксимумШагов() Цикл

		ТекстОшибки = "";
		Ответ = ?(Заготовки = Неопределено, ВызватьAPI(ТелоЗапроса(Результат.Сообщения), ТекстОшибки), СледующаяЗаготовка(Заготовки, Шаг));
		Если Ответ = Неопределено Тогда
			Результат.Текст = "Не удалось связаться с ИИ: " + ТекстОшибки;
			Возврат Результат;
		КонецЕсли;

		ПричинаОстановки = Ответ["stop_reason"];
		Если ПричинаОстановки = "refusal" Тогда
			Результат.Текст = "На этот вопрос ассистент ответить не может.";
			Возврат Результат;
		КонецЕсли;

		// Ответ модели возвращается в историю целиком, вместе с блоками размышлений:
		// API требует, чтобы история не менялась между запросами.
		Результат.Сообщения.Добавить(Сообщение("assistant", Ответ["content"]));

		Если ПричинаОстановки <> "tool_use" Тогда
			Результат.Текст = ТекстОтвета(Ответ["content"]);
			Результат.Успешно = Истина;
			Если ПричинаОстановки = "max_tokens" Тогда
				Результат.Текст = Результат.Текст + " …(ответ обрезан)";
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;

		// Все вызовы инструментов одного ответа возвращаются одним сообщением user.
		РезультатыИнструментов = Новый Массив;
		Для Каждого Блок Из Ответ["content"] Цикл
			Если Блок["type"] <> "tool_use" Тогда
				Продолжить;
			КонецЕсли;
			Результат.Инструменты.Добавить(Блок["name"]);
			РезультатИнструмента = Новый Соответствие;
			РезультатИнструмента.Вставить("type", "tool_result");
			РезультатИнструмента.Вставить("tool_use_id", Блок["id"]);
			Попытка
				РезультатИнструмента.Вставить("content", ВыполнитьИнструмент(Блок["name"], Блок["input"]));
			Исключение
				РезультатИнструмента.Вставить("content", "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				РезультатИнструмента.Вставить("is_error", Истина);
			КонецПопытки;
			РезультатыИнструментов.Добавить(РезультатИнструмента);
		КонецЦикла;
		Результат.Сообщения.Добавить(Сообщение("user", РезультатыИнструментов));

	КонецЦикла;

	Результат.Текст = СтрШаблон("Ассистент не уложился в %1 шагов, уточните вопрос.", МаксимумШагов());
	Возврат Результат;

КонецФункции

// Выполняет инструмент по запросу модели.
//
// Параметры:
//  Имя       - Строка - имя инструмента из ОписанияИнструментов().
//  Аргументы - Соответствие - аргументы, которые передала модель.
//
// Возвращаемое значение:
//  Строка - результат в JSON.
//
Функция ВыполнитьИнструмент(Имя, Аргументы) Экспорт

	Если Имя = "sales_summary" Тогда
		Данные = СводкаПродаж(ДатаИзISO(Аргументы["date_from"]), ДатаИзISO(Аргументы["date_to"]));
	ИначеЕсли Имя = "stock_search" Тогда
		Данные = ПоискОстатков(Аргументы["query"]);
	ИначеЕсли Имя = "top_products" Тогда
		Данные = ТопТоваров(Аргументы["days"], Аргументы["limit"]);
	ИначеЕсли Имя = "stockout_forecast" Тогда
		Данные = ПрогнозДефицита();
	ИначеЕсли Имя = "accounting_health" Тогда
		Проверка = ДиагностикаСервер.ПроверитьУчет();
		Данные = Новый Структура("ok, errors, warnings", Проверка.Исправно, Проверка.Ошибки, Проверка.Предупреждения);
	Иначе
		ВызватьИсключение "Неизвестный инструмент " + Имя;
	КонецЕсли;

	Возврат ВебAPIСервер.ВJSON(Данные);

КонецФункции

// Тело запроса к Messages API: модель, системная инструкция, инструменты и история.
Функция ТелоЗапроса(Сообщения) Экспорт

	Модель = Модель();
	Тело = Новый Соответствие;
	Тело.Вставить("model", Модель);
	Тело.Вставить("max_tokens", 4000);
	Тело.Вставить("system", СистемнаяИнструкция());
	Тело.Вставить("tools", ОписанияИнструментов());
	Тело.Вставить("messages", Сообщения);
	// Короткие ответы по данным магазина не требуют долгих размышлений: низкое усилие быстрее и дешевле.
	Тело.Вставить("output_config", Новый Структура("effort", "low"));
	Если ПоддерживаетРезервнуюМодель(Модель) Тогда
		// Если модель откажется отвечать, API сам повторит запрос на подходящей модели.
		Тело.Вставить("fallbacks", "default");
	КонецЕсли;
	Возврат Тело;

КонецФункции

// Модель Claude из константы или модель по умолчанию.
Функция Модель() Экспорт
	Модель = СокрЛП(Константы.ClaudeМодель.Получить());
	Возврат ?(ЗначениеЗаполнено(Модель), Модель, "claude-opus-5-5");
КонецФункции

#КонецОбласти

#Область Инструменты

// Описания инструментов для модели: имя, назначение и JSON-схема аргументов.
// strict = true: API гарантирует, что аргументы соответствуют схеме.
Функция ОписанияИнструментов()

	Инструменты = Новый Массив;

	Инструменты.Добавить(Инструмент("sales_summary",
		"Продажи магазина за период: выручка, себестоимость, валовая прибыль, число чеков, средний чек и выручка по способам оплаты. "
		+ "Даты включительно, формат YYYY-MM-DD.",
		Свойства("date_from", "string", "Начало периода, YYYY-MM-DD", "date_to", "string", "Конец периода, YYYY-MM-DD")));

	Инструменты.Добавить(Инструмент("stock_search",
		"Текущие остатки товаров по складам с себестоимостью остатка. Поиск по части названия; пустая строка — все товары (до 40 строк).",
		Свойства("query", "string", "Часть названия товара, например «кофе»")));

	Инструменты.Добавить(Инструмент("top_products",
		"Самые продаваемые товары по выручке за последние N дней: количество, выручка, прибыль.",
		Свойства("days", "integer", "За сколько последних дней, например 7 или 30", "limit", "integer", "Сколько товаров вернуть, до 20")));

	Инструменты.Добавить(Инструмент("stockout_forecast",
		"Прогноз дефицита: какие товары скоро закончатся, на сколько дней хватит остатка и сколько заказать.",
		Новый Соответствие));

	Инструменты.Добавить(Инструмент("accounting_health",
		"Самодиагностика учёта: сходятся ли остатки с партиями, нет ли отрицательных остатков, не застряли ли уведомления.",
		Новый Соответствие));

	Возврат Инструменты;

КонецФункции

Функция СводкаПродаж(Начало, Конец)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПродажиОбороты.СпособОплаты КАК СпособОплаты,
	|	СУММА(ПродажиОбороты.ВыручкаОборот) КАК Выручка,
	|	СУММА(ПродажиОбороты.СебестоимостьОборот) КАК Себестоимость
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&Начало, &Конец, , ) КАК ПродажиОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.СпособОплаты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ПродажаТовара.Ссылка) КАК Чеков
	|ИЗ
	|	Документ.ПродажаТовара КАК ПродажаТовара
	|ГДЕ
	|	ПродажаТовара.Проведен
	|	И ПродажаТовара.Дата МЕЖДУ &Начало И &Конец";

	Пакет = Запрос.ВыполнитьПакет();
	ПоОплате = Пакет[0].Выгрузить();
	Чеки = Пакет[1].Выбрать();
	Чеки.Следующий();

	Выручка = ПоОплате.Итог("Выручка");
	Себестоимость = ПоОплате.Итог("Себестоимость");
	Оплаты = Новый Соответствие;
	Для Каждого СтрокаОплаты Из ПоОплате Цикл
		Оплаты.Вставить(Строка(СтрокаОплаты.СпособОплаты), СтрокаОплаты.Выручка);
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("period", Формат(Начало, "ДФ=dd.MM.yyyy") + " - " + Формат(Конец, "ДФ=dd.MM.yyyy"));
	Данные.Вставить("revenue", Выручка);
	Данные.Вставить("cost", Себестоимость);
	Данные.Вставить("gross_profit", Выручка - Себестоимость);
	Данные.Вставить("receipts", Чеки.Чеков);
	Данные.Вставить("average_receipt", ?(Чеки.Чеков = 0, 0, Окр(Выручка / Чеки.Чеков, 2)));
	Данные.Вставить("by_payment", Оплаты);
	Данные.Вставить("currency", "RUB");
	Возврат Данные;

КонецФункции

Функция ПоискОстатков(Фильтр)

	Фильтр = НРег(СокрЛП(?(Фильтр = Неопределено, "", Фильтр)));
	Элементы = Новый Массив;
	Для Каждого Остаток Из УчетТоваровСервер.ТекущиеОстатки() Цикл
		Если Остаток.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(Фильтр) И СтрНайти(НРег(Строка(Остаток.Товар)), Фильтр) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Элементы.Количество() >= 40 Тогда
			Прервать;
		КонецЕсли;
		Элементы.Добавить(Новый Структура("product, warehouse, qty, cost_value",
			Строка(Остаток.Товар), Строка(Остаток.Склад), Остаток.Количество, Остаток.Стоимость));
	КонецЦикла;
	Возврат Новый Структура("items", Элементы);

КонецФункции

Функция ТопТоваров(Дней, Количество)

	Дней = Мин(Макс(?(ТипЗнч(Дней) = Тип("Число"), Дней, 7), 1), 365);
	Количество = Мин(Макс(?(ТипЗнч(Количество) = Тип("Число"), Количество, 5), 1), 20);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(ТекущаяДатаСеанса()) - (Дней - 1) * 86400);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	ПродажиОбороты.Товар КАК Товар,
	|	ПродажиОбороты.КоличествоОборот КАК Количество,
	|	ПродажиОбороты.ВыручкаОборот КАК Выручка,
	|	ПродажиОбороты.ВыручкаОборот - ПродажиОбороты.СебестоимостьОборот КАК Прибыль
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&Начало, , , ) КАК ПродажиОбороты
	|ГДЕ
	|	ПродажиОбороты.ВыручкаОборот > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Выручка УБЫВ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 20", "ПЕРВЫЕ " + Формат(Количество, "ЧГ=0"));

	Элементы = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элементы.Добавить(Новый Структура("product, qty, revenue, gross_profit",
			Строка(Выборка.Товар), Выборка.Количество, Выборка.Выручка, Выборка.Прибыль));
	КонецЦикла;
	Возврат Новый Структура("days, items", Дней, Элементы);

КонецФункции

Функция ПрогнозДефицита()

	Элементы = Новый Массив;
	Для Каждого СтрокаПрогноза Из ПрогнозЗапасовСервер.Прогноз(ТекущаяДатаСеанса()) Цикл
		Если СтрокаПрогноза.Заказать <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Элементы.Добавить(Новый Структура("product, warehouse, qty, daily_demand, days_left, order_qty",
			Строка(СтрокаПрогноза.Товар), Строка(СтрокаПрогноза.Склад), СтрокаПрогноза.Остаток,
			СтрокаПрогноза.СпросВДень, СтрокаПрогноза.ДнейХватит, СтрокаПрогноза.Заказать));
	КонецЦикла;
	Возврат Новый Структура("order_if_days_left_less_than, items", ПрогнозЗапасовСервер.ДнейДоЗаказа(), Элементы);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВызватьAPI(Тело, ТекстОшибки)

	Запрос = Новый HTTPЗапрос("/v1/messages");
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.Заголовки.Вставить("x-api-key", Константы.ClaudeКлючAPI.Получить());
	Запрос.Заголовки.Вставить("anthropic-version", "2026-10-21");
	Если Тело.Получить("fallbacks") <> Неопределено Тогда
		Запрос.Заголовки.Вставить("anthropic-beta", "server-side-fallback-2026-07-01");
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Тело);
	Запрос.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		Соединение = Новый HTTPСоединение("api.anthropic.com", 443, , , , 120, Новый ЗащищенноеСоединениеOpenSSL);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Claude.Messages", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;

	Если Ответ.КодСостояния <> 200 Тогда
		ТекстОшибки = СтрШаблон("HTTP %1: %2", Ответ.КодСостояния, Лев(ТелоОтвета, 500));
		ЗаписьЖурналаРегистрации("Claude.Messages", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();
	Возврат Результат;

КонецФункции

Функция СледующаяЗаготовка(Заготовки, Шаг)
	Возврат ?(Шаг <= Заготовки.Количество(), Заготовки[Шаг - 1], Неопределено);
КонецФункции

Функция СистемнаяИнструкция()
	Название = Константы.НазваниеМагазина.Получить();
	Возврат СтрШаблон(
		"Ты помощник владельца розничного магазина «%1». Сегодня %2.
		|Отвечай по-русски, коротко и по делу: 2–6 предложений или короткий список.
		|Все цифры бери только из результатов инструментов, ничего не придумывай. Если данных не хватает, так и скажи.
		|Пиши простым текстом без Markdown (ответ уходит в Telegram). Суммы указывай в рублях с разделителями разрядов.",
		?(ЗначениеЗаполнено(Название), Название, "Мини-розница"), Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy, dddd'"));
КонецФункции

Функция Сообщение(Роль, Содержимое)
	Результат = Новый Соответствие;
	Результат.Вставить("role", Роль);
	Результат.Вставить("content", Содержимое);
	Возврат Результат;
КонецФункции

Функция ТекстОтвета(Содержимое)
	Части = Новый Массив;
	Для Каждого Блок Из Содержимое Цикл
		Если Блок["type"] = "text" Тогда
			Части.Добавить(СокрЛП(Блок["text"]));
		КонецЕсли;
	КонецЦикла;
	Текст = СтрСоединить(Части, Символы.ПС);
	Возврат ?(ПустаяСтрока(Текст), "Ассистент не дал ответа.", Текст);
КонецФункции

Функция Инструмент(Имя, Описание, СвойстваСхемы)

	Обязательные = Новый Массив;
	Для Каждого КлючИЗначение Из СвойстваСхемы Цикл
		Обязательные.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Схема = Новый Соответствие;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", СвойстваСхемы);
	Схема.Вставить("required", Обязательные);
	Схема.Вставить("additionalProperties", Ложь);

	Результат = Новый Соответствие;
	Результат.Вставить("name", Имя);
	Результат.Вставить("description", Описание);
	Результат.Вставить("input_schema", Схема);
	Результат.Вставить("strict", Истина);
	Возврат Результат;

КонецФункции

// Свойства JSON-схемы тройками: имя, тип, описание.
Функция Свойства(Имя1, Тип1, Описание1, Имя2 = "", Тип2 = "", Описание2 = "")
	Результат = Новый Соответствие;
	Результат.Вставить(Имя1, Новый Структура("type, description", Тип1, Описание1));
	Если ЗначениеЗаполнено(Имя2) Тогда
		Результат.Вставить(Имя2, Новый Структура("type, description", Тип2, Описание2));
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ДатаИзISO(Значение)
	Попытка
		Возврат Дата(СтрЗаменить(Лев(Значение, 10), "-", ""));
	Исключение
		ВызватьИсключение "Дата должна быть в формате YYYY-MM-DD: " + Значение;
	КонецПопытки;
КонецФункции

Функция ПоддерживаетРезервнуюМодель(Модель)
	Возврат СтрНачинаетсяС(Модель, "claude-opus-5") Или СтрНачинаетсяС(Модель, "claude-fable-5")
		Или Модель = "claude-sonnet-5-5";
КонецФункции

Функция МаксимумШагов()
	Возврат 6;
КонецФункции

#КонецОбласти
