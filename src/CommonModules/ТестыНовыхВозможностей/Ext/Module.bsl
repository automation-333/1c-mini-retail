		// Заголовок в нижнем регистре: HTTP-заголовки регистронезависимы.
		Ключ = Заголовки("x-api-key", "test-key");

		Ответ = ВебAPIСервер.Обработать("stock", Параметры("sku", Артикул), Ключ);
		Самопроверка.ОжидатьРавенство(Ответ.КодСостояния, 200, "Остатки: код ответа");
