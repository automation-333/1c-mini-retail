Процедура APIОтдаётОстаткиИЦеныВJSON() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("API кофе", 333);
	Самопроверка.Поступление(Склад, Товар, 6, 100, Самопроверка.ДатаТеста(750));
