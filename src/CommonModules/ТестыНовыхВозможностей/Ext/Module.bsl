Процедура ПрогнозСчитаетСпросДниИЗаказ() Экспорт

	// За 28 дней продано 28 шт., из них 14 за последние 7 дней:
	// спрос = (28/28 + 14/7) / 2 = 1,5 шт. в день; остаток 7 шт. — хватит на 4,7 дня;
	// заказ = 1,5 × 21 − 7 = 24,5 → 25 шт.
	Расчет = Самопроверка.ДатаТеста(700);
	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Прогноз кофе");
	Самопроверка.Поступление(Склад, Товар, 35, 50, Расчет - 30 * 86400);
	Самопроверка.Продажа(Склад, Товар, 14, 100, Расчет - 20 * 86400);
	Самопроверка.Продажа(Склад, Товар, 14, 100, Расчет - 3 * 86400);

	Прогноз = ПрогнозЗапасовСервер.Прогноз(Расчет, Массив(Товар));
	Самопроверка.ОжидатьРавенство(Прогноз.Количество(), 1, "Одна строка прогноза");
	Строка = Прогноз[0];
	Самопроверка.ОжидатьРавенство(Строка.Остаток, 7, "Остаток");
	Самопроверка.ОжидатьРавенство(Строка.СпросВДень, 1.5, "Взвешенный спрос в день");
	Самопроверка.ОжидатьРавенство(Строка.ДнейХватит, 4.7, "Дней хватит");
	Самопроверка.ОжидатьРавенство(Строка.ДатаИсчерпания, НачалоДня(Расчет) + 4 * 86400, "Дата исчерпания");
	Самопроверка.ОжидатьРавенство(Строка.Заказать, 25, "Рекомендуемый заказ");

КонецПроцедуры

