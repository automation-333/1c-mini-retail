Процедура ЧерновикЗаказаБерётПоставщикаИЦенуПоследнейЗакупки() Экспорт

	Расчет = Самопроверка.ДатаТеста(720);
	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Прогноз какао");
	Поставщик = Справочники.Поставщики.СоздатьЭлемент();
	Поставщик.Наименование = Самопроверка.Уникальный("Тест поставщик");
	Поставщик.Записать();

	Самопроверка.Поступление(Склад, Товар, 20, 40, Расчет - 40 * 86400);
	Поступление = Самопроверка.Поступление(Склад, Товар, 15, 55, Расчет - 30 * 86400).ПолучитьОбъект();
	Поступление.Поставщик = Поставщик.Ссылка;
	Поступление.Записать(РежимЗаписиДокумента.Проведение);
	Самопроверка.Продажа(Склад, Товар, 14, 100, Расчет - 20 * 86400);
	Самопроверка.Продажа(Склад, Товар, 14, 100, Расчет - 3 * 86400);

	Черновики = ПрогнозЗапасовСервер.СоздатьЧерновикиЗаказов(Расчет, Массив(Товар));
	Попытка
		Самопроверка.ОжидатьРавенство(Черновики.Количество(), 1, "Один черновик на склад и поставщика");
		Черновик = Черновики[0].ПолучитьОбъект();
		Самопроверка.Ожидать(Не Черновик.Проведен, "черновик не проведён");
		Самопроверка.ОжидатьРавенство(Черновик.Поставщик, Поставщик.Ссылка, "Поставщик последней закупки");
		Самопроверка.ОжидатьРавенство(Черновик.Склад, Склад, "Склад");
		Самопроверка.ОжидатьРавенство(Черновик.Товары[0].Цена, 55, "Цена последней закупки");
		// Остаток 35 − 28 = 7, спрос 1,5 в день → заказ 25 шт.
		Самопроверка.ОжидатьРавенство(Черновик.Товары[0].Количество, 25, "Количество по прогнозу");
		Самопроверка.ОжидатьРавенство(Черновик.СуммаДокумента, 25 * 55, "Сумма черновика");
	Исключение
		УдалитьДокументы(Черновики);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьДокументы(Черновики);

КонецПроцедуры

Процедура ДиагностикаНаходитРасхождениеРегистров() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Диагностика");
	Самопроверка.Поступление(Склад, Товар, 10, 30, Самопроверка.ДатаТеста(730));
	Самопроверка.Продажа(Склад, Товар, 4, 60, Самопроверка.ДатаТеста(731));

	Проверка = ДиагностикаСервер.ПроверитьУчет(Массив(Товар));
	Самопроверка.Ожидать(Проверка.Исправно, "после обычных документов учёт исправен: " + СтрСоединить(Проверка.Ошибки, "; "));

	// Портим учёт: движение только в регистре остатков, мимо партий (как при ошибке в проведении).
	Регистратор = Документы.ПоступлениеТовара.СоздатьДокумент();
	Регистратор.Дата = Самопроверка.ДатаТеста(732);
	Регистратор.Склад = Склад;
	Регистратор.Записать(РежимЗаписиДокумента.Запись);
	Набор = РегистрыНакопления.ОстаткиТоваров.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор.Ссылка);
	Движение = Набор.ДобавитьПриход();
	Движение.Период = Регистратор.Дата;
	Движение.Склад = Склад;
	Движение.Товар = Товар;
	Движение.Количество = 5;
	Набор.Записать();

	Попытка
		Проверка = ДиагностикаСервер.ПроверитьУчет(Массив(Товар));
		Самопроверка.Ожидать(Не Проверка.Исправно, "расхождение обнаружено");
		Самопроверка.ОжидатьВхождение(Проверка.Ошибки[0], "остаток 11, в партиях 6", "Описание расхождения");
	Исключение
		Набор.Очистить();
		Набор.Записать();
		Регистратор.Удалить();
		ВызватьИсключение;
	КонецПопытки;
	Набор.Очистить();
	Набор.Записать();
	Регистратор.Удалить();

КонецПроцедуры

Процедура ПродажаНижеСебестоимостиСтавитТревогу() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Уценка");
	Самопроверка.Поступление(Склад, Товар, 3, 100, Самопроверка.ДатаТеста(740));

	ПрежнийТокен = Константы.ТелеграмТокенБота.Получить();
	ПрежнийЧат = Константы.ТелеграмЧатИД.Получить();
	Если Не ТелеграмСервер.Настроен() Тогда
		Константы.ТелеграмТокенБота.Установить("TEST-TOKEN");
		Константы.ТелеграмЧатИД.Установить("1");
	КонецЕсли;

	Продажа = Неопределено;
	Попытка
		До = ТелеграмСервер.РазмерОчереди();
		Продажа = Самопроверка.Продажа(Склад, Товар, 1, 60, Самопроверка.ДатаТеста(741), , Истина);
		Самопроверка.ОжидатьРавенство(ТелеграмСервер.РазмерОчереди(), До + 2, "В очереди уведомление о продаже и тревога");

		Тревога = ТекстИзОчереди("Тревога " + СокрЛП(Продажа.Номер));
		Самопроверка.ОжидатьВхождение(Тревога, "ниже себестоимости: 60,00 ₽ при себестоимости 100,00 ₽", "Текст тревоги");

		// Обычная продажа с наценкой тревогу не ставит.
		Объект = Продажа.ПолучитьОбъект();
		Объект.Товары[0].Цена = 150;
		Самопроверка.ОжидатьРавенство(ДиагностикаСервер.ТекстТревогиПоПродаже(Объект, Новый Соответствие), "", "Без тревоги");
	Исключение
		ОчиститьОчередьПродажи(Продажа);
		Константы.ТелеграмТокенБота.Установить(ПрежнийТокен);
		Константы.ТелеграмЧатИД.Установить(ПрежнийЧат);
		ВызватьИсключение;
	КонецПопытки;
	ОчиститьОчередьПродажи(Продажа);
	Константы.ТелеграмТокенБота.Установить(ПрежнийТокен);
	Константы.ТелеграмЧатИД.Установить(ПрежнийЧат);

КонецПроцедуры

Процедура APIБезКлючаЗакрыто() Экспорт

	ПрежнийКлюч = Константы.ВебAPIКлюч.Получить();
	Попытка
		Константы.ВебAPIКлюч.Установить("");
		Ответ = ВебAPIСервер.Обработать("stock", Новый Соответствие, Новый Соответствие);
		Самопроверка.ОжидатьРавенство(Ответ.КодСостояния, 503, "Без настроенного ключа API закрыт");

		Константы.ВебAPIКлюч.Установить("test-key");
		Ответ = ВебAPIСервер.Обработать("stock", Новый Соответствие, Заголовки("X-API-Key", "wrong"));
		Самопроверка.ОжидатьРавенство(Ответ.КодСостояния, 401, "Неверный ключ");

		Ответ = ВебAPIСервер.Обработать("health", Новый Соответствие, Новый Соответствие);
		Самопроверка.ОжидатьРавенство(Ответ.КодСостояния, 200, "Проверка здоровья доступна без ключа");
		Самопроверка.Ожидать(ИзJSON(Ответ.Тело)["status"] <> Неопределено, "в ответе health есть status");

		Ответ = ВебAPIСервер.Обработать("unknown", Новый Соответствие, Заголовки("X-API-Key", "test-key"));
		Самопроверка.ОжидатьРавенство(Ответ.КодСостояния, 404, "Неизвестный метод");
	Исключение
		Константы.ВебAPIКлюч.Установить(ПрежнийКлюч);
		ВызватьИсключение;
	КонецПопытки;
	Константы.ВебAPIКлюч.Установить(ПрежнийКлюч);

