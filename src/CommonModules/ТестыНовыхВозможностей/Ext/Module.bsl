		Самопроверка.ОжидатьРавенство(Элементы[0]["warehouse"], Строка(Склад), "Остатки: склад");

		Ответ = ВебAPIСервер.Обработать("prices", Параметры("sku", Артикул), Ключ);
		Элементы = ИзJSON(Ответ.Тело)["items"];
		Самопроверка.ОжидатьРавенство(Элементы[0]["price"], 333, "Цена: базовая из карточки");
		Самопроверка.ОжидатьРавенство(Элементы[0]["name"], Строка(Товар), "Цена: наименование");
	Исключение
		Константы.ВебAPIКлюч.Установить(ПрежнийКлюч);
		ВызватьИсключение;
	КонецПопытки;
	Константы.ВебAPIКлюч.Установить(ПрежнийКлюч);

КонецПроцедуры

Процедура ИИАгентВызываетИнструментИОтвечает() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("ИИ эспрессо");
	Самопроверка.Поступление(Склад, Товар, 5, 100, Самопроверка.ДатаТеста(760));

	// Ответы API в том виде, в каком их присылает Claude: сначала вызов инструмента, потом текст.
	Заготовки = Новый Массив;
	Заготовки.Добавить(ИзJSON(
		"{""id"":""msg_1"",""type"":""message"",""role"":""assistant"",""stop_reason"":""tool_use"",""content"":["
		+ "{""type"":""text"",""text"":""Смотрю остатки.""},"
		+ "{""type"":""tool_use"",""id"":""toolu_01"",""name"":""stock_search"",""input"":{""query"":""" + Строка(Товар) + """}}]}"));
	Заготовки.Добавить(ИзJSON(
		"{""id"":""msg_2"",""type"":""message"",""role"":""assistant"",""stop_reason"":""end_turn"",""content"":["
		+ "{""type"":""text"",""text"":""Осталось 5 шт. <на складе>""}]}"));

	Диалог = ИИАссистентСервер.ВыполнитьДиалог("Сколько осталось эспрессо?", Заготовки);

	Самопроверка.Ожидать(Диалог.Успешно, "диалог завершён: " + Диалог.Текст);
	Самопроверка.ОжидатьРавенство(Диалог.Текст, "Осталось 5 шт. <на складе>", "Ответ модели");
	Самопроверка.ОжидатьРавенство(СтрСоединить(Диалог.Инструменты, ","), "stock_search", "Вызванные инструменты");
	Самопроверка.ОжидатьРавенство(Диалог.Сообщения.Количество(), 4, "Вопрос, вызов, результат инструмента, ответ");

	// Результат инструмента ушёл модели сообщением user с tool_result и данными из базы.
	РезультатИнструмента = Диалог.Сообщения[2]["content"][0];
	Самопроверка.ОжидатьРавенство(Диалог.Сообщения[2]["role"], "user", "Роль сообщения с результатом");
	Самопроверка.ОжидатьРавенство(РезультатИнструмента["type"], "tool_result", "Тип блока");
	Самопроверка.ОжидатьРавенство(РезультатИнструмента["tool_use_id"], "toolu_01", "Ссылка на вызов");
	Данные = ИзJSON(РезультатИнструмента["content"]);
	Самопроверка.ОжидатьРавенство(Данные["items"][0]["qty"], 5, "Остаток из базы в результате инструмента");

	// Ответ для Telegram экранирует HTML.
	Самопроверка.ОжидатьВхождение(ТелеграмСервер.ЭкранироватьHTML(Диалог.Текст), "&lt;на складе&gt;", "Экранирование");

КонецПроцедуры

Процедура ИИАгентПереживаетОшибкуИнструмента() Экспорт

	Заготовки = Новый Массив;
	Заготовки.Добавить(ИзJSON(
		"{""stop_reason"":""tool_use"",""content"":["
		+ "{""type"":""tool_use"",""id"":""toolu_bad"",""name"":""drop_database"",""input"":{}},"
		+ "{""type"":""tool_use"",""id"":""toolu_date"",""name"":""sales_summary"",""input"":{""date_from"":""вчера"",""date_to"":""2025-01-01""}}]}"));
	Заготовки.Добавить(ИзJSON(
		"{""stop_reason"":""end_turn"",""content"":[{""type"":""text"",""text"":""Не получилось.""}]}"));

	Диалог = ИИАссистентСервер.ВыполнитьДиалог("Удали базу", Заготовки);

	Самопроверка.Ожидать(Диалог.Успешно, "агент не упал из-за ошибок инструментов");
	Результаты = Диалог.Сообщения[2]["content"];
	Самопроверка.ОжидатьРавенство(Результаты.Количество(), 2, "Оба вызова получили ответ одним сообщением");
	Самопроверка.ОжидатьРавенство(Результаты[0]["is_error"], Истина, "Неизвестный инструмент — ошибка для модели");
	Самопроверка.ОжидатьВхождение(Результаты[0]["content"], "Неизвестный инструмент", "Текст ошибки");
	Самопроверка.ОжидатьРавенство(Результаты[1]["is_error"], Истина, "Неверная дата — ошибка для модели");
	Самопроверка.ОжидатьВхождение(Результаты[1]["content"], "YYYY-MM-DD", "Подсказка формата даты");

КонецПроцедуры

Процедура ИИИнструментСводкиПродажСчитаетПериод() Экспорт

	День = Самопроверка.УникальнаяДатаТеста();
	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("ИИ сводка");
	Самопроверка.Поступление(Склад, Товар, 5, 100, День - 86400);
	Самопроверка.Продажа(Склад, Товар, 2, 300, День);

	Аргументы = Новый Соответствие;
	Аргументы.Вставить("date_from", Формат(День, "ДФ=yyyy-MM-dd"));
	Аргументы.Вставить("date_to", Формат(День, "ДФ=yyyy-MM-dd"));
	Данные = ИзJSON(ИИАссистентСервер.ВыполнитьИнструмент("sales_summary", Аргументы));

	Самопроверка.ОжидатьРавенство(Данные["revenue"], 600, "Выручка");
	Самопроверка.ОжидатьРавенство(Данные["cost"], 200, "Себестоимость");
	Самопроверка.ОжидатьРавенство(Данные["gross_profit"], 400, "Валовая прибыль");
	Самопроверка.ОжидатьРавенство(Данные["receipts"], 1, "Чеков");

КонецПроцедуры

Процедура ИИЗапросСодержитСтрогиеСхемыИнструментов() Экспорт

	Тело = ИИАссистентСервер.ТелоЗапроса(Новый Массив);
	Самопроверка.ОжидатьРавенство(Тело["model"], ИИАссистентСервер.Модель(), "Модель");
	Самопроверка.Ожидать(Тело["max_tokens"] > 0, "задан max_tokens");
	Самопроверка.ОжидатьРавенство(Тело["tools"].Количество(), 5, "Пять инструментов");

	Для Каждого Инструмент Из Тело["tools"] Цикл
		Схема = Инструмент["input_schema"];
		Самопроверка.ОжидатьРавенство(Инструмент["strict"], Истина, "strict у " + Инструмент["name"]);
		Самопроверка.ОжидатьРавенство(Схема["additionalProperties"], Ложь, "additionalProperties у " + Инструмент["name"]);
		Самопроверка.ОжидатьРавенство(Схема["required"].Количество(), Схема["properties"].Количество(),
			"Все свойства обязательны у " + Инструмент["name"]);
	КонецЦикла;

	// Тело сериализуется в JSON и читается обратно.
	Самопроверка.ОжидатьРавенство(ИзJSON(ВебAPIСервер.ВJSON(Тело))["tools"][3]["name"], "stockout_forecast", "JSON запроса");

КонецПроцедуры

Процедура БотОтвечаетНаНовыеКоманды() Экспорт

	Самопроверка.ОжидатьВхождение(ТелеграмБот.ОтветНаКоманду("/prognoz"), "Прогноз дефицита", "Команда /prognoz");
	Самопроверка.ОжидатьВхождение(ТелеграмБот.ОтветНаКоманду("/health"), "Остатки сходятся с партиями", "Команда /health");
	Самопроверка.ОжидатьВхождение(ТелеграмБот.ОтветНаКоманду("/ask"), "Напишите вопрос", "Команда /ask без вопроса");
	Самопроверка.ОжидатьВхождение(ТелеграмБот.ОтветНаКоманду("/help"), "/prognoz", "Справка знает новые команды");

КонецПроцедуры

Процедура ИИРеальныйЗапросКClaude() Экспорт

	Если Не ИИАссистентСервер.Настроен() Тогда
		Самопроверка.Пропустить("Claude API не настроен: задайте ключ параметром claude=<ключ> при запуске автотестов");
	КонецЕсли;

	Диалог = ИИАссистентСервер.ВыполнитьДиалог("Проверь, всё ли в порядке с учётом. Ответь одним предложением.");
	Самопроверка.Ожидать(Диалог.Успешно, "Claude ответил: " + Диалог.Текст);
	Самопроверка.Ожидать(Диалог.Инструменты.Найти("accounting_health") <> Неопределено,
		"модель сама вызвала инструмент проверки учёта, вызваны: " + СтрСоединить(Диалог.Инструменты, ","));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Массив(Значение)
	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

Функция ИзJSON(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция Заголовки(Имя, Значение)
	Результат = Новый Соответствие;
	Результат.Вставить(Имя, Значение);
	Возврат Результат;
КонецФункции

Функция Параметры(Имя, Значение)
	Возврат Заголовки(Имя, Значение);
КонецФункции

Процедура УдалитьДокументы(Ссылки)
	Для Каждого Ссылка Из Ссылки Цикл
		Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;
КонецПроцедуры

Функция ТекстИзОчереди(Источник)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Текст КАК Текст
	|ИЗ
	|	РегистрСведений.ОчередьУведомлений КАК Очередь
	|ГДЕ
	|	Очередь.Источник = &Источник";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Текст, "");
КонецФункции

Процедура ОчиститьОчередьПродажи(Продажа)
	Если Продажа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Номер = СокрЛП(Продажа.Номер);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Источники", СтрРазделить("Продажа " + Номер + "|Тревога " + Номер, "|"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ОчередьУведомлений КАК Очередь
	|ГДЕ
	|	Очередь.Источник В (&Источники)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.ОчередьУведомлений.СоздатьМенеджерЗаписи();
		Запись.Идентификатор = Выборка.Идентификатор;
		Запись.Удалить();
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
