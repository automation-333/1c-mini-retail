// Тесты складского учёта: остатки, партии FIFO, возвраты, перемещения, инвентаризация, дата запрета.
// Каждый тест работает на своём складе и своих товарах, поэтому тесты не зависят друг от друга.

#Область СписокТестов

Функция СписокТестов() Экспорт
	Тесты = Новый Массив;
	Тесты.Добавить("ПоступлениеУвеличиваетОстатокИСтоимостьПартий");
	Тесты.Добавить("ПродажаСписываетПартииПоFIFO");
	Тесты.Добавить("ПродажаСверхОстаткаНеПроводится");
	Тесты.Добавить("ПерепроведениеПродажиНеЗадваиваетДвижения");
	Тесты.Добавить("СкидкаКлиентаУменьшаетСуммуИВыручку");
	Тесты.Добавить("ВозвратВосстанавливаетОстатокПоСебестоимостиПродажи");
	Тесты.Добавить("ВозвратБольшеПроданногоНеПроводится");
	Тесты.Добавить("ПеремещениеПереноситПартииССебестоимостью");
	Тесты.Добавить("ИнвентаризацияОтражаетИзлишкиИНедостачи");
	Тесты.Добавить("ОтменаПоступленияПроданногоТовараЗапрещена");
	Тесты.Добавить("ДатаЗапретаБлокируетЗакрытыйПериод");
	Возврат Тесты;
КонецФункции

#КонецОбласти

#Область Тесты

Процедура ПоступлениеУвеличиваетОстатокИСтоимостьПартий() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Кофе");

	Самопроверка.Поступление(Склад, Товар, 5, 60, Самопроверка.ДатаТеста(1));

	Самопроверка.ОжидатьРавенство(Самопроверка.ОстатокТовара(Склад, Товар), 5, "Остаток после поступления");
	Самопроверка.ОжидатьРавенство(Самопроверка.СтоимостьПартий(Склад, Товар), 300, "Стоимость партий");

КонецПроцедуры

Процедура ПродажаСписываетПартииПоFIFO() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Кофе");
	Самопроверка.Поступление(Склад, Товар, 5, 100, Самопроверка.ДатаТеста(1));
	Самопроверка.Поступление(Склад, Товар, 5, 150, Самопроверка.ДатаТеста(2));

	Самопроверка.Продажа(Склад, Товар, 7, 200, Самопроверка.ДатаТеста(3));

	Обороты = Самопроверка.ОборотыПродаж(Товар);
	Самопроверка.ОжидатьРавенство(Обороты.Себестоимость, 800, "Себестоимость по FIFO: 5 × 100 + 2 × 150");
	Самопроверка.ОжидатьРавенство(Обороты.Выручка, 1400, "Выручка");
	Самопроверка.ОжидатьРавенство(Самопроверка.ОстатокТовара(Склад, Товар), 3, "Остаток");
	Самопроверка.ОжидатьРавенство(Самопроверка.СтоимостьПартий(Склад, Товар), 450, "Остались только поздние партии: 3 × 150");

КонецПроцедуры

Процедура ПродажаСверхОстаткаНеПроводится() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Чай");
	Самопроверка.Поступление(Склад, Товар, 2, 50, Самопроверка.ДатаТеста(1));

	Провелась = Истина;
	Попытка
		Самопроверка.Продажа(Склад, Товар, 3, 100, Самопроверка.ДатаТеста(2));
	Исключение
		Провелась = Ложь;
	КонецПопытки;

	Самопроверка.Ожидать(Не Провелась, "продажа 3 шт. при остатке 2 шт. не должна проводиться");
	Самопроверка.ОжидатьРавенство(Самопроверка.ОстатокТовара(Склад, Товар), 2, "Остаток не изменился");

КонецПроцедуры

Процедура ПерепроведениеПродажиНеЗадваиваетДвижения() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Кофе");
	Самопроверка.Поступление(Склад, Товар, 10, 100, Самопроверка.ДатаТеста(1));
	Продажа = Самопроверка.Продажа(Склад, Товар, 4, 200, Самопроверка.ДатаТеста(2));

	Объект = Продажа.ПолучитьОбъект();
	Объект.ДополнительныеСвойства.Вставить("НеОтправлятьУведомления", Истина);
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	Объект.Записать(РежимЗаписиДокумента.Проведение);

	Самопроверка.ОжидатьРавенство(Самопроверка.ОстатокТовара(Склад, Товар), 6, "Остаток после двух перепроведений");
	Самопроверка.ОжидатьРавенство(Самопроверка.ОборотыПродаж(Товар).Себестоимость, 400, "Себестоимость не задвоилась");
	Самопроверка.ОжидатьРавенство(Самопроверка.СтоимостьПартий(Склад, Товар), 600, "Партии не задвоились");

КонецПроцедуры

Процедура СкидкаКлиентаУменьшаетСуммуИВыручку() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Кружка");
	Клиент = Самопроверка.НовыйКлиент(10);
	Самопроверка.Поступление(Склад, Товар, 5, 80, Самопроверка.ДатаТеста(1));

	Продажа = Самопроверка.Продажа(Склад, Товар, 2, 150, Самопроверка.ДатаТеста(2), Клиент);

	Самопроверка.ОжидатьРавенство(Продажа.СуммаДокумента, 270, "Сумма со скидкой 10%: 2 × 150 × 0,9");
	Самопроверка.ОжидатьРавенство(Самопроверка.ОборотыПродаж(Товар).Выручка, 270, "Выручка учитывает скидку");

КонецПроцедуры

Процедура ВозвратВосстанавливаетОстатокПоСебестоимостиПродажи() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Кофе");
	Самопроверка.Поступление(Склад, Товар, 5, 100, Самопроверка.ДатаТеста(1));
	Самопроверка.Поступление(Склад, Товар, 5, 150, Самопроверка.ДатаТеста(2));
	Продажа = Самопроверка.Продажа(Склад, Товар, 7, 200, Самопроверка.ДатаТеста(3));

	ДокументВозврата = Документы.ВозвратОтПокупателя.СоздатьДокумент();
	ДокументВозврата.Дата = Самопроверка.ДатаТеста(4);
	ДокументВозврата.Заполнить(Продажа);
	Самопроверка.ОжидатьРавенство(ДокументВозврата.Товары.Количество(), 1, "Возврат заполнился по продаже");
	Самопроверка.ОжидатьРавенство(ДокументВозврата.Товары[0].Количество, 7, "К возврату доступно всё проданное");
	ДокументВозврата.Товары[0].Количество = 2;
	ДокументВозврата.Записать(РежимЗаписиДокумента.Проведение);

	Обороты = Самопроверка.ОборотыПродаж(Товар);
	Самопроверка.ОжидатьРавенство(Самопроверка.ОстатокТовара(Склад, Товар), 5, "Остаток после возврата: 3 + 2");
	Самопроверка.ОжидатьРавенство(Обороты.Количество, 5, "Продано за вычетом возврата");
	Самопроверка.ОжидатьРавенство(Обороты.Выручка, 1000, "Выручка за вычетом возврата");
	Самопроверка.ОжидатьРавенство(Обороты.Себестоимость, 571.43, "Себестоимость: 800 − 2 × 800 / 7");
	Самопроверка.ОжидатьРавенство(Самопроверка.СтоимостьПартий(Склад, Товар), 678.57, "Партия возврата по себестоимости продажи");

КонецПроцедуры

Процедура ВозвратБольшеПроданногоНеПроводится() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Чай");
	Самопроверка.Поступление(Склад, Товар, 5, 100, Самопроверка.ДатаТеста(1));
	Продажа = Самопроверка.Продажа(Склад, Товар, 3, 200, Самопроверка.ДатаТеста(2));

	ДокументВозврата = Документы.ВозвратОтПокупателя.СоздатьДокумент();
	ДокументВозврата.Дата = Самопроверка.ДатаТеста(3);
	ДокументВозврата.Заполнить(Продажа);
	ДокументВозврата.Товары[0].Количество = 4;

	Провелся = Истина;
	Попытка
		ДокументВозврата.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Провелся = Ложь;
	КонецПопытки;

	Самопроверка.Ожидать(Не Провелся, "возврат 4 шт. при продаже 3 шт. не должен проводиться");

КонецПроцедуры

Процедура ПеремещениеПереноситПартииССебестоимостью() Экспорт

	Склад1 = Самопроверка.НовыйСклад();
	Склад2 = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Пуэр");
	Самопроверка.Поступление(Склад1, Товар, 4, 100, Самопроверка.ДатаТеста(1));
	Самопроверка.Поступление(Склад1, Товар, 4, 200, Самопроверка.ДатаТеста(2));

	Перемещение = Документы.ПеремещениеТоваров.СоздатьДокумент();
	Перемещение.Дата = Самопроверка.ДатаТеста(3);
	Перемещение.СкладОтправитель = Склад1;
	Перемещение.СкладПолучатель = Склад2;
	Строка = Перемещение.Товары.Добавить();
	Строка.Товар = Товар;
	Строка.Количество = 5;
	Перемещение.Записать(РежимЗаписиДокумента.Проведение);

	Самопроверка.ОжидатьРавенство(Самопроверка.ОстатокТовара(Склад1, Товар), 3, "Остаток отправителя");
	Самопроверка.ОжидатьРавенство(Самопроверка.ОстатокТовара(Склад2, Товар), 5, "Остаток получателя");
	Самопроверка.ОжидатьРавенство(Самопроверка.СтоимостьПартий(Склад2, Товар), 600, "На получатель ушло 4 × 100 + 1 × 200");
	Самопроверка.ОжидатьРавенство(Самопроверка.СтоимостьПартий(Склад1, Товар), 600, "У отправителя осталось 3 × 200");

	// Партии сохранили даты: на получателе первыми уйдут дешёвые.
	Самопроверка.Продажа(Склад2, Товар, 2, 300, Самопроверка.ДатаТеста(4));
	Самопроверка.ОжидатьРавенство(Самопроверка.ОборотыПродаж(Товар).Себестоимость, 200, "FIFO на складе-получателе: 2 × 100");

КонецПроцедуры

Процедура ИнвентаризацияОтражаетИзлишкиИНедостачи() Экспорт

	Склад = Самопроверка.НовыйСклад();
	ТоварА = Самопроверка.НовыйТовар("Печенье");
	ТоварБ = Самопроверка.НовыйТовар("Вафли");
	Самопроверка.Поступление(Склад, ТоварА, 5, 100, Самопроверка.ДатаТеста(1));
	Самопроверка.Поступление(Склад, ТоварБ, 5, 50, Самопроверка.ДатаТеста(1));

	Инвентаризация = Документы.ИнвентаризацияТоваров.СоздатьДокумент();
	Инвентаризация.Дата = Самопроверка.ДатаТеста(2);
	Инвентаризация.Склад = Склад;
	Инвентаризация.ЗаполнитьПоОстаткам();
	Самопроверка.ОжидатьРавенство(Инвентаризация.Товары.Количество(), 2, "Заполнено по остаткам");

	Для Каждого СтрокаТовары Из Инвентаризация.Товары Цикл
		Если СтрокаТовары.Товар = ТоварА Тогда
			СтрокаТовары.КоличествоФакт = 4;
		Иначе
			СтрокаТовары.КоличествоФакт = 7;
			СтрокаТовары.Цена = 80;
		КонецЕсли;
	КонецЦикла;
	Инвентаризация.Записать(РежимЗаписиДокумента.Проведение);

	Самопроверка.ОжидатьРавенство(Самопроверка.ОстатокТовара(Склад, ТоварА), 4, "Недостача 1 шт.");
	Самопроверка.ОжидатьРавенство(Самопроверка.СтоимостьПартий(Склад, ТоварА), 400, "Недостача списана по себестоимости");
	Самопроверка.ОжидатьРавенство(Самопроверка.ОстатокТовара(Склад, ТоварБ), 7, "Излишек 2 шт.");
	Самопроверка.ОжидатьРавенство(Самопроверка.СтоимостьПартий(Склад, ТоварБ), 410, "Излишек оприходован по цене оценки: 250 + 2 × 80");

КонецПроцедуры

Процедура ОтменаПоступленияПроданногоТовараЗапрещена() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Кофе");
	Поступление = Самопроверка.Поступление(Склад, Товар, 3, 100, Самопроверка.ДатаТеста(1));
	Самопроверка.Продажа(Склад, Товар, 2, 200, Самопроверка.ДатаТеста(2));

	Отменилось = Истина;
	Попытка
		Поступление.ПолучитьОбъект().Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Исключение
		Отменилось = Ложь;
	КонецПопытки;

	Самопроверка.Ожидать(Не Отменилось, "нельзя отменить поступление уже проданного товара");
	Самопроверка.ОжидатьРавенство(Самопроверка.ОстатокТовара(Склад, Товар), 1, "Остаток не изменился");

КонецПроцедуры

Процедура ДатаЗапретаБлокируетЗакрытыйПериод() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Кофе");
	ПрежняяДата = Константы.ДатаЗапретаИзменения.Получить();
	Константы.ДатаЗапретаИзменения.Установить(Самопроверка.ДатаТеста(5));

	Попытка
		Записалось = Истина;
		Попытка
			Самопроверка.Поступление(Склад, Товар, 1, 100, Самопроверка.ДатаТеста(2));
		Исключение
			Записалось = Ложь;
		КонецПопытки;
		Самопроверка.Ожидать(Не Записалось, "документ в закрытом периоде не должен записываться");

		Самопроверка.Поступление(Склад, Товар, 1, 100, Самопроверка.ДатаТеста(6));
		Самопроверка.ОжидатьРавенство(Самопроверка.ОстатокТовара(Склад, Товар), 1, "В открытом периоде документ проводится");
	Исключение
		Константы.ДатаЗапретаИзменения.Установить(ПрежняяДата);
		ВызватьИсключение;
	КонецПопытки;

	Константы.ДатаЗапретаИзменения.Установить(ПрежняяДата);

КонецПроцедуры

#КонецОбласти
