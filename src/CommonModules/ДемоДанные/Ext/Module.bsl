// Товары каталога с группой и ценой.
Функция ТоварыКаталога()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК Товар,
	|	Товары.Родитель.Наименование КАК Группа,
	|	Товары.Цена КАК Цена
	|ИЗ
	|	Справочник.Товары КАК Товары
	|ГДЕ
	|	НЕ Товары.ЭтоГруппа
	|	И НЕ Товары.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.Артикул";
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция СоздатьКлиентов()
	Данные = СтрРазделить("Анна Петрова|Иван Соколов|Мария Кузнецова|Дмитрий Орлов|Елена Волкова|Сергей Морозов|Ольга Лебедева|Павел Новиков|Наталья Зайцева|Алексей Фёдоров|Татьяна Белова|Кофейня «Утро» (опт)", "|");
	Клиенты = Новый Массив;
	Для Индекс = 0 По Данные.ВГраница() Цикл
		Скидка = ?(Индекс = Данные.ВГраница(), 15, ?(Индекс % 4 = 0, 5, ?(Индекс % 5 = 0, 10, 0)));
		Реквизиты = Новый Структура("Телефон, ДисконтнаяКарта, ПроцентСкидки",
			СтрШаблон("+7 9%1 %2-%3-%4", 10 + Индекс, 100 + Индекс * 7, 10 + Индекс, 20 + Индекс),
			?(Скидка > 0, "DK-" + Формат(1000 + Индекс, "ЧГ=0"), ""), Скидка);
		Клиенты.Добавить(НовыйЭлемент("Клиенты", Данные[Индекс], Реквизиты));
	КонецЦикла;
	Возврат Клиенты;
КонецФункции

Функция НовыйЭлемент(ИмяСправочника, Наименование, Реквизиты)
	Элемент = Справочники[ИмяСправочника].СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	ЗаполнитьЗначенияСвойств(Элемент, Реквизиты);
	Элемент.Записать();
	Возврат Элемент.Ссылка;
КонецФункции

Процедура ПовыситьЦены(Товары, Группа, Процент, Дата)
	Документ = Документы.УстановкаЦенТоваров.СоздатьДокумент();
	Документ.Дата = Дата;
	Документ.Комментарий = СтрШаблон("Повышение цен на %1 на %2%%", НРег(Группа), Процент);
	Для Каждого Позиция Из Товары Цикл
		Если Позиция.Группа = Группа Тогда
			СтрокаЦены = Документ.Товары.Добавить();
			СтрокаЦены.Товар = Позиция.Товар;
			СтрокаЦены.Цена = Окр(Позиция.Цена * (100 + Процент) / 100, -1);
		КонецЕсли;
	КонецЦикла;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура ЗакупитьТовары(Товары, Склад, Поставщики, Дата, Генератор)
	Для Каждого Поставщик Из Поставщики Цикл
		Документ = Документы.ПоступлениеТовара.СоздатьДокумент();
		Документ.Дата = Дата;
		Документ.Склад = Склад;
		Документ.Поставщик = Поставщик;
		Документ.НомерВходящегоДокумента = "УПД-" + Формат(Генератор.СлучайноеЧисло(1000, 9999), "ЧГ=0");
		Для Каждого Позиция Из Товары Цикл
			Если Не ПоставщикТовара(Позиция.Группа, Поставщики, Поставщик) Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТовары = Документ.Товары.Добавить();
			СтрокаТовары.Товар = Позиция.Товар;
			СтрокаТовары.Количество = ?(Позиция.Цена > 1000, Генератор.СлучайноеЧисло(3, 6), Генератор.СлучайноеЧисло(9, 16));
			// Закупочная цена 50–65% от розничной, немного плавает от поставки к поставке.
			СтрокаТовары.Цена = Окр(Позиция.Цена * Генератор.СлучайноеЧисло(50, 65) / 100, 0);
		КонецЦикла;
		Если Документ.Товары.Количество() > 0 Тогда
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПоставщикТовара(Группа, Поставщики, Поставщик)
	Если Группа = "Кофе" Или Группа = "Посуда" Или Группа = "Аксессуары" Тогда
		Возврат Поставщик = Поставщики[0];
	ИначеЕсли Группа = "Чай" Тогда
		Возврат Поставщик = Поставщики[1];
	КонецЕсли;
	Возврат Поставщик = Поставщики[2];
КонецФункции

Процедура ПереместитьТовары(Товары, Откуда, Куда, Дата, Генератор)
	Документ = Документы.ПеремещениеТоваров.СоздатьДокумент();
	Документ.Дата = Дата;
	Документ.СкладОтправитель = Откуда;
	Документ.СкладПолучатель = Куда;
	Документ.Комментарий = "Пополнение склада";
	Для Каждого Позиция Из Товары Цикл
		Если Генератор.СлучайноеЧисло(1, 2) = 1 Тогда
			СтрокаТовары = Документ.Товары.Добавить();
			СтрокаТовары.Товар = Позиция.Товар;
			СтрокаТовары.Количество = ?(Позиция.Цена > 1000, 1, Генератор.СлучайноеЧисло(3, 6));
		КонецЕсли;
	КонецЦикла;
	Если Документ.Товары.Количество() > 0 Тогда
		Попытка
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			// Не хватило товара: перемещение пропускаем, как сделал бы кладовщик.
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Функция ПродатьТовары(Товары, Склад, Клиент, Дата, Генератор)

	Документ = Документы.ПродажаТовара.СоздатьДокумент();
	Документ.Заполнить(Неопределено);
	Документ.Дата = Дата;
	Документ.Склад = Склад;
	Документ.СпособОплаты = ?(Генератор.СлучайноеЧисло(1, 10) <= 6, Перечисления.СпособыОплаты.БанковскаяКарта,
		?(Генератор.СлучайноеЧисло(1, 2) = 1, Перечисления.СпособыОплаты.СБП, Перечисления.СпособыОплаты.Наличные));
	Если Клиент <> Неопределено Тогда
		Документ.Клиент = Клиент;
		Документ.ПроцентСкидки = ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(Клиент, "ПроцентСкидки");
	КонецЕсли;

	Выбранные = Новый Массив;
	Для Позиция = 1 По Генератор.СлучайноеЧисло(1, 3) Цикл
		// Кофе и чай берут чаще, чем посуду и аксессуары.
		Индекс = ?(Генератор.СлучайноеЧисло(1, 10) <= 7, Генератор.СлучайноеЧисло(0, 11), Генератор.СлучайноеЧисло(0, Товары.Количество() - 1));
		Товар = Товары[Индекс].Товар;
		Если Выбранные.Найти(Товар) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Выбранные.Добавить(Товар);
		СтрокаТовары = Документ.Товары.Добавить();
		СтрокаТовары.Товар = Товар;
		СтрокаТовары.Количество = ?(Товары[Индекс].Цена > 1000, 1, Генератор.СлучайноеЧисло(1, 3));
	КонецЦикла;

	Цены = ЦенообразованиеСервер.ЦеныТоваров(Выбранные, Дата);
	Для Каждого СтрокаТовары Из Документ.Товары Цикл
		СтрокаТовары.Цена = Цены[СтрокаТовары.Товар];
	КонецЦикла;

	// Демо-данные не должны засыпать Telegram сотнями уведомлений.
	Документ.ДополнительныеСвойства.Вставить("НеОтправлятьУведомления", Истина);
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Документ.Ссылка;

КонецФункции

Процедура ОформитьВозврат(Продажа, Дата)
	Документ = Документы.ВозвратОтПокупателя.СоздатьДокумент();
	Документ.Дата = Дата;
	Документ.Заполнить(Продажа);
	Если Документ.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Пока Документ.Товары.Количество() > 1 Цикл
		Документ.Товары.Удалить(Документ.Товары.Количество() - 1);
	КонецЦикла;
	Документ.Товары[0].Количество = 1;
	Документ.Комментарий = "Покупатель вернул товар в течение 14 дней";
	Документ.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура ПровестиИнвентаризацию(Склад, Дата)
	Документ = Документы.ИнвентаризацияТоваров.СоздатьДокумент();
	Документ.Дата = Дата;
	Документ.Склад = Склад;
	Документ.Комментарий = "Плановая инвентаризация";
	Документ.ЗаполнитьПоОстаткам();
	// Пара расхождений, как бывает в жизни: одной позиции не хватает, другой лишняя.
	Если Документ.Товары.Количество() >= 2 Тогда
		Документ.Товары[0].КоличествоФакт = Макс(Документ.Товары[0].КоличествоУчет - 1, 0);
		Документ.Товары[1].КоличествоФакт = Документ.Товары[1].КоличествоУчет + 1;
	КонецЕсли;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

#КонецОбласти
