// Демонстрационные данные: кофейная лавка с двумя складами и историей за 60 дней.
// Документы создаются в хронологическом порядке и проводятся теми же механизмами,
// что и при ручной работе, поэтому отчёты и бот показывают согласованные цифры.
// Случайные числа детерминированные (фиксированное зерно): данные одинаковые при каждом заполнении.

#Область ПрограммныйИнтерфейс

// Заполняет базу демо-данными, если она пустая.
//
// Возвращаемое значение:
//  Строка - протокол заполнения.
//
Функция Заполнить() Экспорт

	Если Справочники.Склады.Выбрать().Следующий() Тогда
		Возврат "Демо-данные не заполнялись: в базе уже есть склады.";
	КонецЕсли;

	Генератор = Новый ГенераторСлучайныхЧисел(2026);
	Начало = НачалоДня(ТекущаяДатаСеанса()) - 60 * 86400;
	Счетчики = Новый Структура("Поступлений, Продаж, Отказов, Перемещений, Возвратов, Инвентаризаций", 0, 0, 0, 0, 0, 0);

	Если Не ЗначениеЗаполнено(Константы.НазваниеМагазина.Получить()) Тогда
		Константы.НазваниеМагазина.Установить("Кофейная лавка «Зерно»");
	КонецЕсли;

	Магазин = НовыйЭлемент("Склады", "Магазин на Ленина", Новый Структура("Адрес, Ответственный", "ул. Ленина, 12", "Смирнова О. П."));
	Склад = НовыйЭлемент("Склады", "Склад на Промышленной", Новый Структура("Адрес, Ответственный", "ул. Промышленная, 5", "Кузнецов И. А."));
	Константы.ОсновнойСклад.Установить(Магазин);

	Поставщики = Новый Массив;
	Поставщики.Добавить(НовыйЭлемент("Поставщики", "ООО «Кофе Трейд»", Новый Структура("ИНН, Телефон", "7701234567", "+7 495 100-20-30")));
	Поставщики.Добавить(НовыйЭлемент("Поставщики", "ИП Чайников А. В.", Новый Структура("ИНН, Телефон", "772012345678", "+7 916 200-30-40")));
	Поставщики.Добавить(НовыйЭлемент("Поставщики", "ООО «Сладкая жизнь»", Новый Структура("ИНН, Телефон", "7802345678", "+7 812 300-40-50")));

	Клиенты = СоздатьКлиентов();

	// Номенклатура загружается тем же механизмом, что и пользовательский CSV.
	Загрузка = ЗагрузкаДанныхСервер.ЗагрузитьТоварыИзCSV(КаталогCSV(), Начало);
	Если Загрузка.Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Ошибка загрузки демо-каталога: " + СтрСоединить(Загрузка.Ошибки, "; ");
	КонецЕсли;
	Товары = ТоварыКаталога();

	// Через 40 дней кофе дорожает на 8%.
	ПовыситьЦены(Товары, "Кофе", 8, Начало + 40 * 86400 + 3600);

	Для День = 0 По 60 Цикл
		ДатаДня = Начало + День * 86400;

		Если День % 5 = 0 Тогда
			ЗакупитьТовары(Товары, Магазин, Поставщики, ДатаДня + 8 * 3600, Генератор);
			Счетчики.Поступлений = Счетчики.Поступлений + 1;
		КонецЕсли;

		Если День % 7 = 2 Тогда
			ПереместитьТовары(Товары, Магазин, Склад, ДатаДня + 8 * 3600 + 1800, Генератор);
			Счетчики.Перемещений = Счетчики.Перемещений + 1;
		КонецЕсли;

		ПервыйЧек = Неопределено;
		ЧековЗаДень = 4 + Генератор.СлучайноеЧисло(0, 5) + ?(ДеньНедели(ДатаДня) >= 6, 3, 0);
		Для НомерЧека = 1 По ЧековЗаДень Цикл
			ВремяЧека = ДатаДня + 9 * 3600 + НомерЧека * Цел(11 * 3600 / (ЧековЗаДень + 1));
			СкладЧека = ?(Генератор.СлучайноеЧисло(1, 10) = 1, Склад, Магазин);
			Клиент = ?(Генератор.СлучайноеЧисло(1, 10) <= 4, Клиенты[Генератор.СлучайноеЧисло(0, Клиенты.ВГраница())], Неопределено);
			Чек = ПродатьТовары(Товары, СкладЧека, Клиент, ВремяЧека, Генератор);
			Если Чек = Неопределено Тогда
				Счетчики.Отказов = Счетчики.Отказов + 1;
			Иначе
				Счетчики.Продаж = Счетчики.Продаж + 1;
				Если ПервыйЧек = Неопределено Тогда
					ПервыйЧек = Чек;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		Если (День = 25 Или День = 50) И ПервыйЧек <> Неопределено Тогда
			ОформитьВозврат(ПервыйЧек, ДатаДня + 21 * 3600);
			Счетчики.Возвратов = Счетчики.Возвратов + 1;
		КонецЕсли;

		Если День = 55 Тогда
			ПровестиИнвентаризацию(Магазин, ДатаДня + 21 * 3600 + 1800);
			Счетчики.Инвентаризаций = Счетчики.Инвентаризаций + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон("Демо-данные заполнены: товаров %1, клиентов %2, поступлений %3, продаж %4, перемещений %5, возвратов %6, инвентаризаций %7. Пропущено продаж из-за нехватки товара: %8.",
		Товары.Количество(), Клиенты.Количество(), Счетчики.Поступлений, Счетчики.Продаж, Счетчики.Перемещений,
		Счетчики.Возвратов, Счетчики.Инвентаризаций, Счетчики.Отказов);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

