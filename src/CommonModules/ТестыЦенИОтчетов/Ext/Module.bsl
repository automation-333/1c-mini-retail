// Тесты цен на дату, отчётов на СКД и печатных форм.
// Отчёты проверяются на отдельных периодах, где нет движений других тестов.

#Область СписокТестов

Функция СписокТестов() Экспорт
	Тесты = Новый Массив;
	Тесты.Добавить("ЦенаБерётсяНаДатуИзРегистраИлиИзКарточки");
	Тесты.Добавить("ОтчетВаловаяПрибыльСчитаетПрибыльИНаценку");
	Тесты.Добавить("ОтчетABCКлассифицируетТовары");
	Тесты.Добавить("ВедомостьПоОстаткамФормируется");
	Тесты.Добавить("ЧекПродажиСодержитТоварыИИтог");
	Тесты.Добавить("НакладнаяПоступленияФормируется");
	Возврат Тесты;
КонецФункции

#КонецОбласти

#Область Тесты

Процедура ЦенаБерётсяНаДатуИзРегистраИлиИзКарточки() Экспорт

	Товар = Самопроверка.НовыйТовар("Капучино", 90);
	УстановитьЦену(Товар, 100, Самопроверка.ДатаТеста(10));
	УстановитьЦену(Товар, 120, Самопроверка.ДатаТеста(20));

	Самопроверка.ОжидатьРавенство(ЦенообразованиеСервер.ЦенаТовара(Товар, Самопроверка.ДатаТеста(5)), 90, "До первой установки — базовая цена");
	Самопроверка.ОжидатьРавенство(ЦенообразованиеСервер.ЦенаТовара(Товар, Самопроверка.ДатаТеста(15)), 100, "Между установками — первая цена");
	Самопроверка.ОжидатьРавенство(ЦенообразованиеСервер.ЦенаТовара(Товар, Самопроверка.ДатаТеста(20)), 120, "В день установки — новая цена");
	Самопроверка.ОжидатьРавенство(ЦенообразованиеСервер.ЦенаТовара(Товар, Самопроверка.ДатаТеста(30)), 120, "После — последняя цена");

КонецПроцедуры

Процедура ОтчетВаловаяПрибыльСчитаетПрибыльИНаценку() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Раф");
	Самопроверка.Поступление(Склад, Товар, 10, 100, Самопроверка.ДатаТеста(100));
	Самопроверка.Продажа(Склад, Товар, 4, 250, Самопроверка.ДатаТеста(101));

	Дерево = Самопроверка.РезультатОтчета("ВаловаяПрибыль",
		Новый Структура("Период", Новый СтандартныйПериод(Самопроверка.ДатаТеста(100), КонецДня(Самопроверка.ДатаТеста(102)))));
	Строка = Дерево.Строки.Найти(Товар, "Товар", Истина);

	Самопроверка.Ожидать(Строка <> Неопределено, "товар есть в отчёте");
	Самопроверка.ОжидатьРавенство(Строка.Выручка, 1000, "Выручка");
	Самопроверка.ОжидатьРавенство(Строка.Себестоимость, 400, "Себестоимость");
	Самопроверка.ОжидатьРавенство(Строка.ВаловаяПрибыль, 600, "Валовая прибыль");
	Самопроверка.ОжидатьРавенство(Окр(Строка.НаценкаПроцент, 1), 150, "Наценка 600 / 400");

КонецПроцедуры

Процедура ОтчетABCКлассифицируетТовары() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Лидер = Самопроверка.НовыйТовар("ABC лидер");
	Середина = Самопроверка.НовыйТовар("ABC середина");
	Хвост = Самопроверка.НовыйТовар("ABC хвост");
	День = Самопроверка.УникальнаяДатаТеста();
	Самопроверка.Поступление(Склад, Лидер, 10, 10, День);
	Самопроверка.Поступление(Склад, Середина, 10, 10, День);
	Самопроверка.Поступление(Склад, Хвост, 10, 10, День);
	Самопроверка.Продажа(Склад, Лидер, 8, 100, (День + 86400));
	Самопроверка.Продажа(Склад, Середина, 3, 50, (День + 86400));
	Самопроверка.Продажа(Склад, Хвост, 1, 50, (День + 86400));

	Дерево = Самопроверка.РезультатОтчета("ABCАнализПродаж",
		Новый Структура("Период", Новый СтандартныйПериод(День, КонецДня((День + 2 * 86400)))));

	// Доли: 800 из 1000 (80%) — A, 150 (15%) — B, 50 (5%) — C.
	Самопроверка.ОжидатьРавенство(КлассТовара(Дерево, Лидер), "A", "Лидер продаж");
	Самопроверка.ОжидатьРавенство(КлассТовара(Дерево, Середина), "B", "Средний товар");
	Самопроверка.ОжидатьРавенство(КлассТовара(Дерево, Хвост), "C", "Хвост");

КонецПроцедуры

Процедура ВедомостьПоОстаткамФормируется() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Латте");
	Самопроверка.Поступление(Склад, Товар, 3, 70, Самопроверка.ДатаТеста(300));

	ТабДок = Самопроверка.ТабличныйДокументОтчета("ВедомостьПоОстаткам");
	Самопроверка.Ожидать(ТабДок.ВысотаТаблицы > 3, "отчёт выведен в табличный документ");
	Самопроверка.Ожидать(ТабДок.НайтиТекст(Строка(Товар)) <> Неопределено, "в отчёте есть товар с остатком");

КонецПроцедуры

Процедура ЧекПродажиСодержитТоварыИИтог() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Эспрессо");
	Самопроверка.Поступление(Склад, Товар, 5, 40, Самопроверка.ДатаТеста(400));
	Продажа = Самопроверка.Продажа(Склад, Товар, 2, 120, Самопроверка.ДатаТеста(401));

	ТабДок = ПечатьСервер.ЧекПродажи(Продажа);

	Самопроверка.Ожидать(ТабДок.НайтиТекст("ИТОГО") <> Неопределено, "в чеке есть строка ИТОГО");
	Самопроверка.Ожидать(ТабДок.НайтиТекст(Строка(Товар)) <> Неопределено, "в чеке есть товар");
	Самопроверка.Ожидать(ТабДок.НайтиТекст("240,00") <> Неопределено, "в чеке есть сумма 240,00");

КонецПроцедуры

Процедура НакладнаяПоступленияФормируется() Экспорт

	Склад = Самопроверка.НовыйСклад();
	Товар = Самопроверка.НовыйТовар("Сахар");
	Поступление = Самопроверка.Поступление(Склад, Товар, 12, 25, Самопроверка.ДатаТеста(410));

	ТабДок = ПечатьСервер.НакладнаяПоступления(Поступление);

	Самопроверка.Ожидать(ТабДок.НайтиТекст("ПРИХОДНАЯ НАКЛАДНАЯ") <> Неопределено, "заголовок накладной");
	Самопроверка.Ожидать(ТабДок.НайтиТекст("300,00") <> Неопределено, "сумма 12 × 25");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьЦену(Товар, Цена, Дата)
	Документ = Документы.УстановкаЦенТоваров.СоздатьДокумент();
	Документ.Дата = Дата;
	СтрокаЦены = Документ.Товары.Добавить();
	СтрокаЦены.Товар = Товар;
	СтрокаЦены.Цена = Цена;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Функция КлассТовара(Дерево, Товар)
	СтрокаТовара = Дерево.Строки.Найти(Товар, "Товар", Истина);
	Если СтрокаТовара = Неопределено Тогда
		Возврат "нет в отчёте";
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаТовара.КлассABC) Тогда
		Возврат СтрокаТовара.КлассABC;
	КонецЕсли;
	Возврат ?(СтрокаТовара.Родитель = Неопределено, "", СтрокаТовара.Родитель.КлассABC);
КонецФункции

#КонецОбласти
