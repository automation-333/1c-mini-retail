// Цены товаров на дату. Источник цены: периодический регистр ЦеныТоваров
// (устанавливается документом УстановкаЦенТоваров). Если цены на дату нет,
// используется базовая цена из карточки товара.

#Область ПрограммныйИнтерфейс

// Цены нескольких товаров на дату одним запросом.
//
// Параметры:
//  Товары - Массив из СправочникСсылка.Товары
//  Дата   - Дата - дата, на которую нужна цена.
//
// Возвращаемое значение:
//  Соответствие - ключ Товар, значение Цена.
//
Функция ЦеныТоваров(Товары, Дата) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Дата), КонецДня(Дата), КонецДня(ТекущаяДатаСеанса())));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК Товар,
	|	ЕСТЬNULL(Цены.Цена, Товары.Цена) КАК Цена
	|ИЗ
	|	Справочник.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныТоваров.СрезПоследних(&Дата, Товар В (&Товары)) КАК Цены
	|		ПО (Цены.Товар = Товары.Ссылка)
	|ГДЕ
	|	Товары.Ссылка В(&Товары)";

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Товар, Выборка.Цена);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Цена одного товара на дату.
Функция ЦенаТовара(Товар, Дата) Экспорт

	Если Не ЗначениеЗаполнено(Товар) Тогда
		Возврат 0;
	КонецЕсли;
	Товары = Новый Массив;
	Товары.Добавить(Товар);
	Цена = ЦеныТоваров(Товары, Дата)[Товар];
	Возврат ?(Цена = Неопределено, 0, Цена);

КонецФункции

// Сумма строки с учётом скидки, округлённая до копеек.
Функция СуммаСоСкидкой(Количество, Цена, ПроцентСкидки) Экспорт
	Возврат Окр(Количество * Цена * (100 - ПроцентСкидки) / 100, 2);
КонецФункции

#КонецОбласти
