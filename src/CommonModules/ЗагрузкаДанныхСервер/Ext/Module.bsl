// Загрузка номенклатуры из CSV (выгрузка из Excel «CSV UTF-8»).
//
// Формат: первая строка — заголовки, разделитель «;» или «,», поля в кавычках поддерживаются.
//   Артикул;Наименование;Группа;Штрихкод;ЕдиницаИзмерения;Цена
// Обязательны Артикул и Наименование. Товар ищется по артикулу: найден — обновляется, нет — создаётся.
// Группы создаются автоматически. Цены из файла устанавливаются одним документом УстановкаЦенТоваров.
// Вся загрузка идёт в одной транзакции: либо загрузился весь файл, либо ничего.

#Область ПрограммныйИнтерфейс

// Загружает товары из текста CSV.
//
// Параметры:
//  ТекстCSV - Строка - содержимое файла.
//  ДатаЦен  - Дата - дата установки цен, по умолчанию текущая.
//
// Возвращаемое значение:
//  Структура:
//   * Создано         - Число
//   * Обновлено       - Число
//   * ЦенУстановлено  - Число
//   * Ошибки          - Массив из Строка - ошибки строк файла (такие строки пропускаются).
//   * ДокументЦен     - ДокументСсылка.УстановкаЦенТоваров, Неопределено
//
Функция ЗагрузитьТоварыИзCSV(ТекстCSV, ДатаЦен = Неопределено) Экспорт

	Результат = Новый Структура("Создано, Обновлено, ЦенУстановлено, Ошибки, ДокументЦен", 0, 0, 0, Новый Массив, Неопределено);

	Строки = РазобратьCSV(ТекстCSV);
	Если Строки.Количество() < 2 Тогда
		Результат.Ошибки.Добавить("В файле нет данных: нужна строка заголовков и хотя бы одна строка товаров");
		Возврат Результат;
	КонецЕсли;

	Колонки = КолонкиФайла(Строки[0]);
	Если Колонки["артикул"] = Неопределено Или Колонки["наименование"] = Неопределено Тогда
		Результат.Ошибки.Добавить("В заголовке нет обязательных колонок Артикул и Наименование");
		Возврат Результат;
	КонецЕсли;

	Данные = ПрочитатьСтрокиТоваров(Строки, Колонки, Результат.Ошибки);
	Если Данные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Существующие товары и группы находим одним запросом, а не запросом на каждую строку.
	Существующие = СуществующиеТовары(Данные.ВыгрузитьКолонку("Артикул"));
	Группы = СуществующиеГруппы(Данные.ВыгрузитьКолонку("Группа"));

	НачатьТранзакцию();
	Попытка
		Цены = Новый Соответствие;
		Для Каждого СтрокаДанных Из Данные Цикл

			Родитель = ГруппаТоваров(СтрокаДанных.Группа, Группы);

			Ссылка = Существующие[СтрокаДанных.Артикул];
			Если Ссылка = Неопределено Тогда
				Товар = Справочники.Товары.СоздатьЭлемент();
				Товар.Артикул = СтрокаДанных.Артикул;
				Результат.Создано = Результат.Создано + 1;
			Иначе
				Товар = Ссылка.ПолучитьОбъект();
				Результат.Обновлено = Результат.Обновлено + 1;
			КонецЕсли;

			Товар.Наименование = СтрокаДанных.Наименование;
			Товар.Родитель = Родитель;
			Если ЗначениеЗаполнено(СтрокаДанных.Штрихкод) Тогда
				Товар.Штрихкод = СтрокаДанных.Штрихкод;
			КонецЕсли;
			Товар.ЕдиницаИзмерения = ?(ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмерения), СтрокаДанных.ЕдиницаИзмерения, "шт");
			Если СтрокаДанных.Цена <> Неопределено И Товар.Цена = 0 Тогда
				Товар.Цена = СтрокаДанных.Цена;
			КонецЕсли;
			Товар.Записать();
			Существующие.Вставить(СтрокаДанных.Артикул, Товар.Ссылка);

			Если СтрокаДанных.Цена <> Неопределено Тогда
				Цены.Вставить(Товар.Ссылка, СтрокаДанных.Цена);
			КонецЕсли;

		КонецЦикла;

		Если Цены.Количество() > 0 Тогда
			ДокументЦен = Документы.УстановкаЦенТоваров.СоздатьДокумент();
			ДокументЦен.Дата = ?(ЗначениеЗаполнено(ДатаЦен), ДатаЦен, ТекущаяДатаСеанса());
			ДокументЦен.Комментарий = "Загрузка из CSV";
			Для Каждого КлючИЗначение Из Цены Цикл
				СтрокаЦены = ДокументЦен.Товары.Добавить();
				СтрокаЦены.Товар = КлючИЗначение.Ключ;
				СтрокаЦены.Цена = КлючИЗначение.Значение;
			КонецЦикла;
			ДокументЦен.Записать(РежимЗаписиДокумента.Проведение);
			Результат.ЦенУстановлено = Цены.Количество();
			Результат.ДокументЦен = ДокументЦен.Ссылка;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Создано = 0;
		Результат.Обновлено = 0;
		Результат.ЦенУстановлено = 0;
		Результат.Ошибки.Добавить("Загрузка отменена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Загружает товары из файла CSV в кодировке UTF-8.
Функция ЗагрузитьТоварыИзФайла(ИмяФайла, ДатаЦен = Неопределено) Экспорт

	Документ = Новый ТекстовыйДокумент;
	Документ.Прочитать(ИмяФайла, КодировкаТекста.UTF8);
	Возврат ЗагрузитьТоварыИзCSV(Документ.ПолучитьТекст(), ДатаЦен);

КонецФункции

// Разбирает CSV в массив строк, каждая строка — массив значений полей.
Функция РазобратьCSV(ТекстCSV) Экспорт

	Текст = СтрЗаменить(СтрЗаменить(ТекстCSV, Символы.ВК + Символы.ПС, Символы.ПС), Символы.ВК, Символы.ПС);
	Если Лев(Текст, 1) = Символ(65279) Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;

	ПерваяСтрока = СтрПолучитьСтроку(Текст, 1);
	Разделитель = ?(СтрНайти(ПерваяСтрока, ";") > 0, ";", ",");

	Результат = Новый Массив;
	Поля = Новый Массив;
	Поле = "";
	ВКавычках = Ложь;
	Длина = СтрДлина(Текст);
	Позиция = 1;

	Пока Позиция <= Длина Цикл
		ТекущийСимвол = Сред(Текст, Позиция, 1);
		Если ВКавычках Тогда
			Если ТекущийСимвол = """" Тогда
				Если Сред(Текст, Позиция + 1, 1) = """" Тогда
					Поле = Поле + """";
					Позиция = Позиция + 1;
				Иначе
					ВКавычках = Ложь;
				КонецЕсли;
			Иначе
				Поле = Поле + ТекущийСимвол;
			КонецЕсли;
		ИначеЕсли ТекущийСимвол = """" Тогда
			ВКавычках = Истина;
		ИначеЕсли ТекущийСимвол = Разделитель Тогда
			Поля.Добавить(СокрЛП(Поле));
			Поле = "";
		ИначеЕсли ТекущийСимвол = Символы.ПС Тогда
			Поля.Добавить(СокрЛП(Поле));
			ДобавитьНепустуюСтроку(Результат, Поля);
			Поля = Новый Массив;
			Поле = "";
		Иначе
			Поле = Поле + ТекущийСимвол;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Поля.Добавить(СокрЛП(Поле));
	ДобавитьНепустуюСтроку(Результат, Поля);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьНепустуюСтроку(Результат, Поля)
	Для Каждого Значение Из Поля Цикл
		Если ЗначениеЗаполнено(Значение) Тогда
			Результат.Добавить(Поля);
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Соответствие «имя колонки в нижнем регистре — индекс».
Функция КолонкиФайла(Заголовок)
	Синонимы = Новый Соответствие;
	Синонимы.Вставить("единица", "единицаизмерения");
	Синонимы.Вставить("ед.изм.", "единицаизмерения");
	Синонимы.Вставить("штрих-код", "штрихкод");

	Колонки = Новый Соответствие;
	Для Индекс = 0 По Заголовок.ВГраница() Цикл
		Имя = НРег(СтрЗаменить(Заголовок[Индекс], " ", ""));
		Имя = ?(Синонимы[Имя] = Неопределено, Имя, Синонимы[Имя]);
		Колонки.Вставить(Имя, Индекс);
	КонецЦикла;
	Возврат Колонки;
КонецФункции

Функция ПрочитатьСтрокиТоваров(Строки, Колонки, Ошибки)

	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(25)));
	Данные.Колонки.Добавить("Наименование");
	Данные.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	Данные.Колонки.Добавить("Штрихкод");
	Данные.Колонки.Добавить("ЕдиницаИзмерения");
	Данные.Колонки.Добавить("Цена");

	Для НомерСтроки = 1 По Строки.ВГраница() Цикл
		Поля = Строки[НомерСтроки];
		Артикул = ЗначениеПоля(Поля, Колонки, "артикул");
		Наименование = ЗначениеПоля(Поля, Колонки, "наименование");
		ТекстЦены = ЗначениеПоля(Поля, Колонки, "цена");

		Если ПустаяСтрока(Артикул) Или ПустаяСтрока(Наименование) Тогда
			Ошибки.Добавить(СтрШаблон("Строка %1: не заполнен артикул или наименование", НомерСтроки + 1));
			Продолжить;
		КонецЕсли;

		Цена = Неопределено;
		Если Не ПустаяСтрока(ТекстЦены) Тогда
			Цена = ЧислоИзСтроки(ТекстЦены);
			Если Цена = Неопределено Или Цена < 0 Тогда
				Ошибки.Добавить(СтрШаблон("Строка %1: некорректная цена ""%2""", НомерСтроки + 1, ТекстЦены));
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		СтрокаДанных = Данные.Добавить();
		СтрокаДанных.Артикул = Артикул;
		СтрокаДанных.Наименование = Лев(Наименование, 100);
		СтрокаДанных.Группа = ЗначениеПоля(Поля, Колонки, "группа");
		СтрокаДанных.Штрихкод = Лев(ЗначениеПоля(Поля, Колонки, "штрихкод"), 20);
		СтрокаДанных.ЕдиницаИзмерения = Лев(ЗначениеПоля(Поля, Колонки, "единицаизмерения"), 10);
		СтрокаДанных.Цена = Цена;
	КонецЦикла;

	Возврат Данные;

КонецФункции

Функция ЗначениеПоля(Поля, Колонки, Имя)
	Индекс = Колонки[Имя];
	Если Индекс = Неопределено Или Индекс > Поля.ВГраница() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Поля[Индекс];
КонецФункции

Функция ЧислоИзСтроки(Текст)
	Очищенный = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, " ", ""), Символ(160), ""), ",", ".");
	Описание = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	Попытка
		Возврат Описание.ПривестиЗначение(Число(Очищенный));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция СуществующиеТовары(Артикулы)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Артикулы", Артикулы);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Артикул КАК Артикул
	|ИЗ
	|	Справочник.Товары КАК Товары
	|ГДЕ
	|	НЕ Товары.ЭтоГруппа
	|	И Товары.Артикул В(&Артикулы)";
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(СокрЛП(Выборка.Артикул), Выборка.Ссылка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СуществующиеГруппы(Имена)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имена", Имена);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Товары КАК Товары
	|ГДЕ
	|	Товары.ЭтоГруппа
	|	И Товары.Наименование В(&Имена)";
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(НРег(СокрЛП(Выборка.Наименование)), Выборка.Ссылка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ГруппаТоваров(Имя, Группы)
	Если ПустаяСтрока(Имя) Тогда
		Возврат Справочники.Товары.ПустаяСсылка();
	КонецЕсли;
	Ключ = НРег(СокрЛП(Имя));
	Ссылка = Группы[Ключ];
	Если Ссылка = Неопределено Тогда
		Группа = Справочники.Товары.СоздатьГруппу();
		Группа.Наименование = СокрЛП(Имя);
		Группа.Записать();
		Ссылка = Группа.Ссылка;
		Группы.Вставить(Ключ, Ссылка);
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

#КонецОбласти
