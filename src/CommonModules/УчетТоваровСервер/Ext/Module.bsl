// Механизмы складского учёта: таблицы товаров документов, управляемые блокировки,
// движения по остаткам, контроль отрицательных остатков и списание партий по FIFO.
//
// Типовая схема проведения расходного документа:
//   1. ОчиститьДвижения - старые движения удаляются до чтения остатков,
//      иначе при перепроведении документ «увидит» собственный расход;
//   2. ЗаблокироватьТовары - исключительная блокировка остатков и партий по складу и товару;
//   3. ДобавитьДвиженияОстатков и СписатьПартииFIFO;
//   4. Движения.Записать() и ПроверитьОтрицательныеОстатки.

#Область ПрограммныйИнтерфейс

// Пустая таблица товаров с типизированными колонками (нужны для передачи в запрос).
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки НомерСтроки, Склад, Товар, Количество.
//
Функция НоваяТаблицаТоваров() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Таблица.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	Таблица.Колонки.Добавить("Товар", Новый ОписаниеТипов("СправочникСсылка.Товары"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0)));
	Возврат Таблица;

КонецФункции

// Таблица товаров документа для проведения.
//
// Параметры:
//  ТабличнаяЧасть - ТабличнаяЧасть - табличная часть "Товары" документа.
//  Склад          - СправочникСсылка.Склады - склад, по которому идёт движение.
//  ИмяКоличества  - Строка - имя колонки количества в табличной части.
//
Функция ТаблицаТоваровДокумента(ТабличнаяЧасть, Склад, ИмяКоличества = "Количество") Экспорт

	Таблица = НоваяТаблицаТоваров();
	Для Каждого СтрокаТовары Из ТабличнаяЧасть Цикл
		Количество = СтрокаТовары[ИмяКоличества];
		Если Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.НомерСтроки = СтрокаТовары.НомерСтроки;
		НоваяСтрока.Склад = Склад;
		НоваяСтрока.Товар = СтрокаТовары.Товар;
		НоваяСтрока.Количество = Количество;
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Записывает пустые наборы движений документа, удаляя движения прошлого проведения.
Процедура ОчиститьДвижения(Движения) Экспорт

	Для Каждого НаборЗаписей Из Движения Цикл
		НаборЗаписей.Записывать = Истина;
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
	КонецЦикла;

КонецПроцедуры

// Исключительная управляемая блокировка остатков и партий по складам и товарам таблицы.
// Пока документ проводится, другие документы не могут прочитать те же остатки,
// поэтому два кассира не продадут один и тот же последний товар.
Процедура ЗаблокироватьТовары(ТаблицаТоваров) Экспорт

	Если ТаблицаТоваров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Источник = ТаблицаТоваров.Скопировать(, "Склад, Товар");
	Источник.Свернуть("Склад, Товар");

	Блокировка = Новый БлокировкаДанных;
	Для Каждого ИмяРегистра Из СтрРазделить("ОстаткиТоваров,ПартииТоваров", ",") Цикл
		Элемент = Блокировка.Добавить("РегистрНакопления." + ИмяРегистра);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.ИсточникДанных = Источник;
		Элемент.ИспользоватьИзИсточникаДанных("Склад", "Склад");
		Элемент.ИспользоватьИзИсточникаДанных("Товар", "Товар");
	КонецЦикла;
	Блокировка.Заблокировать();

КонецПроцедуры

// Добавляет движения по регистру ОстаткиТоваров.
//
// Параметры:
//  НаборДвижений  - РегистрНакопленияНаборЗаписей.ОстаткиТоваров
//  ВидДвижения    - ВидДвиженияНакопления
//  Период         - Дата
//  ТаблицаТоваров - см. НоваяТаблицаТоваров
//
Процедура ДобавитьДвиженияОстатков(НаборДвижений, ВидДвижения, Период, ТаблицаТоваров) Экспорт

	НаборДвижений.Записывать = Истина;

	Свернутая = ТаблицаТоваров.Скопировать(, "Склад, Товар, Количество");
	Свернутая.Свернуть("Склад, Товар", "Количество");

	Для Каждого СтрокаТовары Из Свернутая Цикл
		Движение = НаборДвижений.Добавить();
		Движение.ВидДвижения = ВидДвижения;
		Движение.Период = Период;
		Движение.Склад = СтрокаТовары.Склад;
		Движение.Товар = СтрокаТовары.Товар;
		Движение.Количество = СтрокаТовары.Количество;
	КонецЦикла;

КонецПроцедуры

// Списывает партии товаров по FIFO: первыми уходят самые ранние поступления.
// Добавляет расход в набор движений партий и возвращает, какие партии и на какую сумму списаны.
//
// Параметры:
//  НаборДвижений  - РегистрНакопленияНаборЗаписей.ПартииТоваров
//  Период         - Дата
//  ТаблицаТоваров - см. НоваяТаблицаТоваров. Склад в строках должен быть один.
//  Отказ          - Булево - устанавливается, если партий не хватило.
//  Документ       - ДокументОбъект - для привязки сообщений.
//
// Возвращаемое значение:
//  ТаблицаЗначений - НомерСтроки, Товар, Партия, Количество, Стоимость.
//
Функция СписатьПартииFIFO(НаборДвижений, Период, ТаблицаТоваров, Отказ, Документ = Неопределено) Экспорт

	НаборДвижений.Записывать = Истина;

	Списание = Новый ТаблицаЗначений;
	Списание.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Списание.Колонки.Добавить("Товар", Новый ОписаниеТипов("СправочникСсылка.Товары"));
	Списание.Колонки.Добавить("Партия");
	Списание.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Списание.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));

	Если ТаблицаТоваров.Количество() = 0 Тогда
		Возврат Списание;
	КонецЕсли;

	Партии = ОстаткиПартий(ТаблицаТоваров);

	Для Каждого СтрокаТовары Из ТаблицаТоваров Цикл

		ОсталосьСписать = СтрокаТовары.Количество;
		Отбор = Новый Структура("Склад, Товар", СтрокаТовары.Склад, СтрокаТовары.Товар);

		Для Каждого Партия Из Партии.НайтиСтроки(Отбор) Цикл
			Если ОсталосьСписать = 0 Тогда
				Прервать;
			КонецЕсли;
			Если Партия.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;

			Количество = Мин(ОсталосьСписать, Партия.Количество);
			// Если партия уходит целиком, списываем всю её стоимость, чтобы не копить ошибку округления.
			Стоимость = ?(Количество = Партия.Количество, Партия.Стоимость,
				Окр(Партия.Стоимость * Количество / Партия.Количество, 2));

			Партия.Количество = Партия.Количество - Количество;
			Партия.Стоимость = Партия.Стоимость - Стоимость;
			ОсталосьСписать = ОсталосьСписать - Количество;

			Движение = НаборДвижений.ДобавитьРасход();
			Движение.Период = Период;
			Движение.Склад = СтрокаТовары.Склад;
			Движение.Товар = СтрокаТовары.Товар;
			Движение.Партия = Партия.Партия;
			Движение.Количество = Количество;
			Движение.Стоимость = Стоимость;

			СтрокаСписания = Списание.Добавить();
			СтрокаСписания.НомерСтроки = СтрокаТовары.НомерСтроки;
			СтрокаСписания.Товар = СтрокаТовары.Товар;
			СтрокаСписания.Партия = Партия.Партия;
			СтрокаСписания.Количество = Количество;
			СтрокаСписания.Стоимость = Стоимость;
		КонецЦикла;

		Если ОсталосьСписать > 0 Тогда
			ОбщегоНазначенияСервер.СообщитьПользователю(
				СтрШаблон("Не хватает партий товара ""%1"" на складе ""%2"": %3 шт.",
					СтрокаТовары.Товар, СтрокаТовары.Склад, ОсталосьСписать),
				Документ, СтрШаблон("Товары[%1].Количество", СтрокаТовары.НомерСтроки - 1), Отказ);
		КонецЕсли;

	КонецЦикла;

	Возврат Списание;

КонецФункции

// Себестоимость по строкам документа из результата СписатьПартииFIFO.
//
// Возвращаемое значение:
//  Соответствие - ключ НомерСтроки, значение сумма себестоимости.
//
Функция СебестоимостьПоСтрокам(Списание) Экспорт

	Свернутая = Списание.Скопировать(, "НомерСтроки, Стоимость");
	Свернутая.Свернуть("НомерСтроки", "Стоимость");

	Результат = Новый Соответствие;
	Для Каждого Строка Из Свернутая Цикл
		Результат.Вставить(Строка.НомерСтроки, Строка.Стоимость);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Проверяет остатки после записи движений. Если где-то ушли в минус, сообщает и ставит отказ.
// Вызывается после Движения.Записать(), поэтому остатки уже учитывают текущий документ
// и проверка одна на все товары, а не запрос на каждую строку.
Процедура ПроверитьОтрицательныеОстатки(ТаблицаТоваров, Отказ, Документ = Неопределено) Экспорт

	Если ТаблицаТоваров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров.Скопировать(, "Склад, Товар"));
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Склад КАК Склад,
	|	Т.Товар КАК Товар
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	&ТаблицаТоваров КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Склад КАК Склад,
	|	Остатки.Товар КАК Товар,
	|	-Остатки.КоличествоОстаток КАК Нехватка
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(
	|			,
	|			(Склад, Товар) В
	|				(ВЫБРАТЬ
	|					ВТТовары.Склад,
	|					ВТТовары.Товар
	|				ИЗ
	|					ВТТовары КАК ВТТовары)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияСервер.СообщитьПользователю(
			СтрШаблон("Не хватает товара ""%1"" на складе ""%2"": %3 шт.",
				Выборка.Товар, Выборка.Склад, Выборка.Нехватка),
			Документ, , Отказ);
	КонецЦикла;

КонецПроцедуры

// Текущие остатки товаров на складе.
//
// Параметры:
//  Склад  - СправочникСсылка.Склады - если не заполнен, по всем складам.
//  Товары - Массив - если не заполнен, по всем товарам.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Склад, Товар, Количество, Стоимость.
//
Функция ТекущиеОстатки(Склад = Неопределено, Товары = Неопределено) Экспорт

	Условия = Новый Массив;
	Если ЗначениеЗаполнено(Склад) Тогда
		Условия.Добавить("Склад = &Склад");
	КонецЕсли;
	Если Товары <> Неопределено Тогда
		Условия.Добавить("Товар В (&Товары)");
	КонецЕсли;
	УсловиеОстатков = СтрСоединить(Условия, " И ");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Партии.Склад КАК Склад,
	|	Партии.Товар КАК Товар,
	|	СУММА(Партии.СтоимостьОстаток) КАК Стоимость
	|ПОМЕСТИТЬ ВТСтоимость
	|ИЗ
	|	РегистрНакопления.ПартииТоваров.Остатки(, &Условие) КАК Партии
	|
	|СГРУППИРОВАТЬ ПО
	|	Партии.Склад,
	|	Партии.Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Склад КАК Склад,
	|	Остатки.Товар КАК Товар,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	ЕСТЬNULL(ВТСтоимость.Стоимость, 0) КАК Стоимость
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(, &Условие) КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСтоимость КАК ВТСтоимость
	|		ПО Остатки.Склад = ВТСтоимость.Склад
	|			И Остатки.Товар = ВТСтоимость.Товар
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Склад.Наименование,
	|	Остатки.Товар.Наименование";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, ", &Условие)", ?(ПустаяСтрока(УсловиеОстатков), ")", ", " + УсловиеОстатков + ")"));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Остатки партий по складам и товарам таблицы в порядке FIFO.
Функция ОстаткиПартий(ТаблицаТоваров)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров.Скопировать(, "Склад, Товар"));
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Склад КАК Склад,
	|	Т.Товар КАК Товар
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	&ТаблицаТоваров КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Партии.Склад КАК Склад,
	|	Партии.Товар КАК Товар,
	|	Партии.Партия КАК Партия,
	|	Партии.КоличествоОстаток КАК Количество,
	|	Партии.СтоимостьОстаток КАК Стоимость
	|ИЗ
	|	РегистрНакопления.ПартииТоваров.Остатки(
	|			,
	|			(Склад, Товар) В
	|				(ВЫБРАТЬ
	|					ВТТовары.Склад,
	|					ВТТовары.Товар
	|				ИЗ
	|					ВТТовары КАК ВТТовары)) КАК Партии
	|ГДЕ
	|	Партии.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Партии.Партия.МоментВремени";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти
