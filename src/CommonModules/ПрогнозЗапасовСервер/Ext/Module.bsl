// Прогноз дефицита: на сколько дней хватит товара и сколько заказать.
//
// Спрос в день считается по продажам за 28 дней, но последние 7 дней весят столько же,
// сколько весь месяц: если товар внезапно начали покупать чаще, прогноз реагирует сразу,
// а случайный всплеск месячной давности уже почти не влияет.
//
//   Спрос в день = (Продано за 28 дней / 28 + Продано за 7 дней / 7) / 2
//   Дней хватит  = Остаток / Спрос в день
//   Заказать     = Спрос в день × ДнейПокрытия − Остаток (округление вверх), если дней хватит меньше ДнейДоЗаказа
//
// По рекомендациям создаются черновики поступлений (не проводятся): закупщик проверяет
// количество и цену, а проводит документ, когда товар реально приехал.

#Область ПрограммныйИнтерфейс

// Прогноз по складам и товарам на дату.
//
// Параметры:
//  ДатаРасчета - Дата - на какую дату считать прогноз (продажи берутся до неё включительно).
//  Товары      - Массив, Неопределено - ограничить расчёт товарами.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Склад, Товар, Остаток, Продано28, Продано7, СпросВДень, ДнейХватит
//                    (-1, если продаж не было), ДатаИсчерпания, Заказать. Сначала то, что кончится раньше.
//
Функция Прогноз(ДатаРасчета, Товары = Неопределено) Экспорт

	Конец = КонецДня(ДатаРасчета);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало28", НачалоДня(ДатаРасчета) - 27 * 86400);
	Запрос.УстановитьПараметр("Начало7", НачалоДня(ДатаРасчета) - 6 * 86400);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("МоментОстатков", Новый Граница(Конец, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Данные.Склад КАК Склад,
	|	Данные.Товар КАК Товар,
	|	СУММА(Данные.Остаток) КАК Остаток,
	|	СУММА(Данные.Продано28) КАК Продано28,
	|	СУММА(Данные.Продано7) КАК Продано7
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.Склад КАК Склад,
	|		Остатки.Товар КАК Товар,
	|		Остатки.КоличествоОстаток КАК Остаток,
	|		0 КАК Продано28,
	|		0 КАК Продано7
	|	ИЗ
	|		РегистрНакопления.ОстаткиТоваров.Остатки(&МоментОстатков, &УсловиеТоваров) КАК Остатки
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Продажи.Склад,
	|		Продажи.Товар,
	|		0,
	|		Продажи.КоличествоОборот,
	|		0
	|	ИЗ
	|		РегистрНакопления.Продажи.Обороты(&Начало28, &Конец, , &УсловиеТоваров) КАК Продажи
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Продажи.Склад,
	|		Продажи.Товар,
	|		0,
	|		0,
	|		Продажи.КоличествоОборот
	|	ИЗ
	|		РегистрНакопления.Продажи.Обороты(&Начало7, &Конец, , &УсловиеТоваров) КАК Продажи) КАК Данные
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Склад,
	|	Данные.Товар";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеТоваров", ?(Товары = Неопределено, "", "Товар В (&Товары)"));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Склад");
	Результат.Колонки.Добавить("Товар");
	Результат.Колонки.Добавить("Остаток", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Продано28", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Продано7", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СпросВДень", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ДнейХватит", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ДатаИсчерпания");
	Результат.Колонки.Добавить("Заказать", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Строка = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.СпросВДень = Окр((Выборка.Продано28 / 28 + Выборка.Продано7 / 7) / 2, 3);

		Если Строка.СпросВДень <= 0 Тогда
			Строка.ДнейХватит = -1;
			Строка.Порядок = 999999;
			Продолжить;
		КонецЕсли;

		Строка.ДнейХватит = Окр(Макс(Строка.Остаток, 0) / Строка.СпросВДень, 1);
		Строка.ДатаИсчерпания = НачалоДня(ДатаРасчета) + Цел(Строка.ДнейХватит) * 86400;
		Строка.Порядок = Строка.ДнейХватит;
		Если Строка.ДнейХватит < ДнейДоЗаказа() Тогда
			Строка.Заказать = ОкруглитьВверх(Строка.СпросВДень * ДнейПокрытия() - Макс(Строка.Остаток, 0));
		КонецЕсли;

	КонецЦикла;

	Результат.Сортировать("Порядок");
	Результат.Колонки.Удалить("Порядок");
	Возврат Результат;

КонецФункции

// Создаёт черновики поступлений по рекомендациям прогноза: один документ на склад и поставщика.
// Поставщик и цена берутся из последнего поступления товара.
//
// Параметры:
//  ДатаРасчета - Дата
//  Товары      - Массив, Неопределено - ограничить товарами.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ПоступлениеТовара - созданные черновики.
//
Функция СоздатьЧерновикиЗаказов(ДатаРасчета, Товары = Неопределено) Экспорт

	Прогноз = Прогноз(ДатаРасчета, Товары);
	КЗаказу = Прогноз.Скопировать();
	КЗаказу.Колонки.Добавить("Поставщик");
	КЗаказу.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));

	Удалить = Новый Массив;
	Для Каждого Строка Из КЗаказу Цикл
		Если Строка.Заказать <= 0 Тогда
			Удалить.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из Удалить Цикл
		КЗаказу.Удалить(Строка);
	КонецЦикла;

	Созданные = Новый Массив;
	Если КЗаказу.Количество() = 0 Тогда
		Возврат Созданные;
	КонецЕсли;

	ПоследниеЗакупки = ПоследниеЗакупки(КЗаказу.ВыгрузитьКолонку("Товар"), ДатаРасчета);
	Для Каждого Строка Из КЗаказу Цикл
		Закупка = ПоследниеЗакупки[Строка.Товар];
		Если Закупка <> Неопределено Тогда
			Строка.Поставщик = Закупка.Поставщик;
			Строка.Цена = Закупка.Цена;
		КонецЕсли;
	КонецЦикла;

	Группы = КЗаказу.Скопировать(, "Склад, Поставщик");
	Группы.Свернуть("Склад, Поставщик");
	Для Каждого Группа Из Группы Цикл
		Документ = Документы.ПоступлениеТовара.СоздатьДокумент();
		Документ.Дата = ДатаРасчета;
		Документ.Склад = Группа.Склад;
		Документ.Поставщик = Группа.Поставщик;
		Документ.Комментарий = СтрШаблон("Автозаказ по прогнозу от %1: проверьте количество и цену, проведите при приёмке товара",
			Формат(ДатаРасчета, "ДФ=dd.MM.yyyy"));
		Для Каждого Строка Из КЗаказу.НайтиСтроки(Новый Структура("Склад, Поставщик", Группа.Склад, Группа.Поставщик)) Цикл
			СтрокаТовары = Документ.Товары.Добавить();
			СтрокаТовары.Товар = Строка.Товар;
			СтрокаТовары.Количество = Строка.Заказать;
			СтрокаТовары.Цена = Строка.Цена;
			СтрокаТовары.Сумма = Строка.Заказать * Строка.Цена;
		КонецЦикла;
		Документ.СуммаДокумента = Документ.Товары.Итог("Сумма");
		Документ.Записать(РежимЗаписиДокумента.Запись);
		Созданные.Добавить(Документ.Ссылка);
	КонецЦикла;

	Возврат Созданные;

КонецФункции

// Текст прогноза для Telegram: что кончится в ближайшие дни и сколько заказать.
Функция ТекстПрогноза(ДатаРасчета) Экспорт

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("🔮 <b>Прогноз дефицита</b> (заказ, если товара меньше чем на %1 дн.)", ДнейДоЗаказа()));

	Для Каждого СтрокаПрогноза Из Прогноз(ДатаРасчета) Цикл
		Если СтрокаПрогноза.Заказать <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Строки.Количество() > 15 Тогда
			Строки.Добавить("…и другие");
			Прервать;
		КонецЕсли;
		Состояние = ?(СтрокаПрогноза.Остаток <= 0, "уже закончился",
			СтрШаблон("осталось %1 шт., хватит на %2 дн.", ОбщегоНазначенияСервер.ФорматКоличества(СтрокаПрогноза.Остаток),
				Формат(СтрокаПрогноза.ДнейХватит, "ЧДЦ=1; ЧН=0")));
		Строки.Добавить(СтрШаблон("• %1 (%2): %3 → заказать <b>%4 шт.</b>",
			ТелеграмСервер.ЭкранироватьHTML(Строка(СтрокаПрогноза.Товар)), ТелеграмСервер.ЭкранироватьHTML(Строка(СтрокаПрогноза.Склад)),
			Состояние, ОбщегоНазначенияСервер.ФорматКоличества(СтрокаПрогноза.Заказать)));
	КонецЦикла;

	Если Строки.Количество() = 1 Тогда
		Строки.Добавить(СтрШаблон("Запасов хватит минимум на %1 дн. ✅", ДнейДоЗаказа()));
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Заказывать, если товара хватит меньше чем на столько дней (срок поставки с запасом).
Функция ДнейДоЗаказа() Экспорт
	Возврат 7;
КонецФункции

// На сколько дней продаж рассчитан заказ.
Функция ДнейПокрытия() Экспорт
	Возврат 21;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Последнее поступление каждого товара до даты: поставщик и цена.
Функция ПоследниеЗакупки(Товары, ДатаРасчета)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаРасчета));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Строки.Товар КАК Товар,
	|	МАКСИМУМ(Строки.Ссылка.Дата) КАК Дата
	|ПОМЕСТИТЬ ВТДаты
	|ИЗ
	|	Документ.ПоступлениеТовара.Товары КАК Строки
	|ГДЕ
	|	Строки.Ссылка.Проведен
	|	И Строки.Ссылка.Дата <= &Дата
	|	И Строки.Товар В (&Товары)
	|
	|СГРУППИРОВАТЬ ПО
	|	Строки.Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.Товар КАК Товар,
	|	Строки.Ссылка.Поставщик КАК Поставщик,
	|	Строки.Цена КАК Цена
	|ИЗ
	|	Документ.ПоступлениеТовара.Товары КАК Строки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДаты КАК ВТДаты
	|		ПО Строки.Товар = ВТДаты.Товар
	|			И Строки.Ссылка.Дата = ВТДаты.Дата
	|ГДЕ
	|	Строки.Ссылка.Проведен";

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Товар, Новый Структура("Поставщик, Цена", Выборка.Поставщик, Выборка.Цена));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОкруглитьВверх(Число)
	Целое = Цел(Число);
	Возврат ?(Число > Целое, Целое + 1, Целое);
КонецФункции

#КонецОбласти
