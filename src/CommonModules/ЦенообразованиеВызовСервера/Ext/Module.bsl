// Серверные вызовы ценообразования для форм. Один вызов возвращает всё нужное строке,
// чтобы форма не ходила на сервер несколько раз подряд.

#Область ПрограммныйИнтерфейс

// Цена товара на дату.
Функция ЦенаТовара(Товар, Дата) Экспорт
	Возврат ЦенообразованиеСервер.ЦенаТовара(Товар, Дата);
КонецФункции

// Цены нескольких товаров на дату (для пересчёта всех строк при смене даты).
//
// Возвращаемое значение:
//  Соответствие - ключ Товар, значение Цена.
//
Функция ЦеныТоваров(Товары, Дата) Экспорт
	Возврат ЦенообразованиеСервер.ЦеныТоваров(Товары, Дата);
КонецФункции

// Процент скидки клиента.
Функция ПроцентСкидкиКлиента(Клиент) Экспорт
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(Клиент, "ПроцентСкидки");
КонецФункции

#КонецОбласти
