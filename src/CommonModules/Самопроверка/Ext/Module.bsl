// Служебные режимы запуска из командной строки, мини-фреймворк автотестов и тестовые данные.
//
// Режимы (параметр /C при запуске 1С:Предприятия):
//   autotest;out=<txt>;junit=<xml>[;token=..;chat=..][;claude=..]  — прогон всех тестов
//   settings;token=..;chat=..[;shop=..][;claude=..][;model=..][;apikey=..]
//                                                      — настройки Telegram, Claude API, REST API и регламентных заданий
//   demo[;out=<txt>]                                   — демонстрационные данные за 2 месяца
//   import;file=<csv>[;out=<txt>]                      — загрузка товаров из CSV
//   bot;seconds=<N>                                    — работа Telegram-бота N секунд
//   botpreview;out=<txt>                               — ответы бота на все команды (без Telegram)
//   ask;q=<вопрос>;out=<txt>                           — вопрос ИИ-ассистенту с протоколом вызовов инструментов
//
// Тест — экспортная процедура без параметров в модуле из НаборыТестов().
// Список тестов модуль отдаёт функцией СписокТестов(). Упавшая проверка вызывает исключение,
// тест помечается FAIL; исключение с префиксом «SKIP:» помечает тест пропущенным.

#Область ПрограммныйИнтерфейс

// Признак служебного режима запуска.
Функция ЭтоСлужебныйРежимЗапуска(ПараметрЗапуска) Экспорт
	Режим = РежимЗапуска(ПараметрЗапуска);
	Возврат СтрРазделить("autotest,settings,demo,import,bot,botpreview,ask", ",").Найти(Режим) <> Неопределено;
КонецФункции

// Выполняет служебный режим запуска.
Процедура ВыполнитьСлужебныйРежим(ПараметрЗапуска) Экспорт

	Режим = РежимЗапуска(ПараметрЗапуска);
	Параметры = РазобратьПараметры(ПараметрЗапуска);

	Если Режим = "autotest" Тогда
		ЗапуститьАвтотест(ПараметрЗапуска);
	ИначеЕсли Режим = "settings" Тогда
		СохранитьНастройкиTelegram(ПараметрЗапуска);
	ИначеЕсли Режим = "demo" Тогда
		ЗаписатьПротокол(Параметры, ДемоДанные.Заполнить());
	ИначеЕсли Режим = "import" Тогда
		Итог = ЗагрузкаДанныхСервер.ЗагрузитьТоварыИзФайла(Параметры.file);
		ЗаписатьПротокол(Параметры, СтрШаблон("Создано: %1, обновлено: %2, цен: %3%4", Итог.Создано, Итог.Обновлено,
			Итог.ЦенУстановлено, ?(Итог.Ошибки.Количество() = 0, "", Символы.ПС + СтрСоединить(Итог.Ошибки, Символы.ПС))));
	ИначеЕсли Режим = "botpreview" Тогда
		ЗаписатьПротокол(Параметры, ОтветыБотаДляПросмотра());
	ИначеЕсли Режим = "ask" Тогда
		Диалог = ИИАссистентСервер.ВыполнитьДиалог(Параметры.q);
		ЗаписатьПротокол(Параметры, СтрШаблон("Инструменты: %1%2%3", СтрСоединить(Диалог.Инструменты, ", "), Символы.ПС, Диалог.Текст));
	ИначеЕсли Режим = "bot" Тогда
		ТелеграмБот.ЗапуститьЦиклБота(?(Параметры.Свойство("seconds"), Число(Параметры.seconds), 3600));
	КонецЕсли;

КонецПроцедуры

// Прогоняет все наборы тестов и пишет протокол (текст и JUnit XML).
//
// Возвращаемое значение:
//  Строка - текстовый протокол, первая строка RESULT: PASSED или RESULT: FAILED.
//
Функция ЗапуститьАвтотест(ПараметрыСтрокой) Экспорт

	Параметры = РазобратьПараметры(ПараметрыСтрокой);
	Если Параметры.Свойство("token") Тогда
		Константы.ТелеграмТокенБота.Установить(Параметры.token);
	КонецЕсли;
	Если Параметры.Свойство("chat") Тогда
		Константы.ТелеграмЧатИД.Установить(Параметры.chat);
	КонецЕсли;
	Если Параметры.Свойство("claude") Тогда
		Константы.ClaudeКлючAPI.Установить(Параметры.claude);
	КонецЕсли;

	Результаты = Новый ТаблицаЗначений;
	Результаты.Колонки.Добавить("Набор");
	Результаты.Колонки.Добавить("Тест");
	Результаты.Колонки.Добавить("Статус");
	Результаты.Колонки.Добавить("Сообщение");
	Результаты.Колонки.Добавить("Миллисекунд");

	Для Каждого ИмяНабора Из НаборыТестов() Цикл
		Тесты = Вычислить(ИмяНабора + ".СписокТестов()");
		Для Каждого ИмяТеста Из Тесты Цикл
			Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Результат = Результаты.Добавить();
			Результат.Набор = ИмяНабора;
			Результат.Тест = ИмяТеста;
			Попытка
				Выполнить(ИмяНабора + "." + ИмяТеста + "();");
				Результат.Статус = "OK";
			Исключение
				Текст = ТекстИсключения(ИнформацияОбОшибке());
				Если СтрНачинаетсяС(Текст, "SKIP:") Тогда
					Результат.Статус = "SKIP";
					Результат.Сообщение = СокрЛП(Сред(Текст, 6));
				Иначе
					Результат.Статус = "FAIL";
					Результат.Сообщение = Текст;
				КонецЕсли;
			КонецПопытки;
			Пока ТранзакцияАктивна() Цикл
				ОтменитьТранзакцию();
			КонецЦикла;
			Результат.Миллисекунд = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		КонецЦикла;
	КонецЦикла;

	Текст = ТекстПротокола(Результаты);
	ЗаписатьПротокол(Параметры, Текст);
	Если Параметры.Свойство("junit") Тогда
		ЗаписатьJUnit(Результаты, Параметры.junit);
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Сохраняет настройки Telegram и включает регламентные задания.
Процедура СохранитьНастройкиTelegram(ПараметрыСтрокой) Экспорт

	Параметры = РазобратьПараметры(ПараметрыСтрокой);
	Если Параметры.Свойство("token") Тогда
		Константы.ТелеграмТокенБота.Установить(Параметры.token);
	КонецЕсли;
	Если Параметры.Свойство("chat") Тогда
		Константы.ТелеграмЧатИД.Установить(Параметры.chat);
	КонецЕсли;
	Если Параметры.Свойство("shop") Тогда
		Константы.НазваниеМагазина.Установить(Параметры.shop);
	КонецЕсли;
	Если Параметры.Свойство("claude") Тогда
		Константы.ClaudeКлючAPI.Установить(Параметры.claude);
	КонецЕсли;
	Если Параметры.Свойство("model") Тогда
		Константы.ClaudeМодель.Установить(Параметры.model);
	КонецЕсли;
	Если Параметры.Свойство("apikey") Тогда
		Константы.ВебAPIКлюч.Установить(Параметры.apikey);
	КонецЕсли;
	РегламентныеЗаданияСервер.НастроитьЗаданияTelegram(ТелеграмСервер.Настроен());

КонецПроцедуры

#КонецОбласти

#Область Проверки

// Проверяет условие, при невыполнении тест падает с описанием.
Процедура Ожидать(Условие, Описание) Экспорт
	Если Условие <> Истина Тогда
		ВызватьИсключение "Не выполнено: " + Описание;
	КонецЕсли;
КонецПроцедуры

// Проверяет равенство фактического значения ожидаемому.
Процедура ОжидатьРавенство(Факт, Ожидание, Описание) Экспорт
	Если Факт <> Ожидание Тогда
		ВызватьИсключение СтрШаблон("%1: ожидалось «%2», получено «%3»", Описание, Ожидание, Факт);
	КонецЕсли;
КонецПроцедуры

// Проверяет, что строка содержит подстроку.
Процедура ОжидатьВхождение(Текст, Подстрока, Описание) Экспорт
	Если СтрНайти(Текст, Подстрока) = 0 Тогда
		ВызватьИсключение СтрШаблон("%1: в тексте нет «%2». Текст: %3", Описание, Подстрока, Лев(Текст, 300));
	КонецЕсли;
КонецПроцедуры

// Помечает тест пропущенным (например, нет доступа к внешнему сервису).
Процедура Пропустить(Причина) Экспорт
	ВызватьИсключение "SKIP: " + Причина;
КонецПроцедуры

#КонецОбласти

#Область ТестовыеДанные

// Фиксированная дата для тестов: тесты не зависят от текущей даты и не пересекаются по периодам.
Функция ДатаТеста(Смещение) Экспорт
	Возврат Дата(2025, 1, 1, 10, 0, 0) + Смещение * 86400;
КонецФункции

// Случайная дата далеко за пределами остальных тестов: для проверок «за период»,
// чтобы повторный прогон на той же базе не видел данных прошлых запусков.
Функция УникальнаяДатаТеста() Экспорт
	Генератор = Новый ГенераторСлучайныхЧисел;
	Возврат ДатаТеста(1000 + Генератор.СлучайноеЧисло(0, 50000) * 3);
КонецФункции
// Уникальная строка, чтобы тесты не мешали друг другу и демо-данным.
Функция Уникальный(Префикс) Экспорт
	Возврат Префикс + " " + Лев(Строка(Новый УникальныйИдентификатор), 8);
КонецФункции

Функция НовыйСклад() Экспорт
	Склад = Справочники.Склады.СоздатьЭлемент();
	Склад.Наименование = Уникальный("Тест склад");
	Склад.Записать();
	Возврат Склад.Ссылка;
КонецФункции

Функция НовыйТовар(Наименование, БазоваяЦена = 0) Экспорт
	Товар = Справочники.Товары.СоздатьЭлемент();
	Товар.Наименование = Уникальный(Наименование);
	Товар.Артикул = Лев(Строка(Новый УникальныйИдентификатор), 12);
	Товар.ЕдиницаИзмерения = "шт";
	Товар.Цена = БазоваяЦена;
	Товар.Записать();
	Возврат Товар.Ссылка;
КонецФункции

Функция НовыйКлиент(ПроцентСкидки = 0) Экспорт
	Клиент = Справочники.Клиенты.СоздатьЭлемент();
	Клиент.Наименование = Уникальный("Тест клиент");
	Клиент.ПроцентСкидки = ПроцентСкидки;
	Клиент.Записать();
	Возврат Клиент.Ссылка;
КонецФункции

// Проведённое поступление одного товара.
Функция Поступление(Склад, Товар, Количество, Цена, Дата) Экспорт
	Документ = Документы.ПоступлениеТовара.СоздатьДокумент();
	Документ.Дата = Дата;
	Документ.Склад = Склад;
	Строка = Документ.Товары.Добавить();
	Строка.Товар = Товар;
	Строка.Количество = Количество;
	Строка.Цена = Цена;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Документ.Ссылка;
КонецФункции

// Проведённая продажа одного товара. Скидка берётся из карточки клиента, как в форме.
Функция Продажа(Склад, Товар, Количество, Цена, Дата, Клиент = Неопределено, СУведомлением = Ложь) Экспорт
	Документ = Документы.ПродажаТовара.СоздатьДокумент();
	Документ.Заполнить(Неопределено);
	Документ.Дата = Дата;
	Документ.Склад = Склад;
	Если ЗначениеЗаполнено(Клиент) Тогда
		Документ.Клиент = Клиент;
		Документ.ПроцентСкидки = ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(Клиент, "ПроцентСкидки");
	КонецЕсли;
	Строка = Документ.Товары.Добавить();
	Строка.Товар = Товар;
	Строка.Количество = Количество;
	Строка.Цена = Цена;
	Если Не СУведомлением Тогда
		Документ.ДополнительныеСвойства.Вставить("НеОтправлятьУведомления", Истина);
	КонецЕсли;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Документ.Ссылка;
КонецФункции

// Остаток товара на складе.
Функция ОстатокТовара(Склад, Товар) Экспорт
	Остатки = УчетТоваровСервер.ТекущиеОстатки(Склад, ОбщийМассив(Товар));
	Возврат ?(Остатки.Количество() = 0, 0, Остатки.Итог("Количество"));
КонецФункции

// Стоимость остатка партий товара на складе.
Функция СтоимостьПартий(Склад, Товар) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Товар", Товар);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Партии.СтоимостьОстаток), 0) КАК Стоимость
	|ИЗ
	|	РегистрНакопления.ПартииТоваров.Остатки(, Склад = &Склад И Товар = &Товар) КАК Партии";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Стоимость;
КонецФункции

// Обороты регистра Продажи по товару (за всё время).
Функция ОборотыПродаж(Товар) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Товар", Товар);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Продажи.КоличествоОборот), 0) КАК Количество,
	|	ЕСТЬNULL(СУММА(Продажи.ВыручкаОборот), 0) КАК Выручка,
	|	ЕСТЬNULL(СУММА(Продажи.СебестоимостьОборот), 0) КАК Себестоимость
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(, , , Товар = &Товар) КАК Продажи";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Новый Структура("Количество, Выручка, Себестоимость", Выборка.Количество, Выборка.Выручка, Выборка.Себестоимость);
КонецФункции

// Выполняет отчёт с настройками по умолчанию и возвращает результат деревом значений.
Функция РезультатОтчета(ИмяОтчета, ПараметрыДанных = Неопределено) Экспорт

	Схема = Отчеты[ИмяОтчета].ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Настройки = Схема.НастройкиПоУмолчанию;
	Если ПараметрыДанных <> Неопределено Тогда
		Для Каждого КлючИЗначение Из ПараметрыДанных Цикл
			Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);

	Дерево = Новый ДеревоЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Дерево);
	Вывод.Вывести(Процессор);
	Возврат Дерево;

КонецФункции

// Выполняет отчёт в табличный документ (как его видит пользователь).
Функция ТабличныйДокументОтчета(ИмяОтчета) Экспорт

	Схема = Отчеты[ИмяОтчета].ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Схема.НастройкиПоУмолчанию);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);

	ТабДок = Новый ТабличныйДокумент;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	Вывод.УстановитьДокумент(ТабДок);
	Вывод.Вывести(Процессор);
	Возврат ТабДок;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтветыБотаДляПросмотра()
	Ответы = Новый Массив;
	Для Каждого Команда Из СтрРазделить("/help|/prodazhi|/top|/malo|/ostatki кофе|/prognoz|/health", "|") Цикл
		Ответы.Добавить("> " + Команда);
		Ответы.Добавить(ТелеграмБот.ОтветНаКоманду(Команда));
		Ответы.Добавить("");
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПродажаТовара.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПродажаТовара КАК ПродажаТовара
	|ГДЕ
	|	ПродажаТовара.Проведен
	|	И ПродажаТовара.Клиент <> ЗНАЧЕНИЕ(Справочник.Клиенты.ПустаяСсылка)
	|	И ПродажаТовара.ПроцентСкидки > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПродажаТовара.Дата УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Ответы.Добавить("> уведомление о продаже");
		Ответы.Добавить(ТелеграмСервер.ТекстУведомленияОПродаже(Выборка.Ссылка));
		Ответы.Добавить("");
	КонецЕсли;
	Ответы.Добавить("> ежедневный отчёт");
	Ответы.Добавить(ТелеграмБот.ТекстЕжедневногоОтчета(ТекущаяДатаСеанса()));
	Возврат СтрСоединить(Ответы, Символы.ПС);
КонецФункции
Функция НаборыТестов()
	Возврат СтрРазделить("ТестыУчетаТоваров,ТестыЦенИОтчетов,ТестыИнтеграций,ТестыНовыхВозможностей", ",");
КонецФункции

Функция РежимЗапуска(ПараметрЗапуска)
	Возврат НРег(СокрЛП(СтрРазделить(ПараметрЗапуска + ";", ";")[0]));
КонецФункции

Функция РазобратьПараметры(ПараметрыСтрокой)
	Результат = Новый Структура;
	Для Каждого Часть Из СтрРазделить(ПараметрыСтрокой, ";", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция > 0 Тогда
			Результат.Вставить(СокрЛП(Лев(Часть, Позиция - 1)), СокрЛП(Сред(Часть, Позиция + 1)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ОбщийМассив(Значение)
	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;
КонецФункции

// Текст исключения без служебных обёрток платформы: самая глубокая причина.
Функция ТекстИсключения(Информация)
	Текущая = Информация;
	Пока Текущая.Причина <> Неопределено Цикл
		Текущая = Текущая.Причина;
	КонецЦикла;
	Текст = СокрЛП(Текущая.Описание);
	Если ПустаяСтрока(Текст) Тогда
		Текст = ПодробноеПредставлениеОшибки(Информация);
	КонецЕсли;
	Если Текущая.НомерСтроки > 0 И Не СтрНачинаетсяС(Текст, "SKIP:") Тогда
		Текст = Текст + СтрШаблон(" [%1, строка %2]", Текущая.ИмяМодуля, Текущая.НомерСтроки);
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ТекстПротокола(Результаты)

	Всего = Результаты.Количество();
	Упало = Результаты.НайтиСтроки(Новый Структура("Статус", "FAIL")).Количество();
	Пропущено = Результаты.НайтиСтроки(Новый Структура("Статус", "SKIP")).Количество();

	Строки = Новый Массив;
	Строки.Добавить(?(Упало = 0, "RESULT: PASSED", "RESULT: FAILED"));
	Строки.Добавить(СтрШаблон("Тестов: %1, успешно: %2, пропущено: %3, ошибок: %4",
		Всего, Всего - Упало - Пропущено, Пропущено, Упало));
	Строки.Добавить("");
	Для Каждого Результат Из Результаты Цикл
		Строки.Добавить(СтрШаблон("%1 %2.%3 (%4 мс)%5", Лев(Результат.Статус + "    ", 4), Результат.Набор, Результат.Тест,
			Формат(Результат.Миллисекунд, "ЧН=0; ЧГ=0"), ?(ПустаяСтрока(Результат.Сообщение), "", Символы.ПС + "     " + Результат.Сообщение)));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ЗаписатьJUnit(Результаты, ИмяФайла)

	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ИмяФайла, "UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("testsuites");

	Наборы = Результаты.Скопировать(, "Набор");
	Наборы.Свернуть("Набор");
	Для Каждого Набор Из Наборы Цикл
		Тесты = Результаты.НайтиСтроки(Новый Структура("Набор", Набор.Набор));
		Упало = 0;
		Пропущено = 0;
		Миллисекунд = 0;
		Для Каждого Тест Из Тесты Цикл
			Упало = Упало + ?(Тест.Статус = "FAIL", 1, 0);
			Пропущено = Пропущено + ?(Тест.Статус = "SKIP", 1, 0);
			Миллисекунд = Миллисекунд + Тест.Миллисекунд;
		КонецЦикла;

		Запись.ЗаписатьНачалоЭлемента("testsuite");
		Запись.ЗаписатьАтрибут("name", Набор.Набор);
		Запись.ЗаписатьАтрибут("tests", Формат(Тесты.Количество(), "ЧН=0; ЧГ=0"));
		Запись.ЗаписатьАтрибут("failures", Формат(Упало, "ЧН=0; ЧГ=0"));
		Запись.ЗаписатьАтрибут("skipped", Формат(Пропущено, "ЧН=0; ЧГ=0"));
		Запись.ЗаписатьАтрибут("time", Формат(Миллисекунд / 1000, "ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=0"));

		Для Каждого Тест Из Тесты Цикл
			Запись.ЗаписатьНачалоЭлемента("testcase");
			Запись.ЗаписатьАтрибут("classname", Тест.Набор);
			Запись.ЗаписатьАтрибут("name", Тест.Тест);
			Запись.ЗаписатьАтрибут("time", Формат(Тест.Миллисекунд / 1000, "ЧДЦ=3; ЧРД=.; ЧН=0; ЧГ=0"));
			Если Тест.Статус = "FAIL" Тогда
				Запись.ЗаписатьНачалоЭлемента("failure");
				Запись.ЗаписатьАтрибут("message", Тест.Сообщение);
				Запись.ЗаписатьКонецЭлемента();
			ИначеЕсли Тест.Статус = "SKIP" Тогда
				Запись.ЗаписатьНачалоЭлемента("skipped");
				Запись.ЗаписатьАтрибут("message", Тест.Сообщение);
				Запись.ЗаписатьКонецЭлемента();
			КонецЕсли;
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;

		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;

	Запись.ЗаписатьКонецЭлемента();
	Запись.Закрыть();

КонецПроцедуры

Процедура ЗаписатьПротокол(Параметры, Текст)
	Если Параметры.Свойство("out") Тогда
		Документ = Новый ТекстовыйДокумент;
		Документ.УстановитьТекст(Текст);
		Документ.Записать(Параметры.out, КодировкаТекста.UTF8);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
