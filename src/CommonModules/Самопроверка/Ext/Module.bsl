// Автотест: создаёт демо-данные, проводит поступление и продажи,
// проверяет контроль остатков и отправку уведомления в Telegram.
// Запуск: 1cv8 ENTERPRISE /F <база> /C "autotest;out=<файл протокола>[;token=...;chat=...]"

Функция ЗапуститьАвтотест(ПараметрыСтрокой) Экспорт

	Параметры = РазобратьПараметры(ПараметрыСтрокой);
	Протокол = Новый Массив;
	Успех = Истина;

	Если Параметры.Свойство("token") Тогда
		Константы.ТелеграмТокенБота.Установить(Параметры.token);
	КонецЕсли;
	Если Параметры.Свойство("chat") Тогда
		Константы.ТелеграмЧатИД.Установить(Параметры.chat);
	КонецЕсли;

	Попытка

		Кофе = НайтиИлиСоздатьТовар("Кофе в зёрнах 250 г", 450);
		Чай = НайтиИлиСоздатьТовар("Чай зелёный", 300);
		Клиент = НайтиИлиСоздатьКлиента("Иванов Иван", "+7 900 000-00-00");

		НачальныйОстатокКофе = Остаток(Кофе);
		НачальныйОстатокЧай = Остаток(Чай);

		Поступление = Документы.ПоступлениеТовара.СоздатьДокумент();
		Поступление.Дата = ТекущаяДатаСеанса();
		ДобавитьСтроку(Поступление, Кофе, 5, 300);
		ДобавитьСтроку(Поступление, Чай, 3, 200);
		Поступление.Записать(РежимЗаписиДокумента.Проведение);
		Протокол.Добавить("OK  Поступление проведено: кофе 5, чай 3");

		Продажа = Документы.ПродажаТовара.СоздатьДокумент();
		Продажа.Дата = ТекущаяДатаСеанса();
		Продажа.Клиент = Клиент;
		ДобавитьСтроку(Продажа, Кофе, 2, 450);
		ДобавитьСтроку(Продажа, Чай, 1, 300);
		Продажа.Записать(РежимЗаписиДокумента.Проведение);
		Протокол.Добавить(СтрШаблон("OK  Продажа проведена на %1 руб.", Продажа.СуммаДокумента));

		Если Продажа.СуммаДокумента <> 1200 Тогда
			Успех = Ложь;
			Протокол.Добавить("FAIL Сумма продажи должна быть 1200");
		КонецЕсли;

		ЛишняяПродажа = Документы.ПродажаТовара.СоздатьДокумент();
		ЛишняяПродажа.Дата = ТекущаяДатаСеанса();
		ДобавитьСтроку(ЛишняяПродажа, Кофе, НачальныйОстатокКофе + 100, 450);
		Попытка
			ЛишняяПродажа.Записать(РежимЗаписиДокумента.Проведение);
			Успех = Ложь;
			Протокол.Добавить("FAIL Продажа сверх остатка провелась, а не должна");
		Исключение
			Протокол.Добавить("OK  Продажа сверх остатка не провелась (контроль остатков работает)");
		КонецПопытки;

		ОстатокКофе = Остаток(Кофе) - НачальныйОстатокКофе;
		ОстатокЧай = Остаток(Чай) - НачальныйОстатокЧай;
		Если ОстатокКофе = 3 И ОстатокЧай = 2 Тогда
			Протокол.Добавить("OK  Остатки изменились верно: кофе +3, чай +2");
		Иначе
			Успех = Ложь;
			Протокол.Добавить(СтрШаблон("FAIL Остатки: кофе %1, чай %2 (ждали 3 и 2)", ОстатокКофе, ОстатокЧай));
		КонецЕсли;

		Если ЗначениеЗаполнено(Константы.ТелеграмТокенБота.Получить()) Тогда
			Если ТелеграмСервер.УведомитьОПродаже(Продажа.Ссылка) Тогда
				Протокол.Добавить("OK  Уведомление о продаже отправлено в Telegram");
			Иначе
				Успех = Ложь;
				Протокол.Добавить("FAIL Telegram не принял сообщение (см. журнал регистрации)");
			КонецЕсли;
		Иначе
			Протокол.Добавить("SKIP Токен Telegram не задан, уведомление не проверялось");
		КонецЕсли;

	Исключение
		Успех = Ложь;
		Протокол.Добавить("FAIL Ошибка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Протокол.Вставить(0, ?(Успех, "RESULT: PASSED", "RESULT: FAILED"));
	Текст = СтрСоединить(Протокол, Символы.ПС);

	Если Параметры.Свойство("out") Тогда
		Документ = Новый ТекстовыйДокумент;
		Документ.УстановитьТекст(Текст);
		Документ.Записать(Параметры.out, КодировкаТекста.UTF8);
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Сохраняет настройки Telegram без создания демо-данных.
// Запуск: 1cv8 ENTERPRISE /F <база> /C "settings;token=...;chat=..."
Процедура СохранитьНастройкиTelegram(ПараметрыСтрокой) Экспорт
	Параметры = РазобратьПараметры(ПараметрыСтрокой);
	Если Параметры.Свойство("token") Тогда
		Константы.ТелеграмТокенБота.Установить(Параметры.token);
	КонецЕсли;
	Если Параметры.Свойство("chat") Тогда
		Константы.ТелеграмЧатИД.Установить(Параметры.chat);
	КонецЕсли;
КонецПроцедуры

Функция РазобратьПараметры(ПараметрыСтрокой)
	Результат = Новый Структура;
	Для Каждого Часть Из СтрРазделить(ПараметрыСтрокой, ";", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция > 0 Тогда
			Результат.Вставить(СокрЛП(Лев(Часть, Позиция - 1)), СокрЛП(Сред(Часть, Позиция + 1)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиИлиСоздатьТовар(Наименование, Цена)
	Ссылка = Справочники.Товары.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Товар = Справочники.Товары.СоздатьЭлемент();
	Товар.Наименование = Наименование;
	Товар.Цена = Цена;
	Товар.Записать();
	Возврат Товар.Ссылка;
КонецФункции

Функция НайтиИлиСоздатьКлиента(Наименование, Телефон)
	Ссылка = Справочники.Клиенты.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Клиент = Справочники.Клиенты.СоздатьЭлемент();
	Клиент.Наименование = Наименование;
	Клиент.Телефон = Телефон;
	Клиент.Записать();
	Возврат Клиент.Ссылка;
КонецФункции

Процедура ДобавитьСтроку(Документ, Товар, Количество, Цена)
	Строка = Документ.Товары.Добавить();
	Строка.Товар = Товар;
	Строка.Количество = Количество;
	Строка.Цена = Цена;
КонецПроцедуры

Функция Остаток(Товар)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ОстаткиТоваровОстатки.КоличествоОстаток), 0) КАК Остаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(, Товар = &Товар) КАК ОстаткиТоваровОстатки";
	Запрос.УстановитьПараметр("Товар", Товар);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Остаток;
КонецФункции
