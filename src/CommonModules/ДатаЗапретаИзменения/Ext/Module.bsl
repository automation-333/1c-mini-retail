// Дата запрета изменения: закрытый период нельзя менять задним числом.
// Обработчик подписки ПроверкаДатыЗапретаИзменения на событие ПередЗаписью всех документов.

#Область ПрограммныйИнтерфейс

// Отказывает в записи, если документ находится или находился в закрытом периоде.
// Проверяется и новая дата, и дата в базе: иначе документ можно было бы
// «вытащить» из закрытого периода, просто поменяв ему дату.
Процедура ПроверитьДатуЗапретаПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ДатаЗапрета = Константы.ДатаЗапретаИзменения.Получить();
	Если Не ЗначениеЗаполнено(ДатаЗапрета) Тогда
		Возврат;
	КонецЕсли;
	Граница = КонецДня(ДатаЗапрета);

	ДатаВБазе = Неопределено;
	Если Не Источник.ЭтоНовый() Тогда
		ДатаВБазе = ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "Дата");
	КонецЕсли;

	Запрещено = (ЗначениеЗаполнено(Источник.Дата) И Источник.Дата <= Граница)
		Или (ЗначениеЗаполнено(ДатаВБазе) И ДатаВБазе <= Граница);

	Если Запрещено Тогда
		ОбщегоНазначенияСервер.СообщитьПользователю(
			СтрШаблон("Период по %1 закрыт: документы с датой не позже этой изменять нельзя.", Формат(ДатаЗапрета, "ДЛФ=D")),
			Источник, "Дата", Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
