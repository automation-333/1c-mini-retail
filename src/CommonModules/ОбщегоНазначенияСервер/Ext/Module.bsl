#Область ПрограммныйИнтерфейс

// Выводит сообщение пользователю и при необходимости устанавливает признак отказа.
//
// Параметры:
//  Текст  - Строка - текст сообщения.
//  Объект - ЛюбаяСсылка, ДокументОбъект - объект, к которому относится сообщение.
//  Поле   - Строка - путь к полю, например "Товары[0].Количество".
//  Отказ  - Булево - выходной параметр, устанавливается в Истина.
//
Процедура СообщитьПользователю(Текст, Объект = Неопределено, Поле = "", Отказ = Ложь) Экспорт

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Если Объект <> Неопределено Тогда
		Сообщение.УстановитьДанные(Объект);
	КонецЕсли;
	Если ЗначениеЗаполнено(Поле) Тогда
		Сообщение.Поле = Поле;
	КонецЕсли;
	Сообщение.Сообщить();

	Отказ = Истина;

КонецПроцедуры

// Возвращает значения реквизитов объекта одним запросом.
//
// Параметры:
//  Ссылка          - ЛюбаяСсылка - объект, реквизиты которого нужно получить.
//  ИменаРеквизитов - Строка - имена через запятую, например "Дата, Склад".
//
// Возвращаемое значение:
//  Структура - ключи совпадают с именами реквизитов.
//
Функция ЗначенияРеквизитовОбъекта(Ссылка, ИменаРеквизитов) Экспорт

	Результат = Новый Структура(ИменаРеквизитов);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого КлючИЗначение Из Результат Цикл
		Поля.Добавить(СтрШаблон("Т.%1 КАК %1", КлючИЗначение.Ключ));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ %1 ИЗ %2 КАК Т ГДЕ Т.Ссылка = &Ссылка",
		СтрСоединить(Поля, ", "), Ссылка.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает значение одного реквизита объекта.
Функция ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита) Экспорт
	Возврат ЗначенияРеквизитовОбъекта(Ссылка, ИмяРеквизита)[ИмяРеквизита];
КонецФункции

// Форматирует сумму для вывода в тексты: "12 345,50".
Функция ФорматСуммы(Сумма) Экспорт
	Возврат Формат(Сумма, "ЧДЦ=2; ЧРД=,; ЧРГ=' '; ЧН=0,00; ЧГ=3,0");
КонецФункции

// Форматирует количество: "12".
Функция ФорматКоличества(Количество) Экспорт
	Возврат Формат(Количество, "ЧДЦ=0; ЧН=0; ЧГ=0");
КонецФункции

// Признак, что у объекта при записи установлено дополнительное свойство с истинным значением.
Функция ДополнительноеСвойство(Объект, ИмяСвойства) Экспорт
	Значение = Неопределено;
	Возврат Объект.ДополнительныеСвойства.Свойство(ИмяСвойства, Значение) И Значение = Истина;
КонецФункции

#КонецОбласти
