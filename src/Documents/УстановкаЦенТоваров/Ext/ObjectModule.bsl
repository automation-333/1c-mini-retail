#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Один товар в документе цен должен встречаться один раз, иначе непонятно, какая цена верная.
	Встречались = Новый Соответствие;
	Для Каждого СтрокаТовары Из Товары Цикл
		Если Встречались[СтрокаТовары.Товар] <> Неопределено Тогда
			ОбщегоНазначенияСервер.СообщитьПользователю(
				СтрШаблон("Товар ""%1"" указан повторно в строке %2", СтрокаТовары.Товар, СтрокаТовары.НомерСтроки),
				ЭтотОбъект, СтрШаблон("Товары[%1].Товар", СтрокаТовары.НомерСтроки - 1), Отказ);
		КонецЕсли;
		Встречались.Вставить(СтрокаТовары.Товар, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ЦеныТоваров.Записывать = Истина;
	Для Каждого СтрокаТовары Из Товары Цикл
		Запись = Движения.ЦеныТоваров.Добавить();
		Запись.Период = Дата;
		Запись.Товар = СтрокаТовары.Товар;
		Запись.Цена = СтрокаТовары.Цена;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
