#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет возврат по документу продажи: товары, которые ещё не вернули, по цене продажи.
Процедура ЗаполнитьПоПродаже(Продажа) Экспорт

	Реквизиты = ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта(Продажа, "Склад, Клиент, СпособОплаты");
	ДокументПродажи = Продажа;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Реквизиты);

	Товары.Очистить();
	Для Каждого Строка Из ДоступноКВозврату() Цикл
		СтрокаТовары = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТовары, Строка);
		СтрокаТовары.Сумма = СтрокаТовары.Количество * СтрокаТовары.Цена;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	// Ввод на основании продажи.
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПродажаТовара") Тогда
		ЗаполнитьПоПродаже(ДанныеЗаполнения);
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТовары Из Товары Цикл
		СтрокаТовары.Сумма = СтрокаТовары.Количество * СтрокаТовары.Цена;
	КонецЦикла;
	СуммаДокумента = Товары.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Проверка в проведении, а не в ОбработкаПроверкиЗаполнения: она должна срабатывать
	// и при записи документа кодом (загрузка, обмен), а не только из формы.
	ПроверитьКоличествоКВозврату(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	УчетТоваровСервер.ОчиститьДвижения(Движения);

	ТаблицаТоваров = УчетТоваровСервер.ТаблицаТоваровДокумента(Товары, Склад);
	УчетТоваровСервер.ЗаблокироватьТовары(ТаблицаТоваров);
	УчетТоваровСервер.ДобавитьДвиженияОстатков(Движения.ОстаткиТоваров, ВидДвиженияНакопления.Приход, Дата, ТаблицаТоваров);

	// Возвращённый товар приходует новой партией по той себестоимости, по которой его продали.
	СебестоимостьЕдиницы = СебестоимостьЕдиницыПоПродаже();

	Движения.ПартииТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	Для Каждого СтрокаТовары Из Товары Цикл
		Если СтрокаТовары.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЦенаСебестоимости = СебестоимостьЕдиницы[СтрокаТовары.Товар];
		Себестоимость = Окр(?(ЦенаСебестоимости = Неопределено, 0, ЦенаСебестоимости) * СтрокаТовары.Количество, 2);

		Партия = Движения.ПартииТоваров.ДобавитьПриход();
		Партия.Период = Дата;
		Партия.Склад = Склад;
		Партия.Товар = СтрокаТовары.Товар;
		Партия.Партия = Ссылка;
		Партия.Количество = СтрокаТовары.Количество;
		Партия.Стоимость = Себестоимость;

		// Возврат уменьшает продажи: обороты с минусом.
		Продажа = Движения.Продажи.Добавить();
		Продажа.Период = Дата;
		Продажа.Склад = Склад;
		Продажа.Товар = СтрокаТовары.Товар;
		Продажа.Клиент = Клиент;
		Продажа.СпособОплаты = СпособОплаты;
		Продажа.Количество = -СтрокаТовары.Количество;
		Продажа.Выручка = -СтрокаТовары.Сумма;
		Продажа.Себестоимость = -Себестоимость;
	КонецЦикла;

	Движения.Записать();
	УчетТоваровСервер.ПроверитьОтрицательныеОстатки(ТаблицаТоваров, Отказ, ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	ТаблицаТоваров = УчетТоваровСервер.ТаблицаТоваровДокумента(Товары, Склад);
	УчетТоваровСервер.ЗаблокироватьТовары(ТаблицаТоваров);
	УчетТоваровСервер.ОчиститьДвижения(Движения);
	УчетТоваровСервер.ПроверитьОтрицательныеОстатки(ТаблицаТоваров, Отказ, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Нельзя вернуть больше, чем продали, с учётом уже проведённых возвратов по этой продаже.
Процедура ПроверитьКоличествоКВозврату(Отказ)

	Если Не ЗначениеЗаполнено(ДокументПродажи) Тогда
		Возврат;
	КонецЕсли;

	Доступно = ДоступноКВозврату();
	Возвращаем = Товары.Выгрузить(, "Товар, Количество");
	Возвращаем.Свернуть("Товар", "Количество");

	Для Каждого Строка Из Возвращаем Цикл
		СтрокаДоступно = Доступно.Найти(Строка.Товар, "Товар");
		МожноВернуть = ?(СтрокаДоступно = Неопределено, 0, СтрокаДоступно.Количество);
		Если Строка.Количество > МожноВернуть Тогда
			ОбщегоНазначенияСервер.СообщитьПользователю(
				СтрШаблон("Товар ""%1"": к возврату %2 шт., а по продаже можно вернуть не больше %3 шт.",
					Строка.Товар, Строка.Количество, МожноВернуть),
				ЭтотОбъект, "Товары", Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Сколько каждого товара ещё можно вернуть по продаже и по какой цене (с учётом скидки).
Функция ДоступноКВозврату()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Продажа", ДокументПродажи);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПродажаТовары.Товар КАК Товар,
	|	СУММА(ПродажаТовары.Количество) КАК Количество,
	|	СУММА(ПродажаТовары.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТПродано
	|ИЗ
	|	Документ.ПродажаТовара.Товары КАК ПродажаТовары
	|ГДЕ
	|	ПродажаТовары.Ссылка = &Продажа
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажаТовары.Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВозвратТовары.Товар КАК Товар,
	|	СУММА(ВозвратТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТВозвращено
	|ИЗ
	|	Документ.ВозвратОтПокупателя.Товары КАК ВозвратТовары
	|ГДЕ
	|	ВозвратТовары.Ссылка.ДокументПродажи = &Продажа
	|	И ВозвратТовары.Ссылка.Проведен
	|	И ВозвратТовары.Ссылка <> &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВозвратТовары.Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Продано.Товар КАК Товар,
	|	Продано.Количество - ЕСТЬNULL(Возвращено.Количество, 0) КАК Количество,
	|	ВЫРАЗИТЬ(Продано.Сумма / Продано.Количество КАК ЧИСЛО(15, 2)) КАК Цена
	|ИЗ
	|	ВТПродано КАК Продано
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВозвращено КАК Возвращено
	|		ПО Продано.Товар = Возвращено.Товар
	|ГДЕ
	|	Продано.Количество > 0
	|	И Продано.Количество - ЕСТЬNULL(Возвращено.Количество, 0) > 0";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Себестоимость единицы каждого товара по движениям продажи.
Функция СебестоимостьЕдиницыПоПродаже()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Продажа", ДокументПродажи);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Продажи.Товар КАК Товар,
	|	СУММА(Продажи.Количество) КАК Количество,
	|	СУММА(Продажи.Себестоимость) КАК Себестоимость
	|ИЗ
	|	РегистрНакопления.Продажи КАК Продажи
	|ГДЕ
	|	Продажи.Регистратор = &Продажа
	|
	|СГРУППИРОВАТЬ ПО
	|	Продажи.Товар";

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Количество <> 0 Тогда
			Результат.Вставить(Выборка.Товар, Выборка.Себестоимость / Выборка.Количество);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
