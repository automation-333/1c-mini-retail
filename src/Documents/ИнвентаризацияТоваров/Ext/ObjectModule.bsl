#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет табличную часть текущими остатками склада. Фактическое количество
// изначально равно учётному: кладовщик меняет только расхождения.
Процедура ЗаполнитьПоОстаткам() Экспорт

	Товары.Очистить();
	Для Каждого Остаток Из УчетТоваровСервер.ТекущиеОстатки(Склад) Цикл
		Если Остаток.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТовары = Товары.Добавить();
		СтрокаТовары.Товар = Остаток.Товар;
		СтрокаТовары.КоличествоУчет = Остаток.Количество;
		СтрокаТовары.КоличествоФакт = Остаток.Количество;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Константы.ОсновнойСклад.Получить();
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТовары Из Товары Цикл
		СтрокаТовары.Отклонение = СтрокаТовары.КоличествоФакт - СтрокаТовары.КоличествоУчет;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	УчетТоваровСервер.ОчиститьДвижения(Движения);

	Излишки = УчетТоваровСервер.НоваяТаблицаТоваров();
	Недостачи = УчетТоваровСервер.НоваяТаблицаТоваров();
	Для Каждого СтрокаТовары Из Товары Цикл
		Если СтрокаТовары.Отклонение = 0 Тогда
			Продолжить;
		КонецЕсли;
		Таблица = ?(СтрокаТовары.Отклонение > 0, Излишки, Недостачи);
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.НомерСтроки = СтрокаТовары.НомерСтроки;
		НоваяСтрока.Склад = Склад;
		НоваяСтрока.Товар = СтрокаТовары.Товар;
		НоваяСтрока.Количество = ?(СтрокаТовары.Отклонение > 0, СтрокаТовары.Отклонение, -СтрокаТовары.Отклонение);
	КонецЦикла;

	ВсеТовары = Излишки.Скопировать();
	Для Каждого Строка Из Недостачи Цикл
		ЗаполнитьЗначенияСвойств(ВсеТовары.Добавить(), Строка);
	КонецЦикла;
	УчетТоваровСервер.ЗаблокироватьТовары(ВсеТовары);

	УчетТоваровСервер.ДобавитьДвиженияОстатков(Движения.ОстаткиТоваров, ВидДвиженияНакопления.Приход, Дата, Излишки);
	УчетТоваровСервер.ДобавитьДвиженияОстатков(Движения.ОстаткиТоваров, ВидДвиженияНакопления.Расход, Дата, Недостачи);
	Движения.ОстаткиТоваров.Записать();
	Движения.ОстаткиТоваров.Записывать = Ложь;
	УчетТоваровСервер.ПроверитьОтрицательныеОстатки(Недостачи, Отказ, ЭтотОбъект);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// Недостача списывается по FIFO, излишки приходуют новой партией по цене оценки.
	УчетТоваровСервер.СписатьПартииFIFO(Движения.ПартииТоваров, Дата, Недостачи, Отказ, ЭтотОбъект);

	ЦеныОценки = ЦенообразованиеСервер.ЦеныТоваров(Излишки.ВыгрузитьКолонку("Товар"), Дата);
	Для Каждого Строка Из Излишки Цикл
		Цена = Товары[Строка.НомерСтроки - 1].Цена;
		Если Цена = 0 Тогда
			Цена = ЦеныОценки[Строка.Товар];
		КонецЕсли;
		Движение = Движения.ПартииТоваров.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Склад = Склад;
		Движение.Товар = Строка.Товар;
		Движение.Партия = Ссылка;
		Движение.Количество = Строка.Количество;
		Движение.Стоимость = Окр(?(Цена = Неопределено, 0, Цена) * Строка.Количество, 2);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
