#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Константы.ОсновнойСклад.Получить();
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Для Каждого СтрокаТовары Из Товары Цикл
		Если СтрокаТовары.Количество <= 0 Тогда
			ОбщегоНазначенияСервер.СообщитьПользователю(
				СтрШаблон("В строке %1 не указано количество", СтрокаТовары.НомерСтроки),
				ЭтотОбъект, СтрШаблон("Товары[%1].Количество", СтрокаТовары.НомерСтроки - 1), Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТовары Из Товары Цикл
		СтрокаТовары.Сумма = СтрокаТовары.Количество * СтрокаТовары.Цена;
	КонецЦикла;
	СуммаДокумента = Товары.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	УчетТоваровСервер.ОчиститьДвижения(Движения);

	ТаблицаТоваров = УчетТоваровСервер.ТаблицаТоваровДокумента(Товары, Склад);
	УчетТоваровСервер.ЗаблокироватьТовары(ТаблицаТоваров);
	УчетТоваровСервер.ДобавитьДвиженияОстатков(Движения.ОстаткиТоваров, ВидДвиженияНакопления.Приход, Дата, ТаблицаТоваров);

	// Каждая строка поступления становится партией: по ней потом считается себестоимость продаж (FIFO).
	Движения.ПартииТоваров.Записывать = Истина;
	Для Каждого СтрокаТовары Из Товары Цикл
		Если СтрокаТовары.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Движение = Движения.ПартииТоваров.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Склад = Склад;
		Движение.Товар = СтрокаТовары.Товар;
		Движение.Партия = Ссылка;
		Движение.Количество = СтрокаТовары.Количество;
		Движение.Стоимость = СтрокаТовары.Сумма;
	КонецЦикла;

	// При перепроведении с меньшим количеством товар мог уже быть продан: проверяем минусы.
	Движения.Записать();
	УчетТоваровСервер.ПроверитьОтрицательныеОстатки(ТаблицаТоваров, Отказ, ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	// Нельзя отменить поступление товара, который уже продан или перемещён.
	ТаблицаТоваров = УчетТоваровСервер.ТаблицаТоваровДокумента(Товары, Склад);
	УчетТоваровСервер.ЗаблокироватьТовары(ТаблицаТоваров);
	УчетТоваровСервер.ОчиститьДвижения(Движения);
	УчетТоваровСервер.ПроверитьОтрицательныеОстатки(ТаблицаТоваров, Отказ, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
