#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	// Документ при проведении поставил уведомление в очередь; отправляем сразу,
	// не дожидаясь регламентного задания.
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ОтправитьОчередьУведомлений();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)

	Объект.ПроцентСкидки = ЦенообразованиеВызовСервера.ПроцентСкидкиКлиента(Объект.Клиент);
	ПересчитатьВсеСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ПроцентСкидкиПриИзменении(Элемент)

	ПересчитатьВсеСтроки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыТоварПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	ТекущиеДанные.Цена = ЦенообразованиеВызовСервера.ЦенаТовара(ТекущиеДанные.Товар, Объект.Дата);
	Если ТекущиеДанные.Количество = 0 Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;
	РассчитатьСуммуСтроки(ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)

	РассчитатьСуммуСтроки(Элементы.Товары.ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)

	РассчитатьСуммуСтроки(Элементы.Товары.ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)

	РассчитатьИтог();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПечатьЧека(Команда)

	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		ПоказатьПредупреждение(, "Запишите документ перед печатью чека.");
		Возврат;
	КонецЕсли;

	ТабличныйДокумент = ПечатьВызовСервера.ЧекПродажи(Объект.Ссылка);
	ТабличныйДокумент.Показать("Чек № " + СокрЛП(Объект.Номер));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сумма строки считается так же, как в модуле объекта (ЦенообразованиеСервер.СуммаСоСкидкой),
// здесь — для мгновенного отклика без вызова сервера.
&НаКлиенте
Процедура РассчитатьСуммуСтроки(СтрокаТаблицы)

	СтрокаТаблицы.Сумма = Окр(СтрокаТаблицы.Количество * СтрокаТаблицы.Цена * (100 - Объект.ПроцентСкидки) / 100, 2);
	РассчитатьИтог();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВсеСтроки()

	Для Каждого СтрокаТаблицы Из Объект.Товары Цикл
		СтрокаТаблицы.Сумма = Окр(СтрокаТаблицы.Количество * СтрокаТаблицы.Цена * (100 - Объект.ПроцентСкидки) / 100, 2);
	КонецЦикла;
	РассчитатьИтог();

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИтог()

	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма");

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтправитьОчередьУведомлений()

	ТелеграмСервер.ОтправитьОчередьУведомлений(10);

КонецПроцедуры

#КонецОбласти
