#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Пересчитываем суммы и здесь, а не только в форме:
	// документ могут записать кодом, и тогда форма не участвует.
	Для Каждого СтрокаТовары Из Товары Цикл
		СтрокаТовары.Сумма = СтрокаТовары.Количество * СтрокаТовары.Цена;
	КонецЦикла;
	СуммаДокумента = Товары.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Блокируем остатки товаров документа, чтобы два кассира
	// одновременно не продали один и тот же последний товар.
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиТоваров");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Товары;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Товар", "Товар");
	Блокировка.Заблокировать();

	Движения.ОстаткиТоваров.Записывать = Истина;

	Для Каждого СтрокаТовары Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.ДобавитьРасход();
		Движение.Период = Дата;
		Движение.Товар = СтрокаТовары.Товар;
		Движение.Количество = СтрокаТовары.Количество;
	КонецЦикла;

	Движения.Записать();

	// Контроль остатков после записи движений: если где-то ушли в минус,
	// значит товара не хватает и проводить продажу нельзя.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиТоваровОстатки.Товар КАК Товар,
	|	-ОстаткиТоваровОстатки.КоличествоОстаток КАК Нехватка
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(, Товар В (&Товары)) КАК ОстаткиТоваровОстатки
	|ГДЕ
	|	ОстаткиТоваровОстатки.КоличествоОстаток < 0";
	Запрос.УстановитьПараметр("Товары", Товары.ВыгрузитьКолонку("Товар"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("Не хватает товара ""%1"": %2 шт.", Выборка.Товар, Выборка.Нехватка);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры

#КонецЕсли
