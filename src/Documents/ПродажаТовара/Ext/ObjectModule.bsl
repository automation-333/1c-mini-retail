#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = Константы.ОсновнойСклад.Получить();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СпособОплаты) Тогда
		СпособОплаты = Перечисления.СпособыОплаты.Наличные;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Для Каждого СтрокаТовары Из Товары Цикл
		Если СтрокаТовары.Количество <= 0 Тогда
			ОбщегоНазначенияСервер.СообщитьПользователю(
				СтрШаблон("В строке %1 не указано количество", СтрокаТовары.НомерСтроки),
				ЭтотОбъект, СтрШаблон("Товары[%1].Количество", СтрокаТовары.НомерСтроки - 1), Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Суммы пересчитываются и здесь, а не только в форме:
	// документ могут записать кодом (загрузка, обмен), и тогда форма не участвует.
	Для Каждого СтрокаТовары Из Товары Цикл
		СтрокаТовары.Сумма = ЦенообразованиеСервер.СуммаСоСкидкой(
			СтрокаТовары.Количество, СтрокаТовары.Цена, ПроцентСкидки);
	КонецЦикла;
	СуммаДокумента = Товары.Итог("Сумма");

	// Уведомление отправляем только при первом проведении, а не при каждом перепроведении.
	БылПроведен = Не ЭтоНовый() И ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен") = Истина;
	ДополнительныеСвойства.Вставить("БылПроведен", БылПроведен);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	УчетТоваровСервер.ОчиститьДвижения(Движения);

	ТаблицаТоваров = УчетТоваровСервер.ТаблицаТоваровДокумента(Товары, Склад);
	УчетТоваровСервер.ЗаблокироватьТовары(ТаблицаТоваров);

	// 1. Остатки: записываем расход и сразу проверяем, хватает ли товара.
	УчетТоваровСервер.ДобавитьДвиженияОстатков(Движения.ОстаткиТоваров, ВидДвиженияНакопления.Расход, Дата, ТаблицаТоваров);
	Движения.ОстаткиТоваров.Записать();
	Движения.ОстаткиТоваров.Записывать = Ложь;
	УчетТоваровСервер.ПроверитьОтрицательныеОстатки(ТаблицаТоваров, Отказ, ЭтотОбъект);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// 2. Себестоимость: списываем партии по FIFO.
	Списание = УчетТоваровСервер.СписатьПартииFIFO(Движения.ПартииТоваров, Дата, ТаблицаТоваров, Отказ, ЭтотОбъект);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	СебестоимостьСтрок = УчетТоваровСервер.СебестоимостьПоСтрокам(Списание);

	// 3. Продажи: выручка и себестоимость для отчётов о прибыли.
	Движения.Продажи.Записывать = Истина;
	Для Каждого СтрокаТовары Из Товары Цикл
		Себестоимость = СебестоимостьСтрок[СтрокаТовары.НомерСтроки];
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Склад = Склад;
		Движение.Товар = СтрокаТовары.Товар;
		Движение.Клиент = Клиент;
		Движение.СпособОплаты = СпособОплаты;
		Движение.Количество = СтрокаТовары.Количество;
		Движение.Выручка = СтрокаТовары.Сумма;
		Движение.Себестоимость = ?(Себестоимость = Неопределено, 0, Себестоимость);
	КонецЦикла;

	// 4. Уведомление ставится в очередь в той же транзакции (transactional outbox):
	// если проведение откатится, сообщение не уйдёт; отправка идёт уже после фиксации.
	Если Не ДополнительныеСвойства.БылПроведен
		И Не ОбщегоНазначенияСервер.ДополнительноеСвойство(ЭтотОбъект, "НеОтправлятьУведомления") Тогда
		ТелеграмСервер.ПоставитьВОчередьУведомлениеОПродаже(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
