#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(СкладОтправитель) Тогда
		СкладОтправитель = Константы.ОсновнойСклад.Получить();
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ЗначениеЗаполнено(СкладОтправитель) И СкладОтправитель = СкладПолучатель Тогда
		ОбщегоНазначенияСервер.СообщитьПользователю("Склад-отправитель и склад-получатель должны различаться",
			ЭтотОбъект, "СкладПолучатель", Отказ);
	КонецЕсли;

	Для Каждого СтрокаТовары Из Товары Цикл
		Если СтрокаТовары.Количество <= 0 Тогда
			ОбщегоНазначенияСервер.СообщитьПользователю(
				СтрШаблон("В строке %1 не указано количество", СтрокаТовары.НомерСтроки),
				ЭтотОбъект, СтрШаблон("Товары[%1].Количество", СтрокаТовары.НомерСтроки - 1), Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	УчетТоваровСервер.ОчиститьДвижения(Движения);

	Отправка = УчетТоваровСервер.ТаблицаТоваровДокумента(Товары, СкладОтправитель);
	Получение = УчетТоваровСервер.ТаблицаТоваровДокумента(Товары, СкладПолучатель);

	ВсеСклады = Отправка.Скопировать();
	Для Каждого Строка Из Получение Цикл
		ЗаполнитьЗначенияСвойств(ВсеСклады.Добавить(), Строка);
	КонецЦикла;
	УчетТоваровСервер.ЗаблокироватьТовары(ВсеСклады);

	УчетТоваровСервер.ДобавитьДвиженияОстатков(Движения.ОстаткиТоваров, ВидДвиженияНакопления.Расход, Дата, Отправка);
	УчетТоваровСервер.ДобавитьДвиженияОстатков(Движения.ОстаткиТоваров, ВидДвиженияНакопления.Приход, Дата, Получение);
	Движения.ОстаткиТоваров.Записать();
	Движения.ОстаткиТоваров.Записывать = Ложь;
	УчетТоваровСервер.ПроверитьОтрицательныеОстатки(Отправка, Отказ, ЭтотОбъект);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// Партии переезжают на другой склад вместе со своей себестоимостью:
	// при последующей продаже со склада-получателя FIFO продолжит работать корректно.
	Списание = УчетТоваровСервер.СписатьПартииFIFO(Движения.ПартииТоваров, Дата, Отправка, Отказ, ЭтотОбъект);
	Для Каждого Строка Из Списание Цикл
		Движение = Движения.ПартииТоваров.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Склад = СкладПолучатель;
		Движение.Товар = Строка.Товар;
		Движение.Партия = Строка.Партия;
		Движение.Количество = Строка.Количество;
		Движение.Стоимость = Строка.Стоимость;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	Получение = УчетТоваровСервер.ТаблицаТоваровДокумента(Товары, СкладПолучатель);
	УчетТоваровСервер.ЗаблокироватьТовары(Получение);
	УчетТоваровСервер.ОчиститьДвижения(Движения);
	УчетТоваровСервер.ПроверитьОтрицательныеОстатки(Получение, Отказ, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
